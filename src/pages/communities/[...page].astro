---
// src/pages/communities/[...page].astro
import '../../data/communities.xlsx?raw';
import type { Page } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CommunityCard from '../../components/CommunityCard.astro';
import WorkWithAlexCTA from '../../components/WorkWithAlexCTA.astro';
import * as XLSX from 'xlsx';
import path from 'node:path';
import fs from 'node:fs';

export async function getStaticPaths({ paginate }: any) {
  const filePath = path.resolve(process.cwd(), 'src', 'data', 'communities.xlsx');

  if (!fs.existsSync(filePath)) {
    return paginate([], { pageSize: 6 });
  }

  const fileBuffer = fs.readFileSync(filePath);
  const workbook = XLSX.read(fileBuffer, { type: 'buffer' });
  const sheet = workbook.Sheets[workbook.SheetNames[0]];
  const rawRows: any[] = XLSX.utils.sheet_to_json(sheet);

  const fallbackImage = 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1200&q=80';

  const allCommunities = rawRows
    .map((row) => {
      const name = String(row.name || row.Name || '').trim();
      if (!name) return null;

      const fallbackSlug = name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
      const slug = String(row.slug || row.Slug || fallbackSlug).trim();

      const imageEntries: { index: number; url: string }[] = [];
      Object.keys(row).forEach((key) => {
        const cleanKey = key.trim().toLowerCase();
        const match = cleanKey.match(/^image[-_\s]?(\d+)$/);
        if (match) {
          const index = parseInt(match[1], 10);
          const rawVal = row[key];
          if (rawVal !== undefined && rawVal !== null) {
            const val = String(rawVal).trim();
            if (val.length > 10 && (val.startsWith('http://') || val.startsWith('https://') || val.startsWith('/'))) {
              imageEntries.push({ index, url: val });
            }
          }
        }
      });

      imageEntries.sort((a, b) => a.index - b.index);
      const gallery = imageEntries.map((e) => e.url);

      if (gallery.length === 0) {
        const singleImage = String(row.image || row.Image || '').trim();
        gallery.push(singleImage.length > 0 ? singleImage : fallbackImage);
      }

      return {
        name,
        city: String(row.city || row.City || row.county || row.County || '').trim(),
        tagline: String(row.tagline || row.Tagline || '').trim(),
        description: String(row.description || row.Description || '').trim(),
        image: gallery[0],
        slug,
        featured: String(row.featured || row.Featured || 'NO').trim().toUpperCase()
      };
    })
    .filter((comm): comm is NonNullable<typeof comm> => comm !== null && comm.name.length > 0 && comm.slug.length > 0);

  return paginate(allCommunities, { pageSize: 6 });
}

interface Props {
  page: Page<any>;
}

const { page } = Astro.props;
---

<BaseLayout title="Communities Guides | Alex Yap Real Estate Advisor">
  <main class="w-full bg-[var(--color-luxury-stone,#ECE8E1)] overflow-x-hidden">

    <!-- Classic Left-Aligned Editorial Header with Sweet Spot Padding & Bottom Border -->
    <section class="w-full pt-44 pb-24 px-6 lg:px-12 bg-[var(--color-luxury-stone,#ECE8E1)] border-b border-black/15">
      <div class="max-w-5xl mx-auto flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <span class="font-body text-[11px] uppercase tracking-[3px] text-[#8C7149] font-medium block mb-2">
            Bay Area Neighborhoods &bull; Local Expertise
          </span>
          <h1 class="font-heading text-4xl sm:text-5xl font-normal uppercase tracking-[1.5px] text-[#1a1a1a]">
            Community Guides
          </h1>
        </div>
        <p class="font-body text-neutral-700 text-sm sm:text-base font-light max-w-md leading-relaxed">
          A quick look at the neighborhoods and premier residential communities across the South Bay.
        </p>
      </div>
    </section>

    <!-- CONTENT GRID SECTION -->
    <section class="w-full py-20 md:py-32">
      <div class="max-w-[96rem] mx-auto px-6 lg:px-12">
        <div id="communities-grid" class="scroll-mt-32"></div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
          {page.data.map((comm: any) => (
            <CommunityCard {...comm} />
          ))}
        </div>

        {page.lastPage > 1 && (
          <div class="mt-16 flex items-center justify-end">
            <nav aria-label="Communities pagination" class="flex items-center gap-2">
              {page.url.prev ? (
                <a 
                  href={`${page.url.prev}#communities-grid`} 
                  aria-label="Previous Page"
                  class="w-10 h-10 border border-black/15 bg-white text-[#1a1a1a] flex items-center justify-center hover:bg-[#1a1a1a] hover:text-white hover:border-[#1a1a1a] transition-all font-mono font-bold text-base cursor-pointer shadow-sm active:scale-95"
                >
                  &lt;
                </a>
              ) : (
                <span aria-disabled="true" class="w-10 h-10 border border-black/10 bg-white/50 text-neutral-300 flex items-center justify-center font-mono font-bold text-base cursor-not-allowed select-none">
                  &lt;
                </span>
              )}

              {page.url.next ? (
                <a 
                  href={`${page.url.next}#communities-grid`} 
                  aria-label="Next Page"
                  class="w-10 h-10 border border-black/15 bg-white text-[#1a1a1a] flex items-center justify-center hover:bg-[#1a1a1a] hover:text-white hover:border-[#1a1a1a] transition-all font-mono font-bold text-base cursor-pointer shadow-sm active:scale-95"
                >
                  &gt;
                </a>
              ) : (
                <span aria-disabled="true" class="w-10 h-10 border border-black/10 bg-white/50 text-neutral-300 flex items-center justify-center font-mono font-bold text-base cursor-not-allowed select-none">
                  &gt;
                </span>
              )}
            </nav>
          </div>
        )}
      </div>
    </section>
  </main>

  <WorkWithAlexCTA />
</BaseLayout>