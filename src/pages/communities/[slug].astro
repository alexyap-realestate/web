---
// ============================================================================
// COMPONENT: communities/[slug].astro
// USAGE: Individual community/neighborhood detail page. Reads community data
//        from communities.xlsx, translates descriptions, and renders a hero
//        photo stage with thumbnail filmstrip, narrative overview, and
//        pagination with duplicate-slug safety.
// ============================================================================

import '../../data/communities.xlsx?raw';

import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkWithAlexCTA from '../../components/WorkWithAlexCTA.astro';
import * as XLSX from 'xlsx';
import path from 'node:path';
import * as fs from 'node:fs';

export async function getStaticPaths() {
  const filePath = path.resolve(process.cwd(), 'src', 'data', 'communities.xlsx');
  const fileBuffer = fs.readFileSync(filePath);
  const workbook = XLSX.read(fileBuffer, { type: 'buffer' });
  const sheet = workbook.Sheets[workbook.SheetNames[0]];
  const rawRows: any[] = XLSX.utils.sheet_to_json(sheet);

  const fallbackHero = 'https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=2560&q=85';
  
  // ==========================================================================
  // 🛡️ DUPLICATE-SLUG PROTECTION (Keeps first slug clean, appends -2, -3 to duplicates)
  // ==========================================================================
  const seenSlugs = new Map<string, number>();

  const processedItems = rawRows.map((row) => {
    const name = String(row.name || row.Name || '').trim();
    const city = String(row.city || row.City || '').trim();
    const state = String(row.state || row.State || 'California').trim();
    const zip = String(row.zip || row.Zip || '').trim();

    const fallbackSlug = name
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/(^-|-$)/g, '');
      
    let baseSlug = String(row.slug || row.Slug || fallbackSlug).trim();
    if (!baseSlug) baseSlug = 'community';

    let finalSlug = baseSlug;
    if (seenSlugs.has(baseSlug)) {
      const count = seenSlugs.get(baseSlug)! + 1;
      seenSlugs.set(baseSlug, count);
      finalSlug = `${baseSlug}-${count}`;
    } else {
      seenSlugs.set(baseSlug, 1);
    }

    const slug = finalSlug;

    return { row, name, city, state, zip, slug };
  }).filter(item => item.name.length > 0 && item.slug.length > 0);

  const total = processedItems.length;

  return processedItems.map((item, idx) => {
    const { row, name, city, state, zip, slug } = item;

    const prevIdx = (idx - 1 + total) % total;
    const nextIdx = (idx + 1) % total;

    const prevCommunity = total > 1 ? {
      slug: processedItems[prevIdx].slug,
      name: processedItems[prevIdx].name,
      city: processedItems[prevIdx].city,
    } : null;

    const nextCommunity = total > 1 ? {
      slug: processedItems[nextIdx].slug,
      name: processedItems[nextIdx].name,
      city: processedItems[nextIdx].city,
    } : null;

    const imageEntries: { index: number; url: string }[] = [];

    Object.keys(row).forEach((key) => {
      const cleanKey = key.trim().toLowerCase();
      const match = cleanKey.match(/^image[-_\s]?(\d+)$/);
      if (match) {
        const index = parseInt(match[1], 10);
        const rawVal = row[key];
        if (rawVal !== undefined && rawVal !== null) {
          const val = String(rawVal).trim();
          if (
            val.length > 10 &&
            (val.startsWith('http://') || val.startsWith('https://') || val.startsWith('/'))
          ) {
            imageEntries.push({ index, url: val });
          }
        }
      }
    });

    imageEntries.sort((a, b) => a.index - b.index);
    const gallery = imageEntries.map((e) => e.url);

    if (gallery.length === 0) {
      const singleImage = String(row.image || row.Image || '').trim();
      gallery.push(singleImage.length > 0 ? singleImage : fallbackHero);
    }

    const heroImage = gallery[0];
    const tagline = String(row.tagline || row.Tagline || '').trim();

    return {
      params: { slug },
      props: {
        community: {
          name,
          city,
          state,
          zip,
          tagline,
          description: String(row.description || row.Description || '').trim(),
          heroImage,
          gallery
        },
        prevCommunity,
        nextCommunity
      }
    };
  });
}

interface Props {
  community: {
    name: string;
    city: string;
    state: string;
    zip: string;
    tagline: string;
    description: string;
    heroImage: string;
    gallery: string[];
  };
  prevCommunity: { slug: string; name: string; city: string } | null;
  nextCommunity: { slug: string; name: string; city: string } | null;
}

let props = Astro.props;

if (import.meta.env.DEV) {
  const currentSlug = Astro.params.slug;
  const filePath = path.resolve(process.cwd(), 'src', 'data', 'communities.xlsx');
  try {
    const fileBuffer = fs.readFileSync(filePath);
    const workbook = XLSX.read(fileBuffer, { type: 'buffer' });
    const sheet = workbook.Sheets[workbook.SheetNames[0]];
    const rawRows: any[] = XLSX.utils.sheet_to_json(sheet);
   
    const devSeenSlugs = new Map<string, number>();
    const processedDevRows = rawRows.map((row) => {
      const nameVal = String(row.name || row.Name || '').trim();
      const fallbackSlug = nameVal.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
      let baseSlug = String(row.slug || row.Slug || fallbackSlug).trim();
      if (!baseSlug) baseSlug = 'community';

      let finalSlug = baseSlug;
      if (devSeenSlugs.has(baseSlug)) {
        const count = devSeenSlugs.get(baseSlug)! + 1;
        devSeenSlugs.set(baseSlug, count);
        finalSlug = `${baseSlug}-${count}`;
      } else {
        devSeenSlugs.set(baseSlug, 1);
      }
      return { row, slugVal: finalSlug };
    });

    const matchedItem = processedDevRows.find(item => item.slugVal === currentSlug);

    if (matchedItem) {
      const matchedRow = matchedItem.row;
      const name = String(matchedRow.name || matchedRow.Name || '').trim();
      const city = String(matchedRow.city || matchedRow.City || '').trim();
      const state = String(matchedRow.state || matchedRow.State || 'California').trim();
      const zip = String(matchedRow.zip || matchedRow.Zip || '').trim();
      const fallbackHero = 'https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&w=2560&q=85';

      const imageEntries: { index: number; url: string }[] = [];
      Object.keys(matchedRow).forEach((key) => {
        const cleanKey = key.trim().toLowerCase();
        const match = cleanKey.match(/^image[-_\s]?(\d+)$/);
        if (match) {
          const index = parseInt(match[1], 10);
          const rawVal = matchedRow[key];
          if (rawVal !== undefined && rawVal !== null) {
            const val = String(rawVal).trim();
            if (val.length > 10 && (val.startsWith('http://') || val.startsWith('https://') || val.startsWith('/'))) {
              imageEntries.push({ index, url: val });
            }
          }
        }
      });
      imageEntries.sort((a, b) => a.index - b.index);
      const gallery = imageEntries.map((e) => e.url);
      if (gallery.length === 0) {
        const singleImage = String(matchedRow.image || matchedRow.Image || '').trim();
        gallery.push(singleImage.length > 0 ? singleImage : fallbackHero);
      }

      props.community.name = name;
      props.community.city = city;
      props.community.state = state;
      props.community.zip = zip;
      props.community.tagline = String(matchedRow.tagline || matchedRow.Tagline || '').trim();
      props.community.description = String(matchedRow.description || matchedRow.Description || '').trim();
      props.community.heroImage = gallery[0];
      props.community.gallery = gallery;
    }
  } catch (e) {
    // Fall back to props passed from getStaticPaths if file read fails in dev
  }
}

const { community, prevCommunity, nextCommunity } = props;

// ============================================================================
// 🎯 EXCEL TEXT TRANSLATOR (formatDescriptionContent)
// ============================================================================
const formatDescriptionContent = (str: string) => {
  if (!str) return '';

  let text = str
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/&amp;/g, '&');

  if (/<\/?[a-z][\s\S]*>/i.test(text)) {
    return text;
  }

  text = text.replace(
    /^###[ \t]+(.*$)/gim,
    '<h3 class="text-xl font-heading font-normal uppercase tracking-[1px] text-[#1a1a1a] mt-10 mb-4 leading-snug">$1</h3>'
  );

  text = text.replace(
    /^##[ \t]+(.*$)/gim,
    '<h2 class="text-2xl sm:text-3xl font-heading font-normal uppercase tracking-[1.5px] text-[#1a1a1a] mt-12 mb-6 leading-tight border-b border-black/10 pb-3">$1</h2>'
  );

  text = text.replace(
    /\*\*(.*?)\*\*/gim,
    '<strong class="font-medium text-[#1a1a1a]">$1</strong>'
  );

  text = text.replace(
    /\*(.*?)\*/gim,
    '<em class="italic text-neutral-800">$1</em>'
  );

  text = text.replace(
    /\[([^\]]+)\]\((https?:\/\/[^\s\)]+)\)/gim,
    '<a href="$2" target="_blank" rel="noopener noreferrer" class="font-medium underline underline-offset-4 decoration-[#8C7149] text-[#8C7149] hover:text-[#1a1a1a] transition-colors inline-flex items-center gap-1">$1</a>'
  );

  text = text.replace(
    /^>[ \t]+(.*$)/gim,
    '<blockquote class="border-l-[3px] border-[#8C7149] bg-[#FAF8F5] pl-6 sm:pl-8 py-5 my-8 italic text-neutral-800 font-body text-base sm:text-lg leading-relaxed shadow-sm">$1</blockquote>'
  );

  text = text.replace(
    /^---$/gim,
    '<hr class="my-10 border-t border-black/10" />'
  );

  const blocks = text.split(/\r?\n\s*\r?\n/);

  const formattedBlocks = blocks
    .map((b) => b.trim())
    .filter((b) => b.length > 0)
    .map((b) => {
      if (
        b.startsWith('<h2') ||
        b.startsWith('<h3') ||
        b.startsWith('<blockquote') ||
        b.startsWith('<hr')
      ) {
        return b;
      }

      if (b.split('\n').every((line) => line.trim().startsWith('- '))) {
        const items = b
          .split('\n')
          .map((line) => `<li class="ml-4 pl-1">${line.trim().replace(/^-\s*/, '')}</li>`)
          .join('');
        return `<ul class="list-disc list-outside mb-6 space-y-2 text-neutral-700 leading-relaxed font-light font-body">${items}</ul>`;
      }

      return `<p class="mb-6 leading-[1.85] text-neutral-700 font-body font-light text-base sm:text-lg">${b.replace(/\r?\n/g, '<br />')}</p>`;
    });

  return formattedBlocks.join('');
};

const renderedDescription = formatDescriptionContent(community.description);
const totalPhotos = community.gallery.length;
---

<BaseLayout title={`${community.name} Neighborhood Guide | Alex Yap Real Estate`}>
  <main class="w-full bg-[var(--color-luxury-stone,#ECE8E1)] overflow-x-hidden pt-28 md:pt-36">
    
    <!-- =================================================================== -->
    <!-- COMMUNITY GALLERY STAGE & THUMBNAIL FILMSTRIP                        -->
    <!-- =================================================================== -->
    <section class="w-full pb-12 md:pb-20">
      <div class="max-w-[96rem] mx-auto px-6 lg:px-12">
        
        <!-- Back Navigation & Top Header Bar -->
        <div class="flex items-center justify-between mb-8">
          <a
            href="/communities"
            class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[2px] text-neutral-500 hover:text-[#8C7149] transition-colors group"
          >
            <span class="font-bold text-sm leading-none transition-transform group-hover:-translate-x-1">&lt;</span>
            <span>All Communities</span>
          </a>

          <div class="flex items-center gap-6">
            {prevCommunity ? (
              <a
                href={`/communities/${prevCommunity.slug}`}
                class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[2px] text-neutral-500 hover:text-[#8C7149] transition-colors group"
                title={prevCommunity.name}
              >
                <span class="font-bold text-sm leading-none transition-transform group-hover:-translate-x-1">&lt;</span>
                <span>Prev</span>
              </a>
            ) : null}
            {nextCommunity ? (
              <a
                href={`/communities/${nextCommunity.slug}`}
                class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[2px] text-neutral-500 hover:text-[#8C7149] transition-colors group"
                title={nextCommunity.name}
              >
                <span>Next</span>
                <span class="font-bold text-sm leading-none transition-transform group-hover:translate-x-1">&gt;</span>
              </a>
            ) : null}
          </div>
        </div>

        <!-- Community Name & Tagline Header -->
        <header class="mb-8">
          <div class="inline-flex items-center gap-2.5 mb-3 bg-white border border-black/10 px-3.5 py-1.5 shadow-sm">
            <span class="w-1.5 h-1.5 rounded-full bg-[#8C7149]"></span>
            <span class="font-body text-[10px] sm:text-[11px] uppercase tracking-[3px] text-[#8C7149] font-medium leading-none">
              Community Guide
            </span>
          </div>

          <h1 class="font-heading text-xl sm:text-2xl md:text-3xl font-normal uppercase tracking-[1px] text-[#1a1a1a] mb-2">
            {community.name}
          </h1>

          <p class="font-body text-neutral-600 text-xs sm:text-sm font-light tracking-[1px]">
            {community.city}, {community.state} {community.zip} {community.tagline ? `• ${community.tagline}` : ''}
          </p>
        </header>

        <!-- ================================================================= -->
        <!-- PHOTO STAGE & THUMBNAIL FILMSTRIP CONTAINER                       -->
        <!-- ================================================================= -->
        <!-- NOTE: Changed padding from p-4 sm:p-6 md:p-8 to p-0. -->
        <!-- WHY: This removes all outer blank margin/padding around the gallery card container, -->
        <!-- allowing the photo stage and filmstrip to stretch edge-to-edge. -->
        <div class="bg-white border border-black/10 p-0 shadow-[0_10px_30px_rgba(0,0,0,0.03)] mb-12 overflow-hidden">
          
          <!-- Main Large Stage Photo -->
          <!-- NOTE: Changed margin-bottom from mb-4 to mb-0 and added a bottom border (border-b). -->
          <!-- WHY: This removes the vertical white gap between the photo stage and the filmstrip below it, -->
          <!-- making them sit together seamlessly. -->
          <div class="relative w-full aspect-[4/3] max-h-[640px] overflow-hidden bg-[var(--color-luxury-stone,#ECE8E1)] mx-auto mb-0 border-b border-black/10 group flex items-center justify-center">
            <img
              id="main-stage-img"
              src={community.gallery[0]}
              alt={community.name}
              class="max-w-full max-h-full w-auto h-auto object-contain transition-opacity duration-300"
            />

            {totalPhotos > 1 && (
              <div class="absolute top-4 right-4 z-20 bg-black/70 backdrop-blur-md text-white px-3.5 py-1 font-mono text-xs tracking-[2px] border border-white/20 shadow-md select-none pointer-events-none">
                <span id="current-photo-num">01</span> / {String(totalPhotos).padStart(2, '0')}
              </div>
            )}

            {community.gallery.length > 1 && (
              <>
                <button
                  type="button"
                  id="stage-prev-btn"
                  class="absolute left-4 top-1/2 -translate-y-1/2 z-10 w-11 h-11 rounded-full border border-white/20 bg-black/40 backdrop-blur-md flex items-center justify-center text-white hover:bg-[#8C7149] hover:border-[#8C7149] transition-all duration-300 shadow-lg cursor-pointer opacity-80 group-hover:opacity-100"
                  aria-label="Previous photo"
                >
                  <span class="font-mono font-bold text-lg">&lt;</span>
                </button>

                <button
                  type="button"
                  id="stage-next-btn"
                  class="absolute right-4 top-1/2 -translate-y-1/2 z-10 w-11 h-11 rounded-full border border-white/20 bg-black/40 backdrop-blur-md flex items-center justify-center text-white hover:bg-[#8C7149] hover:border-[#8C7149] transition-all duration-300 shadow-lg cursor-pointer opacity-80 group-hover:opacity-100"
                  aria-label="Next photo"
                >
                  <span class="font-mono font-bold text-lg">&gt;</span>
                </button>
              </>
            )}
          </div>

          <!-- Thumbnail Filmstrip Below -->
          <!-- NOTE: Wrapped the filmroll inside a clean white padded strip (p-3 bg-white). -->
          <!-- WHY: This gives the thumbnail buttons a tidy container directly beneath the photo stage. -->
          {community.gallery.length > 1 && (
            <div class="relative w-full p-3 bg-white">
              <div
                id="film-roll"
                class="flex items-center gap-3 overflow-x-auto pb-2 pt-1 px-1 scrollbar-custom cursor-grab active:cursor-grabbing"
                tabindex="0"
                aria-label="Thumbnail strip"
              >
                {community.gallery.map((imgUrl, index) => (
                  <button
                    type="button"
                    class={`thumb-btn relative w-24 sm:w-32 aspect-[4/3] overflow-hidden border-2 transition-all cursor-pointer bg-[var(--color-luxury-stone,#ECE8E1)] shrink-0 ${index === 0 ? 'border-[#8C7149] opacity-100 scale-100' : 'border-transparent opacity-60 hover:opacity-100'}`}
                    data-image-url={imgUrl}
                    data-thumb-index={index}
                    aria-label={`Show photo ${index + 1}`}
                  >
                    <img src={imgUrl} alt={`${community.name} thumbnail ${index + 1}`} class="w-full h-full object-cover pointer-events-none" />
                    <span class="absolute bottom-1 right-1 font-mono text-[9px] bg-black/75 text-white px-1.5 py-0.2 backdrop-blur-sm pointer-events-none">
                      {index + 1}
                    </span>
                  </button>
                ))}
              </div>
            </div>
          )}

        </div>

        <!-- ================================================================= -->
        <!-- COMMUNITY NARRATIVE OVERVIEW                                       -->
        <!-- ================================================================= -->
        <div class="bg-white border border-black/10 p-8 sm:p-12 md:p-16 shadow-[0_10px_30px_rgba(0,0,0,0.03)] mb-16">
          <h2 class="font-heading text-2xl sm:text-3xl uppercase tracking-[1px] text-[#1a1a1a] mb-6">
            About {community.name}
          </h2>
         
          {renderedDescription ? (
            <div class="property-content prose prose-neutral max-w-none text-[#2b2b2b]">
              <div set:html={renderedDescription} />
            </div>
          ) : (
            <div class="font-body text-neutral-700 text-base md:text-lg font-light leading-relaxed">
              Explore luxury real estate, lifestyle amenities, and neighborhood insights for {community.name}.
            </div>
          )}
        </div>

        <!-- Bottom Footer Navigation Bar -->
        <div class="flex items-center justify-between pt-4">
          {prevCommunity ? (
            <a
              href={`/communities/${prevCommunity.slug}`}
              class="inline-flex items-center gap-2.5 px-6 py-3.5 bg-white text-[#1a1a1a] border border-black/15 hover:bg-[#1a1a1a] hover:text-white transition-all font-mono text-xs uppercase tracking-[2px] shadow-sm group"
              title={prevCommunity.name}
            >
              <span class="font-bold text-sm leading-none transition-transform group-hover:-translate-x-1">&lt;</span>
              <span>Prev</span>
            </a>
          ) : <div />}

          {nextCommunity ? (
            <a
              href={`/communities/${nextCommunity.slug}`}
              class="inline-flex items-center gap-2.5 px-6 py-3.5 bg-white text-[#1a1a1a] border border-black/15 hover:bg-[#1a1a1a] hover:text-white transition-all font-mono text-xs uppercase tracking-[2px] shadow-sm group ml-auto"
              title={nextCommunity.name}
            >
              <span>Next</span>
              <span class="font-bold text-sm leading-none transition-transform group-hover:translate-x-1">&gt;</span>
            </a>
          ) : <div />}
        </div>

      </div>
    </section>

  </main>

  <WorkWithAlexCTA />
</BaseLayout>

<style>
  .scrollbar-custom {
    overflow-x: auto;
    scrollbar-width: thin;
    scrollbar-color: #8C7149 #e5e5e5;
  }
  .scrollbar-custom::-webkit-scrollbar {
    height: 8px;
  }
  .scrollbar-custom::-webkit-scrollbar-track {
    background: #f1f0ec;
    border-radius: 4px;
  }
  .scrollbar-custom::-webkit-scrollbar-thumb {
    background-color: #8C7149;
    border-radius: 4px;
    border: 2px solid #f1f0ec;
  }
  .scrollbar-custom::-webkit-scrollbar-thumb:hover {
    background-color: #1a1a1a;
  }
</style>

<script>
  function setupCommunityGallery() {
    const mainImg = document.getElementById('main-stage-img') as HTMLImageElement;
    const thumbButtons = document.querySelectorAll('.thumb-btn');
    const prevBtn = document.getElementById('stage-prev-btn');
    const nextBtn = document.getElementById('stage-next-btn');
    const counterNum = document.getElementById('current-photo-num');
    const filmRoll = document.getElementById('film-roll');

    if (!mainImg || thumbButtons.length === 0) return;

    let currentIndex = 0;
    const totalImages = thumbButtons.length;

    function updateActiveImage(index: number) {
      currentIndex = (index + totalImages) % totalImages;
      const targetBtn = thumbButtons[currentIndex] as HTMLElement;
      const newUrl = targetBtn.getAttribute('data-image-url');

      if (!newUrl) return;

      mainImg.style.opacity = '0';
      setTimeout(() => {
        mainImg.src = newUrl;
        mainImg.style.opacity = '1';
      }, 150);

      if (counterNum) {
        counterNum.textContent = String(currentIndex + 1).padStart(2, '0');
      }

      thumbButtons.forEach((t) => {
        t.classList.remove('border-[#8C7149]', 'opacity-100');
        t.classList.add('border-transparent', 'opacity-60');
      });
      targetBtn.classList.remove('border-transparent', 'opacity-60');
      targetBtn.classList.add('border-[#8C7149]', 'opacity-100');
      targetBtn.scrollIntoView({ behavior: 'smooth', inline: 'nearest', block: 'nearest' });
    }

    thumbButtons.forEach((btn, index) => {
      btn.addEventListener('click', () => {
        updateActiveImage(index);
      });
    });

    prevBtn?.addEventListener('click', () => {
      updateActiveImage(currentIndex - 1);
    });

    nextBtn?.addEventListener('click', () => {
      updateActiveImage(currentIndex + 1);
    });

    if (filmRoll) {
      let isDown = false;
      let startX = 0;
      let scrollLeft = 0;

      filmRoll.addEventListener('mousedown', (e) => {
        isDown = true;
        startX = e.pageX - filmRoll.offsetLeft;
        scrollLeft = filmRoll.scrollLeft;
      });

      window.addEventListener('mouseup', () => {
        isDown = false;
      });

      filmRoll.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - filmRoll.offsetLeft;
        const walk = (x - startX) * 1.5;
        filmRoll.scrollLeft = scrollLeft - walk;
      });
    }
  }

  document.addEventListener('astro:page-load', setupCommunityGallery);
</script>

<style is:global>
  .property-content a {
    color: #8C7149 !important;
    text-decoration: underline dotted #8C7149 !important;
    text-underline-offset: 6px !important;
    font-weight: 500 !important;
    transition: all 0.2s ease-in-out;
  }

  .property-content a:hover {
    color: #1a1a1a !important;
    text-decoration-color: #1a1a1a !important;
  }
</style>