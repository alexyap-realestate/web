  .testimonial-slide.is-prev {
    opacity: 0.45;
    transform: translateX(-40%) scale(0.92);
    z-index: 10;
    pointer-events: auto;
    cursor: pointer;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
  }

  .testimonial-slide.is-next {
    opacity: 0.45;
    transform: translateX(40%) scale(0.92);
    z-index: 10;
    pointer-events: auto;
    cursor: pointer;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
  }

  .testimonial-slide.is-hidden {
    opacity: 0;
    transform: translateX(0) scale(0.75);
    z-index: 0;
    pointer-events: none;
  }

  @media (max-width: 767px) {
    .testimonial-slide.is-prev,
    .testimonial-slide.is-next {
      opacity: 0;
      transform: translateX(0) scale(0.95);
      pointer-events: none;
    }
  }

  .carousel-dot.active {
    width: 2rem;
    background-color: #8C7149;
  }
  .carousel-dot:not(.active) {
    width: 0.5rem;
  }
</style>

<script>
  function setupTestimonialCarousel() {
    const testStage = document.getElementById('testimonial-stage');
    if (testStage && testStage.dataset.initialized !== 'true') {
      testStage.dataset.initialized = 'true';

      const slides = Array.from(document.querySelectorAll<HTMLElement>('.testimonial-slide'));
      const testPrevBtn = document.getElementById('testimonial-prev');
      const testNextBtn = document.getElementById('testimonial-next');
      const dots = Array.from(document.querySelectorAll<HTMLElement>('.carousel-dot'));

      if (slides.length > 0) {
        let currentTestIndex = 0;
        const total = slides.length;

        function checkOverflowStates() {
          slides.forEach((slide) => {
            const scrollContainer = slide.querySelector('.card-body-scroll');
            const wrapper = slide.querySelector('.card-body-wrapper');
            if (scrollContainer && wrapper) {
              scrollContainer.classList.add('has-overflow');
              wrapper.classList.add('has-overflow');
              
              const hasOverflow = scrollContainer.scrollHeight > scrollContainer.clientHeight;
              
              if (!hasOverflow) {
                scrollContainer.classList.remove('has-overflow');
                wrapper.classList.remove('has-overflow');
              }
            }
          });
        }

        function updateTestimonialCarousel() {
          const isMobile = window.innerWidth < 768;

          slides.forEach((slide, i) => {
            slide.classList.remove('is-active', 'is-prev', 'is-next', 'is-hidden');
            
            const prevIndex = (currentTestIndex - 1 + total) % total;
            const nextIndex = (currentTestIndex + 1) % total;

            if (i === currentTestIndex) {
              slide.classList.add('is-active');
            } else if (!isMobile && i === prevIndex) {
              slide.classList.add('is-prev');
            } else if (!isMobile && i === nextIndex) {
              slide.classList.add('is-next');
            } else {
              slide.classList.add('is-hidden');
            }
          });

          dots.forEach((dot, idx) => {
            dot.classList.toggle('active', idx === currentTestIndex);
          });
          checkOverflowStates();
        }

        function goTestNext() {
          currentTestIndex = (currentTestIndex + 1) % total;
          updateTestimonialCarousel();
        }

        function goTestPrev() {
          currentTestIndex = (currentTestIndex - 1 + total) % total;
          updateTestimonialCarousel();
        }

        testPrevBtn?.addEventListener('click', goTestPrev);
        testNextBtn?.addEventListener('click', goTestNext);

        slides.forEach((slide) => {
          slide.addEventListener('click', () => {
            if (slide.classList.contains('is-prev')) goTestPrev();
            if (slide.classList.contains('is-next')) goTestNext();
          });
        });

        dots.forEach((dot, index) => {
          dot.addEventListener('click', () => {
            currentTestIndex = index;
            updateTestimonialCarousel();
          });
        });

        let testStartX = 0;
        testStage.addEventListener('touchstart', (e) => {
          testStartX = e.touches[0].clientX;
        }, { passive: true });

        testStage.addEventListener('touchend', (e) => {
          const endX = e.changedTouches[0].clientX;
          const diff = testStartX - endX;
          if (Math.abs(diff) > 40) {
            if (diff > 0) goTestNext();
            else goTestPrev();
          }
        });

        window.addEventListener('resize', () => {
          checkOverflowStates();
          updateTestimonialCarousel();
        });

        checkOverflowStates();
        updateTestimonialCarousel();
      }
    }
  }

  document.addEventListener('astro:page-load', setupTestimonialCarousel);
</script>