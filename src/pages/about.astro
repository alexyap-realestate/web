---
// src/pages/about.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkWithAlexCTA from '../components/WorkWithAlexCTA.astro';
import TestimonialsCarousel from '../components/TestimonialsCarousel.astro';
import * as XLSX from 'xlsx';
import path from 'node:path';
import fs from 'node:fs';

const testimonialFilePath = path.resolve(process.cwd(), 'src', 'data', 'testimonials.xlsx');
let allReviews: any[] = [];
if (fs.existsSync(testimonialFilePath)) {
  const testFileBuffer = fs.readFileSync(testimonialFilePath);
  const testWorkbook = XLSX.read(testFileBuffer, { type: 'buffer' });
  const testSheetName = testWorkbook.SheetNames[0];
  allReviews = XLSX.utils.sheet_to_json(testWorkbook.Sheets[testSheetName]);
}

const testimonials = allReviews.filter((item) => {
  const val = String(item.featured || '').trim().toUpperCase();
  return val === 'YES' || val === 'TRUE';
});
---

<BaseLayout title="About Alex Yap | Real Estate Advisor & South Bay Specialist">
  <main class="w-full bg-[var(--color-luxury-stone,#ECE8E1)] overflow-x-hidden">

    <!-- Classic Left-Aligned Editorial Header with Sweet Spot Padding & Bottom Border -->
    <section class="w-full pt-44 pb-24 px-6 lg:px-12 bg-[var(--color-luxury-stone,#ECE8E1)] border-b border-black/15">
      <div class="max-w-5xl mx-auto flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <span class="font-body text-[11px] uppercase tracking-[3px] text-[#8C7149] font-medium block mb-2">
            Advisory Background &bull; 20+ Years Excellence
          </span>
          <h1 class="font-heading text-4xl sm:text-5xl font-normal uppercase tracking-[1.5px] text-[#1a1a1a]">
            About Alex Yap
          </h1>
        </div>
        <p class="font-body text-neutral-700 text-sm sm:text-base font-light max-w-md leading-relaxed">
          Dedicated real estate advisor providing high-conviction representation, rigorous market insight, and uncompromising client advocacy across the South Bay.
        </p>
      </div>
    </section>

    <!-- ADVISOR PROFILE SECTION (Same Stone BG so it flows together) -->
    <section id="advisor-profile" class="w-full py-20 md:py-32 bg-[var(--color-luxury-stone,#ECE8E1)]">
      <div class="max-w-[96rem] mx-auto px-6 lg:px-12">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          
          <div class="lg:col-span-5 relative">
            <div class="relative z-10 border border-black/15 shadow-2xl overflow-hidden">
              <img 
                src="https://media-production.lp-cdn.com/media/fb4bc84d-22b6-4434-9a72-758ee9c9dca6" 
                alt="Alex Yap" 
                class="w-full h-auto object-cover grayscale hover:grayscale-0 transition-all duration-700"
              />
            </div>
            <div class="absolute -bottom-6 -right-6 w-full h-full border-2 border-[#8C7149]/30 pointer-events-none hidden sm:block"></div>
          </div>

          <div class="lg:col-span-7 space-y-6">
            <span class="font-body text-[11px] uppercase tracking-[3px] text-[#8C7149] font-medium block">
              Trusted South Bay Advisor
            </span>
            <h2 class="font-heading text-2xl sm:text-4xl uppercase tracking-[1px] text-[#1a1a1a] leading-tight">
              A Personal Commitment to Your Real Estate Goals
            </h2>
            <p class="font-body text-neutral-700 text-sm sm:text-base font-light leading-relaxed">
              For over two decades, Alex Yap has guided homeowners, buyers, and investors through the complexities of the Silicon Valley and South Bay real estate markets. Known for analytical rigor, strategic positioning, and transparent communication, Alex ensures that every transaction is executed with precision.
            </p>
            <p class="font-body text-neutral-700 text-sm sm:text-base font-light leading-relaxed">
              Alex provides an elite, hands-on experience, guiding you directly from the initial consultation to a successful closing. By managing every detail personally, Alex ensures your equity is protected, market competition is maximized, and you experience complete peace of mind at every phase.
            </p>
          </div>

        </div>
      </div>
    </section>

    <!-- CORE PRINCIPLES SECTION (Alternating Chalk BG) -->
    <section class="w-full py-20 md:py-28 bg-[var(--color-luxury-chalk,#F4F2EE)] border-t border-black/10">
      <div class="max-w-[96rem] mx-auto px-6 lg:px-12">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="font-body text-[11px] uppercase tracking-[3px] text-[#8C7149] font-medium block mb-2">Core Principles</span>
          <h2 class="font-heading text-2xl sm:text-4xl uppercase tracking-[1px] text-[#1a1a1a] leading-tight mb-4">The Standard of Service</h2>
          <p class="font-body text-neutral-700 text-sm sm:text-base font-light leading-relaxed">
            Every transaction is governed by strict fiduciary guidelines designed to protect client equity and eliminate conflicts of interest.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <article class="group relative bg-white border border-black/10 p-8 sm:p-10 flex flex-col justify-between shadow-[0_10px_30px_rgba(0,0,0,0.04)] hover:shadow-[0_30px_60px_-15px_rgba(140,113,73,0.18)] hover:border-[#8C7149]/50 hover:-translate-y-1.5 transition-all duration-500 overflow-hidden">
            <div class="absolute top-0 inset-x-0 h-[2px] bg-gradient-to-r from-transparent via-[#8C7149] to-transparent w-0 group-hover:w-full transition-all duration-700 ease-out"></div>
            <div class="absolute inset-3 border border-black/[0.04] group-hover:border-[#8C7149]/25 transition-colors duration-500 pointer-events-none"></div>

            <div class="relative z-10">
              <div class="flex items-center justify-between mb-6 pb-4 border-b border-black/[0.08] group-hover:border-[#8C7149]/20 transition-colors">
                <span class="font-mono text-[10px] uppercase tracking-[2px] text-[#8C7149] font-medium">Pillar 01</span>
                <span class="w-1.5 h-1.5 rounded-full bg-[#8C7149] group-hover:scale-125 transition-transform duration-300"></span>
              </div>
              <h3 class="font-heading text-lg uppercase tracking-wider text-[#1a1a1a] mb-2 group-hover:text-[#8C7149] transition-colors duration-300">Fiduciary Standard</h3>
              <h4 class="font-heading text-xs uppercase tracking-wider text-[#8C7149] mb-4">Uncompromising Fiduciary Duty</h4>
              <p class="font-body text-neutral-600 text-sm font-light leading-[1.8]">
                Real estate without conflicts of interest. Every valuation, counter-offer, and negotiation strategy is engineered strictly to protect your bottom line—not to chase a quick commission.
              </p>
            </div>

            <div class="relative z-10 mt-8 pt-4 border-t border-black/[0.08] flex items-center justify-between text-xs tracking-[2px] uppercase text-neutral-400 font-mono">
              <span class="text-[10px] text-neutral-500 group-hover:text-[#1a1a1a] transition-colors">Core Principle</span>
              <span class="w-6 h-[1px] bg-black/15 group-hover:w-12 group-hover:bg-[#8C7149] transition-all duration-500"></span>
            </div>
          </article>

          <article class="group relative bg-white border border-black/10 p-8 sm:p-10 flex flex-col justify-between shadow-[0_10px_30px_rgba(0,0,0,0.04)] hover:shadow-[0_30px_60px_-15px_rgba(140,113,73,0.18)] hover:border-[#8C7149]/50 hover:-translate-y-1.5 transition-all duration-500 overflow-hidden">
            <div class="absolute top-0 inset-x-0 h-[2px] bg-gradient-to-r from-transparent via-[#8C7149] to-transparent w-0 group-hover:w-full transition-all duration-700 ease-out"></div>
            <div class="absolute inset-3 border border-black/[0.04] group-hover:border-[#8C7149]/25 transition-colors duration-500 pointer-events-none"></div>

            <div class="relative z-10">
              <div class="flex items-center justify-between mb-6 pb-4 border-b border-black/[0.08] group-hover:border-[#8C7149]/20 transition-colors">
                <span class="font-mono text-[10px] uppercase tracking-[2px] text-[#8C7149] font-medium">Pillar 02</span>
                <span class="w-1.5 h-1.5 rounded-full bg-[#8C7149] group-hover:scale-125 transition-transform duration-300"></span>
              </div>
              <h3 class="font-heading text-lg uppercase tracking-wider text-[#1a1a1a] mb-2 group-hover:text-[#8C7149] transition-colors duration-300">Advisory Mindset</h3>
              <h4 class="font-heading text-xs uppercase tracking-wider text-[#8C7149] mb-4">Zero-Pressure Guidance</h4>
              <p class="font-body text-neutral-600 text-sm font-light leading-[1.8]">
                Real estate is one of life's largest financial commitments. You get objective, measured advice designed to protect your net worth—never rushed or aggressive tactics.
              </p>
            </div>

            <div class="relative z-10 mt-8 pt-4 border-t border-black/[0.08] flex items-center justify-between text-xs tracking-[2px] uppercase text-neutral-400 font-mono">
              <span class="text-[10px] text-neutral-500 group-hover:text-[#1a1a1a] transition-colors">Core Principle</span>
              <span class="w-6 h-[1px] bg-black/15 group-hover:w-12 group-hover:bg-[#8C7149] transition-all duration-500"></span>
            </div>
          </article>

          <article class="group relative bg-white border border-black/10 p-8 sm:p-10 flex flex-col justify-between shadow-[0_10px_30px_rgba(0,0,0,0.04)] hover:shadow-[0_30px_60px_-15px_rgba(140,113,73,0.18)] hover:border-[#8C7149]/50 hover:-translate-y-1.5 transition-all duration-500 overflow-hidden">
            <div class="absolute top-0 inset-x-0 h-[2px] bg-gradient-to-r from-transparent via-[#8C7149] to-transparent w-0 group-hover:w-full transition-all duration-700 ease-out"></div>
            <div class="absolute inset-3 border border-black/[0.04] group-hover:border-[#8C7149]/25 transition-colors duration-500 pointer-events-none"></div>

            <div class="relative z-10">
              <div class="flex items-center justify-between mb-6 pb-4 border-b border-black/[0.08] group-hover:border-[#8C7149]/20 transition-colors">
                <span class="font-mono text-[10px] uppercase tracking-[2px] text-[#8C7149] font-medium">Pillar 03</span>
                <span class="w-1.5 h-1.5 rounded-full bg-[#8C7149] group-hover:scale-125 transition-transform duration-300"></span>
              </div>
              <h3 class="font-heading text-lg uppercase tracking-wider text-[#1a1a1a] mb-2 group-hover:text-[#8C7149] transition-colors duration-300">Direct Oversight</h3>
              <h4 class="font-heading text-xs uppercase tracking-wider text-[#8C7149] mb-4">End-to-End Execution</h4>
              <p class="font-body text-neutral-600 text-sm font-light leading-[1.8]">
                From contractor coordination and tailored staging updates to contract defense at closing, Alex manages every single operational detail personally.
              </p>
            </div>

            <div class="relative z-10 mt-8 pt-4 border-t border-black/[0.08] flex items-center justify-between text-xs tracking-[2px] uppercase text-neutral-400 font-mono">
              <span class="text-[10px] text-neutral-500 group-hover:text-[#1a1a1a] transition-colors">Core Principle</span>
              <span class="w-6 h-[1px] bg-black/15 group-hover:w-12 group-hover:bg-[#8C7149] transition-all duration-500"></span>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- TESTIMONIALS SECTION (Alternating Stone BG) -->
    <section id="testimonials" class="w-full bg-[var(--color-luxury-stone,#ECE8E1)] pt-16 md:pt-24 pb-20 md:pb-28 px-[5vw] scroll-mt-28 border-t border-black/10">
      <div class="max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="font-body text-[11px] uppercase tracking-[3px] text-[#8C7149] font-medium block mb-2">Client Experiences</span>
          <h2 class="font-heading text-2xl sm:text-4xl uppercase tracking-[1px] text-[#1a1a1a] leading-tight mb-4">Testimonials</h2>
        </div>
        <TestimonialsCarousel reviews={testimonials} variant="dots" showEndCap={false} />
      </div>
    </section>

    <WorkWithAlexCTA />

  </main>
</BaseLayout>