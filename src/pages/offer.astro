---
// ============================================================================
// PAGE: src/pages/offer.astro
// PURPOSE: Gateway entry screen to accept the secure mailer code and check expiration.
// ============================================================================

import LandingPageLayout from '../layouts/LandingPageLayout.astro';
import * as XLSX from 'xlsx';
import fs from 'fs';
import path from 'path';

// Read offer.xlsx buffer safely at build time
const filePath = path.resolve('./src/data/offer.xlsx');
const fileBuffer = fs.readFileSync(filePath);
const workbook = XLSX.read(fileBuffer, { type: 'buffer' });
const sheetName = workbook.SheetNames[0];
const rows = XLSX.utils.sheet_to_json(workbook.Sheets[sheetName]);

// Create a lookup dictionary that includes slug AND expiration date (ISO format)
const codeMap: Record<string, { slug: string; expireDate: string; readableDate: string }> = {};

rows.forEach((row: any) => {
  if (row.code && row.slug) {
    const cleanCode = String(row.code).trim().toUpperCase();
    const cleanSlug = String(row.slug).trim();
    
    // Parse expiration date safely for comparison
    let rawDate = row['offer-expire'];
    let isoDate = '2026-12-31';
    let readableDate = String(rawDate || 'December 31, 2026');

    if (typeof rawDate === 'number') {
      const parsedDate = new Date((rawDate - (25567 + 2)) * 86400 * 1000);
      isoDate = parsedDate.toISOString().split('T')[0];
      readableDate = parsedDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
    } else if (typeof rawDate === 'string') {
      const parts = rawDate.trim().split('/');
      if (parts.length === 3) {
        let month = parts[0].padStart(2, '0');
        let day = parts[1].padStart(2, '0');
        let year = parts[2];
        if (year.length === 2) year = '20' + year;
        isoDate = `${year}-${month}-${day}`;
        const dObj = new Date(`${isoDate}T00:00:00Z`);
        readableDate = dObj.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
      } else {
        const parsed = Date.parse(rawDate);
        if (!isNaN(parsed)) {
          const dObj = new Date(parsed);
          isoDate = dObj.toISOString().split('T')[0];
          readableDate = dObj.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
        }
      }
    }

    codeMap[cleanCode] = {
      slug: cleanSlug,
      expireDate: isoDate,
      readableDate: readableDate
    };
  }
});
---

<LandingPageLayout title="Enter Your Offer Code">
  <main class="relative w-full min-h-screen bg-color-1 overflow-hidden flex items-center justify-center py-4 lg:py-6 px-6">
    
    <div class="absolute inset-0 bg-architectural-grid pointer-events-none"></div>
    <div class="absolute -top-20 left-10 w-[600px] h-[600px] bg-[#8C7149]/15 blur-[150px] rounded-full pointer-events-none"></div>
    <div class="absolute -bottom-20 right-10 w-[550px] h-[550px] bg-[#d3bc97]/20 blur-[160px] rounded-full pointer-events-none"></div>
    <div class="absolute -top-1/2 -right-1/2 w-full h-full bg-gradient-to-br from-[#8C7149]/15 via-transparent to-transparent rotate-12 blur-[100px] pointer-events-none"></div>
    <div class="absolute inset-0 ring-1 ring-inset ring-black/10 pointer-events-none"></div>

    <div class="relative z-10 w-full max-w-md bg-[#141312]/85 backdrop-blur-2xl border border-[#d3bc97]/25 p-8 sm:p-10 rounded-3xl shadow-[0_20px_60px_rgba(0,0,0,0.4),0_0_30px_rgba(140,113,73,0.12)] text-center space-y-6 overflow-hidden">
      
      <div class="absolute top-0 inset-x-0 h-[2px] bg-gradient-to-r from-transparent via-[#8C7149] to-transparent"></div>

      <div class="space-y-2">
        <span class="inline-flex items-center bg-black/60 text-[#d3bc97] px-3.5 py-1 rounded-full font-mono text-[10px] uppercase tracking-[2px] border border-[#d3bc97]/30 shadow-sm">
          Secure Verification
        </span>
        <h1 class="font-heading text-2xl uppercase tracking-[1.5px] text-white font-normal">
          Enter Your Offer Code
        </h1>
        <p class="font-body text-xs text-neutral-400 font-light leading-relaxed">
          Please input the unique verification code found on your exclusive mailer to access your property's customized offer.
        </p>
      </div>

      <form id="gateway-form" class="space-y-4 pt-2">
        <div>
          <input 
            type="text" 
            id="code-input" 
            placeholder="Enter your code" 
            required
            class="w-full bg-black/40 border border-white/15 rounded-xl px-4 py-4 text-center text-xl text-white tracking-[0.25em] font-mono placeholder:text-neutral-600 focus:outline-none focus:ring-2 focus:ring-[#8C7149]/50 focus:border-[#8C7149] transition-all shadow-inner uppercase"
          />
        </div>

        <button 
          type="submit"
          class="w-full font-heading text-xs uppercase tracking-[2.5px] bg-[#C5A880] text-neutral-950 font-bold py-4 px-6 rounded-xl hover:bg-[#D4B993] transition-all duration-300 border border-[#E2C79E] cursor-pointer flex items-center justify-center gap-2.5 pulse-glow-btn"
        >
          <span>Access My Secure Offer</span>
          <span class="font-mono font-black text-sm">&rarr;</span>
        </button>

        <!-- Dynamic Message Box for Errors / Expirations -->
        <p id="error-msg" class="text-rose-400 text-xs font-medium hidden bg-rose-500/10 border border-rose-500/20 p-3 rounded-xl leading-relaxed">
          Invalid code. Please check your mailer and try again.
        </p>
      </form>

      <p class="font-body text-[10px] uppercase tracking-wider text-neutral-500 pt-2">
        Protected &bull; Confidential Real Estate Consultation
      </p>
    </div>
  </main>

  <style>
    @keyframes pulseGlow {
      0% { box-shadow: 0 0 0 0 rgba(197, 168, 128, 0.7); }
      70% { box-shadow: 0 0 0 15px rgba(197, 168, 128, 0); }
      100% { box-shadow: 0 0 0 0 rgba(197, 168, 128, 0); }
    }
    .pulse-glow-btn { animation: pulseGlow 2.5s infinite; }
  </style>

  <script define:vars={{ codeMap }}>
    const form = document.getElementById('gateway-form');
    const input = document.getElementById('code-input');
    const errorMsg = document.getElementById('error-msg');

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const code = input?.value.trim().toUpperCase();
      
      if (!errorMsg) return;

      if (code && codeMap[code]) {
        const entry = codeMap[code];
        
        // Check if offer has expired compared to user's local browser date (Midnight of expire date)
        const expireDateTime = new Date(`${entry.expireDate}T23:59:59`).getTime();
        const now = Date.now();

        if (now > expireDateTime) {
          // Offer is EXPIRED
          errorMsg.className = 'text-amber-300 text-xs font-medium bg-amber-500/10 border border-amber-500/30 p-3 rounded-xl leading-relaxed';
          errorMsg.innerHTML = `This exclusive offer expired on <strong>${entry.readableDate}</strong>. Please contact Alex Yap at (408) 817-0383.`;
          errorMsg.classList.remove('hidden');
        } else {
          // Offer is ACTIVE - Proceed to slug
          window.location.href = `/offer/${entry.slug}`;
        }
      } else {
        // Code doesn't exist
        errorMsg.className = 'text-rose-400 text-xs font-medium bg-rose-500/10 border border-rose-500/20 p-3 rounded-xl leading-relaxed';
        errorMsg.textContent = 'Invalid code. Please check your mailer and try again.';
        errorMsg.classList.remove('hidden');
      }
    });
  </script>
</LandingPageLayout>