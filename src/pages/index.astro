<style>
  @keyframes scrollLine {
    0% { transform: translateY(-100%); }
    50% { transform: translateY(100%); }
    100% { transform: translateY(100%); }
  }
</style>

<script>
  function setupPageScripts() {
    // 1. Smooth Scroll Cue Triggers
    const triggers = document.querySelectorAll('.hero-scroll-trigger');
    const curtain = document.getElementById('curtain-container');

    triggers.forEach(trigger => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        if (curtain) {
          const targetY = curtain.getBoundingClientRect().top + window.pageYOffset;
          const offset = window.innerWidth >= 1024 ? 80 : 0;
          window.scrollTo({
            top: targetY - offset,
            behavior: 'smooth'
          });
        }
      });
    });

    // 2. Properties Carousel Logic
    const viewport = document.getElementById('properties-carousel-viewport');
    const track = document.getElementById('properties-carousel-track') as HTMLElement | null;
    const prevBtn = document.getElementById('prop-step-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('prop-step-next') as HTMLButtonElement | null;
    const counter = document.getElementById('prop-counter') as HTMLElement | null;
    const items = Array.from(document.querySelectorAll<HTMLElement>('.carousel-item'));

    if (track && viewport && items.length > 0 && track.dataset.initialized !== 'true') {
      track.dataset.initialized = 'true';

      const totalItems = items.length;
      let currentIndex = 0;

      function getVisibleCount(): number {
        if (window.innerWidth >= 1024) return 3;
        if (window.innerWidth >= 640) return 2;
        return 1;
      }

      function getMaxIndex(): number {
        return Math.max(0, totalItems - getVisibleCount());
      }

      function updateCarousel(newIndex: number) {
        const maxIndex = getMaxIndex();
        currentIndex = Math.max(0, Math.min(newIndex, maxIndex));

        const itemWidth = items[0].getBoundingClientRect().width;
        if (track) {
          track.style.transform = `translateX(-${currentIndex * itemWidth}px)`;
        }

        if (counter) {
          counter.innerHTML = `<strong class="text-[#1a1a1a] font-semibold">${String(currentIndex + 1).padStart(2, '0')}</strong> / ${String(totalItems).padStart(2, '0')}`;
        }

        if (prevBtn) prevBtn.disabled = currentIndex === 0;
        if (nextBtn) nextBtn.disabled = currentIndex >= maxIndex;
      }

      function goNext() {
        if (currentIndex < getMaxIndex()) updateCarousel(currentIndex + 1);
      }

      function goPrev() {
        if (currentIndex > 0) updateCarousel(currentIndex - 1);
      }

      prevBtn?.addEventListener('click', goPrev);
      nextBtn?.addEventListener('click', goNext);

      viewport.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'ArrowRight') goNext();
        if (e.key === 'ArrowLeft') goPrev();
      });

      let startX = 0;
      let startY = 0;
      let isHorizontalSwipe = false;

      viewport.addEventListener('touchstart', (e: TouchEvent) => {
        startX = e.touches[0].clientX;
        startY = e.touches[0].clientY;
        isHorizontalSwipe = false;
      }, { passive: true });

      viewport.addEventListener('touchmove', (e: TouchEvent) => {
        const currentX = e.touches[0].clientX;
        const currentY = e.touches[0].clientY;
        const diffX = Math.abs(currentX - startX);
        const diffY = Math.abs(currentY - startY);

        if (diffX > diffY && diffX > 10) {
          isHorizontalSwipe = true;
        }
      }, { passive: true });

      viewport.addEventListener('touchend', (e: TouchEvent) => {
        if (!isHorizontalSwipe) return;
        const endX = e.changedTouches[0].clientX;
        const diffX = startX - endX;

        if (Math.abs(diffX) > 40) {
          if (diffX > 0) {
            goNext();
          } else {
            goPrev();
          }
        }
      });

      window.addEventListener('resize', () => {
        updateCarousel(currentIndex);
      });

      updateCarousel(0);
    }
  }

  document.addEventListener('astro:page-load', setupPageScripts);
</script>