---
// src/pages/index.astro
import '../data/properties.xlsx?raw';
import '../data/communities.xlsx?raw';
import '../data/blogs.xlsx?raw';
import '../data/testimonials.xlsx?raw';
import BaseLayout from '../layouts/BaseLayout.astro';
import PropertyCardIndex from '../components/PropertyCardIndex.astro';
import CommunityCardIndex from '../components/CommunityCardIndex.astro';
import BlogCardIndex from '../components/BlogCardIndex.astro';
import MarqueeTicker from '../components/MarqueeTicker.astro';
import WorkWithAlexCTA from '../components/WorkWithAlexCTA.astro';
import TestimonialsCarousel from '../components/TestimonialsCarousel.astro';
import * as XLSX from 'xlsx';
import path from 'node:path';
import fs from 'node:fs';

// Helper functions for raw MLS number formatting
function formatPrice(val: any): string {
  if (val === undefined || val === null || val === '') return '';
  const cleaned = String(val).replace(/[^0-9.]/g, '');
  const num = Number(cleaned);
  if (!isNaN(num) && cleaned.length > 0) {
    return '$' + num.toLocaleString('en-US');
  }
  return String(val).trim();
}

function formatSqft(val: any): string {
  if (val === undefined || val === null || val === '') return '—';
  const cleaned = String(val).replace(/[^0-9.]/g, '');
  const num = Number(cleaned);
  if (!isNaN(num) && cleaned.length > 0) {
    return num.toLocaleString('en-US');
  }
  return String(val).trim();
}

// 1. Read properties.xlsx directly from src/data/
const propFilePath = path.resolve(process.cwd(), 'src', 'data', 'properties.xlsx');
let propRawRows: any[] = [];
if (fs.existsSync(propFilePath)) {
  const propFileBuffer = fs.readFileSync(propFilePath);
  const propWorkbook = XLSX.read(propFileBuffer, { type: 'buffer' });
  const propSheet = propWorkbook.Sheets[propWorkbook.SheetNames[0]];
  propRawRows = XLSX.utils.sheet_to_json(propSheet);
}

const fallbackHero = 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=800&q=80';

const properties = propRawRows
  .filter((row) => String(row.featured || row.Featured || '').trim().toUpperCase() === 'YES')
  .slice(0, 6)
  .map((row) => {
    const address = String(row.address || row.Address || '').trim();
    const city = String(row.city || row.City || '').trim();
    const state = String(row.state || row.State || 'California').trim();
    const status = String(row.status || row.Status || 'Active').trim();
    
    const priceVal = row.price !== undefined ? row.price : row.Price;
    const bedVal = row.bedroom !== undefined ? row.bedroom : (row.Bedrooms || row.beds);
    const bathVal = row.bathroom !== undefined ? row.bathroom : (row.Bathrooms || row.baths);
    const sqftVal = row.square !== undefined ? row.square : (row.sqft || row.Square);

    let firstImage = '';
    Object.keys(row).forEach((key) => {
      const cleanKey = key.trim().toLowerCase();
      const match = cleanKey.match(/^image[-_\s]?(\d+)$/);
      if (match && !firstImage) {
        const rawVal = row[key];
        if (rawVal !== undefined && rawVal !== null) {
          const val = String(rawVal).trim();
          if (
            val.length > 10 && 
            (val.startsWith('http://') || val.startsWith('https://') || val.startsWith('/'))
          ) {
            firstImage = val;
          }
        }
      }
    });

    const singleImage = String(row.image || row.Image || '').trim();

    return {
      title: `${address}, ${city}`.trim(),
      price: formatPrice(priceVal),
      address,
      location: `${city}, ${state}`.trim(),
      beds: Number(bedVal) || 0,
      baths: Number(bathVal) || 0,
      sqft: formatSqft(sqftVal),
      badge: status,
      image: firstImage || singleImage || fallbackHero
    };
  });

// 2. Read communities.xlsx directly from src/data/
const commFilePath = path.resolve(process.cwd(), 'src', 'data', 'communities.xlsx');
let commRawRows: any[] = [];
if (fs.existsSync(commFilePath)) {
  const commFileBuffer = fs.readFileSync(commFilePath);
  const commWorkbook = XLSX.read(commFileBuffer, { type: 'buffer' });
  const commSheet = commWorkbook.Sheets[commWorkbook.SheetNames[0]];
  commRawRows = XLSX.utils.sheet_to_json(commSheet);
}

const fallbackCommunityImage = 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=800&q=80';

const communities = commRawRows
  .filter((row) => {
    const feat = String(row.featured || row.Featured || '').trim().toUpperCase();
    return feat === 'YES' || feat === 'TRUE';
  })
  .slice(0, 4)
  .map((row) => {
    const name = String(row.name || row.Name || '').trim();
    const fallbackSlug = name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
    const slug = String(row.slug || row.Slug || fallbackSlug).trim();

    const imageEntries: { index: number; url: string }[] = [];
    Object.keys(row).forEach((key) => {
      const cleanKey = key.trim().toLowerCase();
      const match = cleanKey.match(/^image[-_\s]?(\d+)$/);
      if (match) {
        const index = parseInt(match[1], 10);
        const rawVal = row[key];
        if (rawVal !== undefined && rawVal !== null) {
          const val = String(rawVal).trim();
          if (val.length > 10 && (val.startsWith('http://') || val.startsWith('https://') || val.startsWith('/'))) {
            imageEntries.push({ index, url: val });
          }
        }
      }
    });

    imageEntries.sort((a, b) => a.index - b.index);
    const gallery = imageEntries.map((e) => e.url);

    if (gallery.length === 0) {
      const singleImage = String(row.image || row.Image || '').trim();
      gallery.push(singleImage.length > 0 ? singleImage : fallbackCommunityImage);
    }

    return {
      name,
      city: String(row.city || row.City || row.county || row.County || '').trim(),
      tagline: String(row.tagline || row.Tagline || '').trim(),
      description: String(row.description || row.Description || '').trim(),
      image: gallery[0],
      slug
    };
  });

// 3. Read blogs.xlsx directly from src/data/
const blogFilePath = path.resolve(process.cwd(), 'src', 'data', 'blogs.xlsx');
let blogRawRows: any[] = [];
if (fs.existsSync(blogFilePath)) {
  const blogFileBuffer = fs.readFileSync(blogFilePath);
  const blogWorkbook = XLSX.read(blogFileBuffer, { type: 'buffer' });
  const blogSheet = blogWorkbook.Sheets[blogWorkbook.SheetNames[0]];
  blogRawRows = XLSX.utils.sheet_to_json(blogSheet);
}

const fallbackBlogImage = 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=800&q=80';

const blogPosts = blogRawRows
  .filter((row) => {
    const feat = String(row.featured || row.Featured || '').trim().toUpperCase();
    return feat === 'YES' || feat === 'TRUE' || feat === '';
  })
  .slice(0, 3)
  .map((row) => {
    const title = String(row.title || row.Title || '').trim();
    const fallbackSlug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
    const slugVal = String(row.slug || row.Slug || fallbackSlug).trim();
    const formattedSlug = slugVal.startsWith('/') ? slugVal : `/blog/${slugVal}`;
    const rawImg = String(row.image || row.Image || '').trim();

    return {
      title,
      slug: slugVal,
      date: String(row.date || row.Date || 'Recent').trim(),
      category: String(row.category || row.Category || 'Market Intelligence').trim(),
      excerpt: String(row.description || row.Description || row.excerpt || '').trim(),
      image: rawImg.length > 0 ? rawImg : fallbackBlogImage,
      href: formattedSlug
    };
  });

// 4. Read testimonials.xlsx directly from src/data/
const testimonialFilePath = path.resolve(process.cwd(), 'src', 'data', 'testimonials.xlsx');
let allReviews: any[] = [];
if (fs.existsSync(testimonialFilePath)) {
  const testFileBuffer = fs.readFileSync(testimonialFilePath);
  const testWorkbook = XLSX.read(testFileBuffer, { type: 'buffer' });
  const testSheetName = testWorkbook.SheetNames[0];
  allReviews = XLSX.utils.sheet_to_json(testWorkbook.Sheets[testSheetName]);
}

const testimonials = allReviews.filter((item) => {
  const val = String(item.featured || '').trim().toUpperCase();
  return val === 'YES' || val === 'TRUE';
});

const blueprintPillars = [
  {
    num: "Phase 01",
    tagline: "Smart Preparation",
    title: "Invest Only Where You Get Real Dollars Back",
    description: "You shouldn't spend a single dollar fixing up your home unless it puts money back in your pocket at closing. We look at your property through the eyes of active local buyers, pointing out the simple repairs and staging choices that actually boost offer prices—and telling you which costly projects to skip."
  },
  {
    num: "Phase 02",
    tagline: "First Impressions",
    title: "Every Extra Week on Market Costs You Money",
    description: "A home gets the highest buyer attention in its first ten days. When a listing sits, buyers start asking what's wrong and look for discounts. We make sure disclosure packets and presentation are completely ready in advance to build serious interest right out of the gate."
  },
  {
    num: "Phase 03",
    tagline: "Pricing Strategy",
    title: "Price to Spark Competition, Not to Test the Waters",
    description: "Overpricing to 'see what happens' backfires almost every time. It chases away serious buyers and forces price cuts later. We study active neighborhood demand to price your home where buyers feel urgency, compete, and bid with conviction."
  },
  {
    num: "Phase 04",
    tagline: "Active Marketing",
    title: "We Hunt for Real Buyers, Not Just Post to the MLS",
    description: "Uploading a listing and sitting by the phone doesn't work. We work every inquiry directly. We follow up with every agent who unlocks the door, answer buyer questions promptly before they become objections, and keep interested parties actively engaged."
  },
  {
    num: "Phase 05",
    tagline: "Contract Defense",
    title: "Never Let a Buyer Renegotiate After You Agree",
    description: "Accepting an offer is only half the battle. Many buyers try to use home inspections or repair requests to chip away at your agreed price weeks later. We enforce contract timelines, push back on unreasonable demands, and make sure the agreed price is what you take home."
  },
  {
    num: "Phase 06",
    tagline: "Personal Attention",
    title: "You Work Directly With Alex. No Hand-Offs.",
    description: "Many teams have a senior agent sign the agreement, only to pass you off to assistants you've never met. With this practice, Alex handles your sale personally from the initial walkthrough to the day keys are handed over, giving you direct guidance at every step."
  }
];

const marqueeItems = [
  { title: "Strategic Preparation", subtitle: "High-ROI Improvements" },
  { title: "High-Impact Marketing", subtitle: "Maximum Market Exposure" },
  { title: "Multiple-Offer Strategy", subtitle: "Creating Immediate Buyer Urgency" },
  { title: "Aggressive Offer Negotiation", subtitle: "Dictating Price, Contingencies & Timelines" },
  { title: "Uncompromising Contract Defense", subtitle: "Escrow & Contingency Control" },
  { title: "Direct Guidance With Alex", subtitle: "End-to-End Representation" }
];
---

<BaseLayout title="Alex Yap Real Estate Advisor | South Bay Residential & Listing Specialist">
  
  <!-- 1. STICKY HERO VIEWPORT -->
  <div class="sticky top-0 h-[100dvh] w-full overflow-hidden z-0 bg-black">
    <video
      id="hero-video"
      autoplay
      loop
      muted
      playsinline
      preload="auto"
      poster="https://res.cloudinary.com/qogrq7ve/video/upload/so_0/v1790747968/my-web-bg-4.jpg"
      class="absolute inset-0 w-full h-full object-cover pointer-events-none"
    >
      <source src="https://res.cloudinary.com/qogrq7ve/video/upload/q_auto,vc_h264/v1790747968/my-web-bg-4.mp4" type="video/mp4" />
    </video>

    <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-black/80 pointer-events-none"></div>

    <div class="relative z-10 flex flex-col items-center justify-between h-full text-center px-6 max-w-5xl mx-auto text-white pt-28 pb-12">
      <div></div>

      <div class="flex flex-col items-center">
        <img 
          src="/images/alex-yap-logo.png" 
          alt="Alex Yap Real Estate Advisor" 
          class="h-16 md:h-24 w-auto max-w-[260px] object-contain mb-6 select-none drop-shadow-[0_4px_20px_rgba(0,0,0,0.65)]" 
          loading="eager"
        />

        <p class="font-body text-xs md:text-sm uppercase tracking-[3px] text-[#d6be96] mb-4 font-light drop-shadow">
          The Result You Seek. The Service You Deserve.
        </p>

        <h1 class="font-heading text-4xl sm:text-6xl md:text-7xl font-normal uppercase tracking-[3px] leading-tight mb-4 drop-shadow-md">
          Alex Yap
        </h1>

        <div class="flex items-center gap-3 mb-8">
          <span class="w-8 h-[1px] bg-white/40"></span>
          <p class="font-body text-xs md:text-sm uppercase tracking-[2.5px] text-white/90 font-light">
            Trusted Real Estate Advisor for Over 20 Years
          </p>
          <span class="w-8 h-[1px] bg-white/40"></span>
        </div>

        {/* Hero Primary Button */}
        <a 
          href="#listings" 
          class="hero-scroll-trigger font-heading text-xs uppercase tracking-[2.5px] bg-white text-[#1a1a1a] px-10 py-4 hover:bg-[#8C7149] hover:text-white transition-all duration-300 shadow-xl"
        >
          Explore Listings &amp; Sales
        </a>
      </div>

      <a 
        href="#listings" 
        aria-label="Scroll to listings and sales" 
        class="hero-scroll-trigger flex flex-col items-center gap-2.5 text-white/70 hover:text-white transition-colors group cursor-pointer"
      >
        <span class="font-body text-[10px] uppercase tracking-[3px]">Scroll</span>
        <div class="w-[1px] h-8 bg-white/30 relative overflow-hidden">
          <span class="absolute inset-x-0 top-0 h-1/2 bg-[#8C7149] animate-[scrollLine_2s_cubic-bezier(0.65,0,0.35,1)_infinite]"></span>
        </div>
      </a>
    </div>
  </div>

  <!-- 2. THE SLIDING CURTAIN CONTAINER -->
  <main id="curtain-container" class="relative z-20 w-full bg-[var(--color-luxury-chalk,#F4F2EE)] shadow-[0_-25px_60px_rgba(0,0,0,0.7)]">
    
    <!-- SECTION A: LISTINGS & SALES (Swapped to Stone BG) -->
    <section id="listings" class="scroll-mt-0 lg:scroll-mt-[80px] w-full pt-16 md:pt-24 pb-12 md:pb-16 overflow-hidden bg-[var(--color-luxury-stone,#ECE8E1)]">
      <div class="max-w-[96rem] mx-auto px-6 lg:px-12 mb-10">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6">
          <div>
            <p class="font-body text-[11px] uppercase tracking-[3px] text-[#8C7149] font-medium mb-1.5">
              Featured Listings &amp; Past Transactions
            </p>
            <h2 class="font-heading text-3xl sm:text-5xl uppercase tracking-[1.5px] text-[#1a1a1a] font-normal leading-tight">
              Current Listings &amp; Past Sales
            </h2>
          </div>

          <div class="flex items-center gap-4 self-start sm:self-auto">
            <span id="prop-counter" class="font-mono text-xs tracking-[2px] text-neutral-500 select-none">
              <strong class="text-[#1a1a1a] font-semibold">01</strong> / {String(properties.length + 1).padStart(2, '0')}
            </span>

            {/* Carousel Arrow Controls */}
            <div class="flex items-center gap-2">
              <button 
                type="button" 
                id="prop-step-prev" 
                aria-label="Previous listing"
                class="w-10 h-10 border border-black/15 bg-white text-[#1a1a1a] flex items-center justify-center hover:bg-[#1a1a1a] hover:text-white hover:border-[#1a1a1a] transition-all font-mono font-bold text-base cursor-pointer shadow-sm active:scale-95 disabled:opacity-25 disabled:cursor-not-allowed"
              >
                &lt;
              </button>

              <button 
                type="button" 
                id="prop-step-next" 
                aria-label="Next listing"
                class="w-10 h-10 border border-black/15 bg-white text-[#1a1a1a] flex items-center justify-center hover:bg-[#1a1a1a] hover:text-white hover:border-[#1a1a1a] transition-all font-mono font-bold text-base cursor-pointer shadow-sm active:scale-95 disabled:opacity-25 disabled:cursor-not-allowed"
              >
                &gt;
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Carousel Viewport -->
      <div 
        id="properties-carousel-viewport" 
        class="w-full overflow-hidden select-none cursor-grab active:cursor-grabbing focus:outline-none"
        tabindex="0"
        role="region"
        aria-label="Featured Listings & Sales Carousel"
        style="touch-action: pan-y;"
      >
        <div 
          id="properties-carousel-track" 
          class="flex transition-transform duration-500 ease-[cubic-bezier(0.25,1,0.5,1)] w-full will-change-transform"
        >
          {properties.map((listing, index) => (
            <div 
              class="carousel-item w-full sm:w-1/2 lg:w-1/3 shrink-0 flex flex-col"
              data-property-index={index}
            >
              <PropertyCardIndex {...listing} />
            </div>
          ))}

          <!-- End-Cap Card: View More -->
          <div 
            class="carousel-item w-full sm:w-1/2 lg:w-1/3 shrink-0 flex flex-col"
            data-property-index={properties.length}
          >
            <div class="group relative h-full min-h-[380px] sm:min-h-[400px] bg-gradient-to-b from-[#FAF8F5] via-[#F4F1EA] to-[#EBE7DF] border-r border-black/10 p-8 sm:p-12 flex flex-col items-center justify-between text-center select-none shadow-[inset_0_1px_0_rgba(255,255,255,0.8)] overflow-hidden transition-all duration-500">
              
              <div class="absolute inset-3 border border-black/[0.06] group-hover:border-[#8C7149]/40 transition-colors duration-500 pointer-events-none"></div>
              <div class="absolute inset-[15px] border border-black/[0.02] group-hover:border-[#8C7149]/20 transition-colors duration-500 pointer-events-none"></div>

              <div class="relative z-10 flex flex-col items-center gap-1.5 pt-1">
                <span class="w-1.5 h-1.5 rounded-full bg-[#8C7149]/80"></span>
                <span class="w-8 h-[1px] bg-[#8C7149]/40 group-hover:w-12 transition-all duration-500"></span>
              </div>

              <div class="relative z-10 flex flex-col items-center my-auto py-4">
                <div class="relative px-7 py-5 bg-white border border-black/10 rounded-sm shadow-[0_10px_30px_-5px_rgba(0,0,0,0.06)] group-hover:shadow-[0_16px_36px_-6px_rgba(140,113,73,0.18)] group-hover:-translate-y-1 transition-all duration-500">
                  <img 
                    src="/icons/alex-yap-logo.jpg" 
                    alt="Alex Yap Real Estate Advisor" 
                    class="h-14 sm:h-16 w-auto max-w-[190px] object-contain select-none"
                    loading="lazy"
                  />
                  <div class="absolute inset-x-4 -bottom-[1px] h-[2px] bg-gradient-to-r from-transparent via-[#8C7149]/60 to-transparent"></div>
                </div>

                <div class="my-6 flex items-center justify-center gap-2.5">
                  <span class="w-6 h-[1px] bg-black/15 group-hover:bg-[#8C7149]/60 transition-colors duration-300"></span>
                  <span class="w-1.5 h-1.5 rotate-45 border border-[#8C7149] bg-white"></span>
                  <span class="w-6 h-[1px] bg-black/15 group-hover:bg-[#8C7149]/60 transition-colors duration-300"></span>
                </div>
              </div>

              {/* Action CTA */}
              <div class="relative z-10 w-full max-w-[320px] px-2 pb-1">
                <a 
                  href="/properties" 
                  class="relative w-full font-heading text-[11px] sm:text-xs uppercase tracking-[2px] bg-[#1a1a1a] text-white px-4 sm:px-6 py-4 hover:bg-[#8C7149] hover:text-white transition-all duration-300 inline-flex items-center justify-center gap-2.5 shadow-[0_6px_20px_rgba(0,0,0,0.12)] hover:shadow-[0_10px_25px_rgba(140,113,73,0.35)] text-center leading-snug active:scale-[0.98] group/btn"
                >
                  <span>View All Listings &amp; Sales</span>
                  <span class="font-mono font-bold text-sm text-[#d3bc97] group-hover/btn:text-white transition-all duration-300 group-hover/btn:translate-x-1 shrink-0">&gt;</span>
                </a>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- SECTION B: COMMUNITIES (Swapped to Chalk BG) -->
    <section id="communities" class="scroll-mt-0 lg:scroll-mt-[80px] w-full pt-16 md:pt-24 pb-16 md:pb-24 bg-[var(--color-luxury-chalk,#F4F2EE)] overflow-hidden">
      <div class="max-w-[96rem] mx-auto px-6 lg:px-12 mb-10">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
          <div>
            <p class="font-body text-[11px] uppercase tracking-[3px] text-[#8C7149] font-medium mb-1.5">
              Bay Area Neighborhoods
            </p>
            <h2 class="font-heading text-3xl sm:text-5xl uppercase tracking-[1.5px] text-[#1a1a1a] font-normal leading-tight">
              Community Guides
            </h2>
          </div>
          <a 
            href="/communities" 
            class="font-heading text-xs uppercase tracking-[2px] text-[#1a1a1a] hover:text-[#8C7149] inline-flex items-center gap-2 transition group self-start sm:self-auto"
          >
            <span>All Neighborhoods</span>
            <span class="font-mono font-bold text-sm group-hover:translate-x-1 transition-transform">&gt;</span>
          </a>
        </div>
      </div>

      <div class="w-full grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-0">
        {communities.map((comm) => (
          <CommunityCardIndex {...comm} />
        ))}
      </div>
    </section>

    <!-- SECTION C: THE BLUEPRINT (Chalk BG) -->
    <section id="why-choose" class="scroll-mt-0 lg:scroll-mt-[80px] w-full py-20 md:py-32 bg-[var(--color-luxury-chalk,#F4F2EE)] overflow-hidden">
      <div class="max-w-[96rem] mx-auto px-6 lg:px-12">
        
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
          <div>
            <p class="font-body text-[11px] uppercase tracking-[3px] text-[#8C7149] font-medium mb-2">
              Listing Advisory &amp; Strategy
            </p>
            <h2 class="font-heading text-3xl sm:text-5xl uppercase tracking-[1.5px] text-[#1a1a1a] font-normal leading-tight">
              The Blueprint to Selling Your Home for Maximum Value
            </h2>
          </div>
          <p class="font-body text-neutral-600 text-sm max-w-md font-light leading-relaxed">
            A systematic, high-conviction approach dedicated to positioning your property to outperform the market, protect your equity, and maximize buyer competition at every stage.
          </p>
        </div>

        {/* ELEVATED 6-CARD GRID */}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 mb-16">
          {blueprintPillars.map((item) => (
            <article class="group relative bg-white border border-black/10 p-8 sm:p-10 flex flex-col justify-between shadow-[0_10px_30px_rgba(0,0,0,0.04)] hover:shadow-[0_30px_60px_-15px_rgba(140,113,73,0.18)] hover:border-[#8C7149]/50 hover:-translate-y-1.5 transition-all duration-500 overflow-hidden">
              
              <div class="absolute top-0 inset-x-0 h-[2px] bg-gradient-to-r from-transparent via-[#8C7149] to-transparent w-0 group-hover:w-full transition-all duration-700 ease-out"></div>
              
              <div class="absolute inset-3 border border-black/[0.04] group-hover:border-[#8C7149]/25 transition-colors duration-500 pointer-events-none"></div>

              <span class="absolute top-4 right-6 font-heading text-6xl md:text-7xl font-light text-black/[0.04] group-hover:text-[#8C7149]/15 select-none pointer-events-none transition-all duration-500 group-hover:scale-105">
                {item.num.replace('Phase ', '')}
              </span>

              <div class="relative z-10">
