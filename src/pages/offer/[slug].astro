---
// ============================================================================
// PAGE: src/pages/offer/[slug].astro
// PURPOSE: Self-contained personalized landing page with Excel-driven data.
// ============================================================================

import LandingLayout from '../../layouts/LandingPageLayout.astro';
import * as XLSX from 'xlsx';
import fs from 'fs';
import path from 'path';

export async function getStaticPaths() {
  const filePath = path.resolve('./src/data/offer.xlsx');
  const fileBuffer = fs.readFileSync(filePath);
  const workbook = XLSX.read(fileBuffer, { type: 'buffer' });
  const sheetName = workbook.SheetNames[0];
  const rows = XLSX.utils.sheet_to_json(workbook.Sheets[sheetName]);

  return rows.map((row: any) => {
    // Format full address string nicely
    const addressStr = `${row.address}${row['unit-number'] ? ' ' + row['unit-number'] : ''}, ${row.city}, ${row.state} ${row.zip}`;

    // Helper to safely parse and format Excel date into YYYY-MM-DD and readable text
    let rawDate = row['offer-expire'];
    let isoDate = '2026-12-31'; // Fallback default
    let readableDate = String(rawDate || 'December 31, 2026');

    if (typeof rawDate === 'number') {
      // Handle Excel serial date number conversion (e.g., 46387)
      const parsedDate = new Date((rawDate - (25567 + 2)) * 86400 * 1000);
      isoDate = parsedDate.toISOString().split('T')[0];
      readableDate = parsedDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
    } else if (typeof rawDate === 'string') {
      const parts = rawDate.trim().split('/');
      if (parts.length === 3) {
        let month = parts[0].padStart(2, '0');
        let day = parts[1].padStart(2, '0');
        let year = parts[2];
        if (year.length === 2) year = '20' + year; // Convert '26' to '2026'
        isoDate = `${year}-${month}-${day}`;
        const dObj = new Date(`${isoDate}T00:00:00Z`);
        readableDate = dObj.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
      } else {
        const parsed = Date.parse(rawDate);
        if (!isNaN(parsed)) {
          const dObj = new Date(parsed);
          isoDate = dObj.toISOString().split('T')[0];
          readableDate = dObj.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
        }
      }
    }

    return {
      params: { slug: row.slug },
      props: { 
        code: row.code,
        propertyAddress: addressStr,
        offerExpireFormatted: readableDate,
        isoExpireDate: isoDate,
        headline1: row['offer-headline-1'],
        headline2: row['offer-headline-2'],
        headline3: row['offer-headline-3']
      },
    };
  });
}

const { code, propertyAddress, offerExpireFormatted, isoExpireDate, headline1, headline2, headline3 } = Astro.props;
---

<LandingLayout 
  title={`${headline1} | Alex Yap Real Estate Advisor`}
  description={`${headline3} Offer expires ${offerExpireFormatted}.`}
>
  <main class="relative w-full min-h-screen bg-color-1 overflow-hidden flex flex-col items-center justify-center py-4 lg:py-6 px-6">
    
    {/* Background layers */}
    <div class="absolute inset-0 bg-architectural-grid pointer-events-none"></div>
    <div class="absolute -top-20 left-10 w-[600px] h-[600px] bg-[#8C7149]/15 blur-[150px] rounded-full pointer-events-none"></div>
    <div class="absolute -bottom-20 right-10 w-[550px] h-[550px] bg-[#d3bc97]/20 blur-[160px] rounded-full pointer-events-none"></div>
    <div class="absolute -top-1/2 -right-1/2 w-full h-full bg-gradient-to-br from-[#8C7149]/15 via-transparent to-transparent rotate-12 blur-[100px] pointer-events-none"></div>
    <div class="absolute inset-0 ring-1 ring-inset ring-black/10 pointer-events-none"></div>

    <div class="relative z-10 w-full max-w-2xl mx-auto flex flex-col gap-6">

      <!-- COUNTDOWN TIMER BANNER -->
      <div class="deadline-banner" role="region" aria-label="Offer Expiration Countdown" data-expire={isoExpireDate}>
        <div class="banner-header">
          <span class="banner-eyebrow">{headline2}</span>
        </div>

        <div class="clock" id="clk" role="timer" aria-label="Time remaining until offer expires">
          <div class="cunit">
            <span class="digits" id="dD">00</span>
            <em>Days</em>
          </div>
          <span class="csep">:</span>
          <div class="cunit">
            <span class="digits" id="dH">00</span>
            <em>Hours</em>
          </div>
          <span class="csep">:</span>
          <div class="cunit">
            <span class="digits" id="dM">00</span>
            <em>Mins</em>
          </div>
          <span class="csep">:</span>
          <div class="cunit">
            <span class="digits" id="dS">00</span>
            <em>Secs</em>
          </div>
        </div>

        <div class="banner-footer">
          <span>{offerExpireFormatted} &bull; Midnight PST</span>
        </div>
      </div>

      <!-- MAIN ULTRA-MODERN LUXURY FORM CARD -->
      <div class="relative bg-[#141312]/90 backdrop-blur-xl border border-[#d3bc97]/20 p-8 sm:p-14 rounded-3xl shadow-[0_30px_70px_rgba(0,0,0,0.6)] overflow-hidden text-left w-full">
        
        <div class="absolute top-0 inset-x-0 h-[2px] bg-gradient-to-r from-transparent via-[#8C7149] to-transparent"></div>

        <div class="flex justify-between items-center mb-5">
          <span class="inline-flex items-center bg-black/60 text-[#d3bc97] px-4 py-1.5 rounded-full font-mono text-[10px] uppercase tracking-[2px] shadow-inner border border-[#d3bc97]/30">
            Limited Time &bull; Expiring {offerExpireFormatted}
          </span>
          <span class="inline-flex items-center bg-blue-500/10 text-blue-400 px-3 py-1 rounded-full font-mono text-[10px] uppercase tracking-wider border border-blue-500/30">
            Code: {code}
          </span>
        </div>

        <div class="text-center mb-8">
          <h3 class="font-heading text-2xl sm:text-4xl uppercase tracking-[1.5px] text-white font-normal mb-3 leading-tight">
            {headline1}
          </h3>
          <p class="font-body text-neutral-400 text-xs sm:text-sm font-light leading-relaxed max-w-xl mx-auto">
            {headline3}
          </p>
        </div>

        <!-- Lead Capture Form Connected to Web3Forms via AJAX -->
        <form 
          method="POST" 
          class="space-y-4"
          id="listing-offer-form"
        >
          <input type="hidden" name="access_key" value="6b57a488-ac7a-4fe7-b840-5d18ca3cdebc" />
          <input type="hidden" name="subject" value="New 1% Listing Fee Campaign Submission" />
          <input type="hidden" name="from_name" value="Alex Yap 1% Listing Fee Campaign" />
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

          <!-- Property Address Field (LOCKED / READ-ONLY) -->
          <div class="space-y-1.5">
            <label for="propertyAddress" class="block font-body text-[11px] uppercase tracking-[2px] text-neutral-300 font-medium flex justify-between items-center">
              <span>Property Address <span class="text-[#8C7149]">*</span></span>
              <span class="text-[9px] text-[#8C7149] lowercase tracking-normal font-mono">Exclusive to this address</span>
            </label>
            <input 
              type="text" 
              id="propertyAddress" 
              name="property_address" 
              required 
              value={propertyAddress}
              readonly
              class="w-full bg-black/60 border border-[#8C7149]/40 rounded-xl px-4 py-3.5 text-sm font-body text-neutral-200 cursor-not-allowed shadow-inner select-none"
            />
          </div>

          <!-- Full Name Field (Editable) -->
          <div class="space-y-1.5">
            <label for="fullName" class="block font-body text-[11px] uppercase tracking-[2px] text-neutral-300 font-medium">
              Your Full Name <span class="text-[#8C7149]">*</span>
            </label>
            <input 
              type="text" 
              id="fullName" 
              name="name" 
              required 
              placeholder="Enter your name" 
              class="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-3.5 text-sm font-body text-white placeholder:text-neutral-500 focus:outline-none focus:ring-2 focus:ring-[#8C7149]/50 focus:border-[#8C7149] transition-all shadow-inner"
            />
          </div>

          <!-- Email & Phone Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1.5">
              <label for="email" class="block font-body text-[11px] uppercase tracking-[2px] text-neutral-300 font-medium">
                Email Address <span class="text-[#8C7149]">*</span>
              </label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required 
                placeholder="tom@example.com" 
                class="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-3.5 text-sm font-body text-white placeholder:text-neutral-500 focus:outline-none focus:ring-2 focus:ring-[#8C7149]/50 focus:border-[#8C7149] transition-all shadow-inner"
              />
            </div>

            <div class="space-y-1.5">
              <label for="phone" class="block font-body text-[11px] uppercase tracking-[2px] text-neutral-300 font-medium">
                Phone Number <span class="text-[#8C7149]">*</span>
              </label>
              <input 
                type="tel" 
                id="phone" 
                name="phone" 
                required 
                placeholder="408-555-0199" 
                class="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-3.5 text-sm font-body text-white placeholder:text-neutral-500 focus:outline-none focus:ring-2 focus:ring-[#8C7149]/50 focus:border-[#8C7149] transition-all shadow-inner"
              />
            </div>
          </div>

          <!-- Timeline Selector -->
          <div class="space-y-1.5">
            <label for="timeline" class="block font-body text-[11px] uppercase tracking-[2px] text-neutral-300 font-medium">
              When Are You Thinking of Selling? <span class="text-[#8C7149]">*</span>
            </label>
            <select 
              id="timeline" 
              name="selling_timeline" 
              required 
              class="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-3.5 text-sm font-body text-white focus:outline-none focus:ring-2 focus:ring-[#8C7149]/50 focus:border-[#8C7149] transition-all shadow-inner cursor-pointer"
            >
              <option value="" disabled selected class="bg-neutral-900 text-neutral-400">Select your timeframe</option>
              <option value="Immediately (Within 30 Days)" class="bg-neutral-900 text-white">Immediately (Within 30 Days)</option>
              <option value="1 to 3 Months" class="bg-neutral-900 text-white">1 to 3 Months</option>
              <option value="3 to 6 Months" class="bg-neutral-900 text-white">3 to 6 Months</option>
              <option value="Exploring Options / Just Curious" class="bg-neutral-900 text-white">Exploring Options / Just Curious</option>
            </select>
          </div>

          <!-- Message / Questions Textarea Box -->
          <div class="space-y-1.5">
            <label for="userMessage" class="block font-body text-[11px] uppercase tracking-[2px] text-neutral-300 font-medium">
              Message / Specific Questions <span class="text-neutral-500 font-normal lowercase">(optional)</span>
            </label>
            <textarea 
              id="userMessage" 
              name="user_message" 
              rows="3"
              placeholder="Share any details about your property upgrades or questions you have for Alex..." 
              class="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-3.5 text-sm font-body text-white placeholder:text-neutral-500 focus:outline-none focus:ring-2 focus:ring-[#8C7149]/50 focus:border-[#8C7149] transition-all shadow-inner resize-none"
            ></textarea>
          </div>

          <!-- Submit CTA Button -->
          <div class="pt-3">
            <button 
              type="submit" 
              id="submit-btn"
              class="w-full font-heading text-xs uppercase tracking-[2.5px] bg-[#C5A880] text-neutral-950 font-bold py-4 px-6 rounded-xl hover:bg-[#D4B993] transition-all duration-300 border border-[#E2C79E] cursor-pointer flex items-center justify-center gap-2.5 group active:scale-[0.99] pulse-glow-btn"
            >
              <span id="btn-text">Lock In 1% Listing Fee</span>
              <span id="btn-arrow" class="font-mono font-black text-sm text-neutral-950 group-hover:translate-x-1 transition-transform duration-300">&gt;</span>
            </button>
          </div>

          <div id="form-result" class="hidden text-center font-body text-xs mt-3 p-3 rounded-xl"></div>

          <p class="text-center font-body text-[10px] uppercase tracking-wider text-neutral-500 pt-2">
            Zero obligation. Your information remains strictly confidential. Terms and conditions apply.
          </p>
        </form>
      </div>

    </div>

  </main>
</LandingLayout>

<!-- STYLING WITH PULSING/FLASHING BUTTON ANIMATION -->
<style>
  .deadline-banner {
    position: relative;
    z-index: 3;
    background: linear-gradient(145deg, #161B22 0%, #0D1117 100%);
    color: #FFFFFF;
    border: 1px solid rgba(88, 166, 255, 0.3);
    border-radius: 1.25rem;
    padding: 1.75rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    text-align: center;
    font-family: 'Cabin', 'Segoe UI', system-ui, sans-serif;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6), 0 0 25px rgba(13, 17, 23, 0.4);
    backdrop-filter: blur(12px);
    width: 100%;
  }

  .banner-header { display: flex; align-items: center; justify-content: center; }
  .banner-eyebrow { font-size: 11px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: #58A6FF; }
  .clock { display: flex; gap: 1rem; align-items: center; }
  .cunit { display: flex; flex-direction: column; align-items: center; gap: 0.35rem; }
  .digits {
    display: grid; place-items: center; min-width: 52px; padding: 0.5rem 0.25rem;
    border-radius: 0.6rem; background: rgba(0, 0, 0, 0.4); border: 1px solid rgba(88, 166, 255, 0.2);
    color: #FFFFFF; font-size: 1.95rem; font-weight: 700; line-height: 1; letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums; box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.4);
  }
  .cunit em { font-style: normal; font-size: 9px; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: rgba(255, 255, 255, 0.5); }
  .csep { font-size: 1.25rem; font-weight: 700; color: #58A6FF; padding-bottom: 1rem; }
  .banner-footer {
    font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255, 255, 255, 0.6);
    border-top: 1px solid rgba(255, 255, 255, 0.08); width: 100%; padding-top: 0.75rem;
  }

  @keyframes pulseGlow {
    0% { box-shadow: 0 0 0 0 rgba(197, 168, 128, 0.7); }
    70% { box-shadow: 0 0 0 15px rgba(197, 168, 128, 0); }
    100% { box-shadow: 0 0 0 0 rgba(197, 168, 128, 0); }
  }
  .pulse-glow-btn { animation: pulseGlow 2.5s infinite; }

  @media (min-width: 640px) {
    .digits { min-width: 60px; font-size: 2.35rem; }
  }
</style>

<!-- SCRIPTS FOR COUNTDOWN AND FORM SUBMISSION -->
<script>
  (function(){
    const banner = document.querySelector('.deadline-banner');
    const expireDateStr = banner?.getAttribute('data-expire') || "2026-12-31";
    const target = Date.parse(`${expireDateStr}T23:59:59Z`);

    const units = {
      D: document.getElementById("dD"), 
      H: document.getElementById("dH"),
      M: document.getElementById("dM"), 
      S: document.getElementById("dS")
    };

    function tiles(host: HTMLElement | null, str: string) {
      if (!host) return;
      host.textContent = str;
    }

    function tickClock() {
      const ms = Math.max(0, target - Date.now());
      const d = Math.floor(ms / 86400000);
      const h = Math.floor(ms / 3600000) % 24;
      const m = Math.floor(ms / 60000) % 60;
      const s = Math.floor(ms / 1000) % 60;

      tiles(units.D, String(d));
      tiles(units.H, ("0" + h).slice(-2));
      tiles(units.M, ("0" + m).slice(-2));
      tiles(units.S, ("0" + s).slice(-2));
    }

    tickClock();
    setInterval(tickClock, 1000);
  })();

  const form = document.getElementById('listing-offer-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const btnText = document.getElementById('btn-text');
  const btnArrow = document.getElementById('btn-arrow');
  const resultDiv = document.getElementById('form-result');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    if (submitBtn) submitBtn.disabled = true;
    if (btnText) btnText.textContent = 'Sending Request...';
    if (btnArrow) btnArrow.style.display = 'none';
    if (resultDiv) {
      resultDiv.className = 'hidden';
      resultDiv.textContent = '';
    }

    const formData = new FormData(form);
    const object = Object.fromEntries(formData);
    const json = JSON.stringify(object);

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: json
      });

      const jsonResponse = await response.json();

      if (response.status === 200) {
        if (resultDiv) {
          resultDiv.className = 'block bg-emerald-950/80 text-emerald-300 border border-emerald-500/30 p-3 rounded-xl font-medium';
          resultDiv.textContent = 'Thank you! Your request has been successfully submitted. Alex will contact you shortly.';
        }
        form.reset();
      } else {
        if (resultDiv) {
          resultDiv.className = 'block bg-rose-950/80 text-rose-300 border border-rose-500/30 p-3 rounded-xl font-medium';
          resultDiv.textContent = jsonResponse.message || 'Something went wrong. Please try again.';
        }
      }
    } catch (error) {
      if (resultDiv) {
        resultDiv.className = 'block bg-rose-950/80 text-rose-300 border border-rose-500/30 p-3 rounded-xl font-medium';
        resultDiv.textContent = 'Network error. Please check your connection and try again.';
      }
    } finally {
      if (submitBtn) submitBtn.disabled = false;
      if (btnText) btnText.textContent = 'Lock In 1% Listing Fee';
      if (btnArrow) btnArrow.style.display = 'inline';
    }
  });
</script>