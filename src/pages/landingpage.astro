---
// ============================================================================
// PAGE: 1 Percent Listing Fee Campaign Landing Page
// LAYOUT: Uses LandingLayout (Zero navbar, zero footer - pure conversion)
// ============================================================================

import LandingLayout from '../layouts/LandingLayout.astro';
import ListingOfferForm from '../components/ListingOfferForm.astro';
---

<LandingLayout 
  title="Limited Time 1% Listing Fee Offer | Alex Yap Real Estate Advisor"
  description="Secure full representation, professional staging advisory, and maximum market exposure at a 1% listing commission. Offer expires December 31, 2026."
>
  <!-- Main container with enriched dark luxury aesthetic -->
  <main class="relative w-full min-h-screen bg-[#0d0c0b] overflow-hidden flex items-center justify-center py-16 lg:py-24 px-6">
    
    {/* ============================================================ */}
    {/* ENRICHED LUXURY ARCHITECTURAL BACKGROUND                     */}
    {/* ============================================================ */}
    
    {/* 1. Distinct Architectural Grid */}
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#d3bc9712_1px,transparent_1px),linear-gradient(to_bottom,#d3bc9712_1px,transparent_1px)] bg-[size:4rem_4rem] pointer-events-none"></div>

    {/* 2. Vibrant Warm Gold Ambient Lighting Orbs */}
    <div class="absolute -top-20 left-10 w-[600px] h-[600px] bg-[#8C7149]/20 blur-[150px] rounded-full pointer-events-none"></div>
    <div class="absolute -bottom-20 right-10 w-[550px] h-[550px] bg-[#d3bc97]/15 blur-[160px] rounded-full pointer-events-none"></div>

    {/* 3. Dynamic Diagonal Light Streak Accent */}
    <div class="absolute -top-1/2 -right-1/2 w-full h-full bg-gradient-to-br from-[#8C7149]/10 via-transparent to-transparent rotate-12 blur-[100px] pointer-events-none"></div>

    {/* 4. Deep Vignette Border Framing */}
    <div class="absolute inset-0 ring-1 ring-inset ring-white/10 pointer-events-none"></div>

    {/* ============================================================ */}

    {/* Centered Form Container */}
    <div class="relative z-10 w-full max-w-xl mx-auto">
      <ListingOfferForm />
    </div>

  </main>
</LandingLayout>