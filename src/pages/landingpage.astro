---
// ============================================================================
// PAGE: 1 Percent Listing Fee Campaign Landing Page
// LAYOUT: Uses LandingLayout (Zero navbar, zero footer - pure conversion)
// ============================================================================

import LandingLayout from '../layouts/LandingPageLayout.astro';
import ListingOfferWithDeadline from '../components/ListingOfferWithCountdown.astro';
---

<LandingLayout 
  title="Limited Time 1% Listing Fee Offer | Alex Yap Real Estate Advisor"
  description="Secure full representation, professional staging advisory, and maximum market exposure at a 1% listing commission. Offer expires December 31, 2026."
>
  <!-- Main container using the centralized bg-color-1 token class -->
  <main class="relative w-full min-h-screen bg-color-1 overflow-hidden flex flex-col items-center justify-center py-4 lg:py-6 px-6">
    
    {/* ============================================================ */}
    {/* ENRICHED LUXURY ARCHITECTURAL BACKGROUND                     */}
    {/* ============================================================ */}
    
    {/* 1. Distinct Architectural Grid */}
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#8C714918_1px,transparent_1px),linear-gradient(to_bottom,#8C714918_1px,transparent_1px)] bg-[size:4rem_4rem] pointer-events-none"></div>

    {/* 2. Vibrant Warm Gold Ambient Lighting Orbs */}
    <div class="absolute -top-20 left-10 w-[600px] h-[600px] bg-[#8C7149]/15 blur-[150px] rounded-full pointer-events-none"></div>
    <div class="absolute -bottom-20 right-10 w-[550px] h-[550px] bg-[#d3bc97]/20 blur-[160px] rounded-full pointer-events-none"></div>

    {/* 3. Dynamic Diagonal Light Streak Accent */}
    <div class="absolute -top-1/2 -right-1/2 w-full h-full bg-gradient-to-br from-[#8C7149]/15 via-transparent to-transparent rotate-12 blur-[100px] pointer-events-none"></div>

    {/* 4. Deep Vignette Border Framing */}
    <div class="absolute inset-0 ring-1 ring-inset ring-black/10 pointer-events-none"></div>

    {/* ============================================================ */}

    {/* Combined Component (Countdown + Lead Form) */}
    <div class="relative z-10 w-full max-w-2xl mx-auto">
      <ListingOfferWithDeadline />
    </div>

  </main>
</LandingLayout>