---
// ============================================================================
// FILE: src/pages/testimonials/[...page].astro
// PURPOSE: Dedicated Testimonials Page with 3D Overlapping Carousel & Number Pagination
// ============================================================================

import '../../data/testimonials.xlsx?raw';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkWithAlexCTA from '../../components/WorkWithAlexCTA.astro';
import TestimonialsCarousel from '../../components/TestimonialsCarousel.astro';
import * as XLSX from 'xlsx';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  return [
    { params: { page: undefined } }
  ];
}

const filePath = path.resolve(process.cwd(), 'src', 'data', 'testimonials.xlsx');
let allReviews: any[] = [];

if (fs.existsSync(filePath)) {
  const fileBuffer = fs.readFileSync(filePath);
  const workbook = XLSX.read(fileBuffer, { type: 'buffer' });
  const sheetName = workbook.SheetNames[0];
  allReviews = XLSX.utils.sheet_to_json(workbook.Sheets[sheetName]);
}
---

<BaseLayout title="Testimonials | Alex Yap Real Estate Advisor">
  <main class="w-full bg-[var(--color-luxury-stone,#ECE8E1)] overflow-x-hidden">

    <!-- Classic Left-Aligned Tailwind Editorial Header with Bottom Border -->
    <section class="w-full pt-32 pb-16 px-6 lg:px-12 bg-[var(--color-luxury-stone,#ECE8E1)] border-b border-black/10">
      <div class="max-w-5xl mx-auto flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <span class="font-body text-[11px] uppercase tracking-[3px] text-[#8C7149] font-medium block mb-2">
            Proven Results &bull; Client Stories
          </span>
          <h1 class="font-heading text-4xl sm:text-5xl font-normal uppercase tracking-[1.5px] text-[#1a1a1a]">
            Testimonials
          </h1>
        </div>
        <p class="font-body text-neutral-700 text-sm sm:text-base font-light max-w-md leading-relaxed">
          Personal attention, clear guidance, and dedicated advocacy for every client representation.
        </p>
      </div>
    </section>

    <!-- REVIEWS SECTION -->
    <section id="reviews-stage" class="w-full py-20 md:py-32 scroll-mt-24">
      <div class="max-w-[96rem] mx-auto px-6 lg:px-12">
        
        <div class="mb-14 text-center max-w-3xl mx-auto">
          <span class="font-body text-[11px] uppercase tracking-[3px] text-[#8C7149] font-medium block mb-2">Representation Matters</span>
          <h2 class="font-heading text-2xl sm:text-4xl uppercase tracking-[1px] text-[#1a1a1a] leading-tight mb-4">Stories of Trust, Equity &amp; Results</h2>
          <p class="font-body text-neutral-700 text-sm sm:text-base font-light leading-relaxed">
            Alex’s mission is to deliver the highest quality of service, experience, and professionalism to buyer and seller clients through superior marketing, cutting-edge technology, and the highest real estate standards, ensuring a seamless transaction and building relationships that last a lifetime.
          </p>
        </div>

        <TestimonialsCarousel reviews={allReviews} variant="numbers" showEndCap={false} />

      </div>
    </section>
  </main>
  
  <WorkWithAlexCTA />
</BaseLayout>