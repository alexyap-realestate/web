---
// ============================================================================
// COMPONENT: properties/[slug].astro
// USAGE: Individual property detail page. Reads property listing data from 
//        properties.xlsx, translates Excel description text into styled HTML 
//        elements via `formatDescriptionContent`, formats price, living area, 
//        and lot size with thousand separators, and renders a clean hero 
//        photo stage with an uncropped, contained image view (letterboxed 
//        matching the site's luxury stone background so no parts are cut off), 
//        overlay navigation arrows, photo counter badge, synchronized thumbnail 
//        filmstrip with custom visible scrollbar, original specifications grid, 
//        full-width matching containers, taller map, clean status-only eyebrow 
//        badge, clean bottom pagination, and duplicate-slug safety protection.
// ============================================================================

import '../../data/properties.xlsx?raw';

import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkWithAlexCTA from '../../components/WorkWithAlexCTA.astro';
import * as XLSX from 'xlsx';
import path from 'node:path';
import * as fs from 'node:fs';

export async function getStaticPaths() {
  const filePath = path.resolve(process.cwd(), 'src', 'data', 'properties.xlsx');
  const fileBuffer = fs.readFileSync(filePath);
  const workbook = XLSX.read(fileBuffer, { type: 'buffer' });
  const sheet = workbook.Sheets[workbook.SheetNames[0]];
  const rawRows: any[] = XLSX.utils.sheet_to_json(sheet);

  function formatPrice(val: any): string {
    if (val === undefined || val === null || val === '') return '';
    const cleaned = String(val).replace(/[^0-9.]/g, '');
    const num = Number(cleaned);
    if (!isNaN(num) && cleaned.length > 0) {
      return '$' + num.toLocaleString('en-US');
    }
    return String(val).trim();
  }

  function formatNumericValue(val: any): string {
    if (val === undefined || val === null || val === '') return '—';
    const cleaned = String(val).replace(/[^0-9.]/g, '');
    const num = Number(cleaned);
    if (!isNaN(num) && cleaned.length > 0) {
      return num.toLocaleString('en-US');
    }
    return String(val).trim();
  }

  const fallbackHero = 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=2560&q=85';

  // ==========================================================================
  // 🛡️ DUPLICATE-SLUG PROTECTION (Keeps first slug clean, appends -2, -3 to duplicates)
  // ==========================================================================
  const seenSlugs = new Map<string, number>();

  const processedItems = rawRows.map((row) => {
    const address = String(row.address || row.Address || '').trim();
    const city = String(row.city || row.City || '').trim();
    const state = String(row.state || row.State || 'California').trim();
    const zip = String(row.zip || row.Zip || '').trim();

    const fallbackSlug = address
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/(^-|-$)/g, '');
      
    let baseSlug = String(row.slug || row.Slug || fallbackSlug).trim();
    if (!baseSlug) baseSlug = 'property';

    let finalSlug = baseSlug;
    if (seenSlugs.has(baseSlug)) {
      const count = seenSlugs.get(baseSlug)! + 1;
      seenSlugs.set(baseSlug, count);
      finalSlug = `${baseSlug}-${count}`;
    } else {
      seenSlugs.set(baseSlug, 1);
    }

    const slug = finalSlug;

    return { row, address, city, state, zip, slug };
  }).filter(item => item.address.length > 0 && item.slug.length > 0);

  const total = processedItems.length;

  return processedItems.map((item, idx) => {
    const { row, address, city, state, zip, slug } = item;

    const prevIdx = (idx - 1 + total) % total;
    const nextIdx = (idx + 1) % total;

    const prevProperty = total > 1 ? {
      slug: processedItems[prevIdx].slug,
      address: processedItems[prevIdx].address,
      city: processedItems[prevIdx].city,
      state: processedItems[prevIdx].state,
      zip: processedItems[prevIdx].zip
    } : null;

    const nextProperty = total > 1 ? {
      slug: processedItems[nextIdx].slug,
      address: processedItems[nextIdx].address,
      city: processedItems[nextIdx].city,
      state: processedItems[nextIdx].state,
      zip: processedItems[nextIdx].zip
    } : null;

    const imageEntries: { index: number; url: string }[] = [];

    Object.keys(row).forEach((key) => {
      const cleanKey = key.trim().toLowerCase();
      const match = cleanKey.match(/^image[-_\s]?(\d+)$/);
      if (match) {
        const index = parseInt(match[1], 10);
        const rawVal = row[key];
        if (rawVal !== undefined && rawVal !== null) {
          const val = String(rawVal).trim();
          if (
            val.length > 10 && 
            (val.startsWith('http://') || val.startsWith('https://') || val.startsWith('/'))
          ) {
            imageEntries.push({ index, url: val });
          }
        }
      }
    });

    imageEntries.sort((a, b) => a.index - b.index);
    const gallery = imageEntries.map((e) => e.url);

    if (gallery.length === 0) {
      const singleImage = String(row.image || row.Image || '').trim();
      gallery.push(singleImage.length > 0 ? singleImage : fallbackHero);
    }

    const heroImage = gallery[0];
    const status = String(row.status || row.Status || 'Active').trim();
    const isSold = status.toLowerCase() === 'sold';

    const bedVal = row.bedroom !== undefined ? row.bedroom : (row.Bedrooms || row.beds);
    const bathVal = row.bathroom !== undefined ? row.bathroom : (row.Bathrooms || row.baths);
    const sqftVal = row.square !== undefined ? row.square : (row.sqft || row.Square);
    const lotSizeVal = row['lot-size'] || row.lotSize || row['Lot Size'];
    const priceVal = row.price !== undefined ? row.price : row.Price;

    return {
      params: { slug },
      props: {
        property: {
          address,
          city,
          state,
          zip,
          beds: Number(bedVal) || 0,
          baths: Number(bathVal) || 0,
          sqft: formatNumericValue(sqftVal),
          lotSqft: formatNumericValue(lotSizeVal),
          yearBuilt: String(row['year-built'] || row.yearBuilt || row['Year Built'] || '—').trim(),
          propertyType: String(row['property-type'] || row.propertyType || row['Property Type'] || 'Single Family').trim(),
          status,
          price: formatPrice(priceVal),
          representedSide: isSold ? 'Closed Transaction' : 'Listing Representation',
          description: String(row.description || row.Description || '').trim(),
          heroImage,
          gallery
        },
        prevProperty,
        nextProperty
      }
    };
  });
}

interface Props {
  property: {
    address: string;
    city: string;
    state: string;
    zip: string;
    beds: number;
    baths: number;
    sqft: string;
    lotSqft: string;
    yearBuilt: string;
    propertyType: string;
    status: string;
    price: string;
    representedSide: string;
    description: string;
    heroImage: string;
    gallery: string[];
  };
  prevProperty: { slug: string; address: string; city: string; state: string; zip: string } | null;
  nextProperty: { slug: string; address: string; city: string; state: string; zip: string } | null;
}

let props = Astro.props;

if (import.meta.env.DEV) {
  const currentSlug = Astro.params.slug;
  const filePath = path.resolve(process.cwd(), 'src', 'data', 'properties.xlsx');
  try {
    const fileBuffer = fs.readFileSync(filePath);
    const workbook = XLSX.read(fileBuffer, { type: 'buffer' });
    const sheet = workbook.Sheets[workbook.SheetNames[0]];
    const rawRows: any[] = XLSX.utils.sheet_to_json(sheet);
   
    const devSeenSlugs = new Map<string, number>();
    const processedDevRows = rawRows.map((row) => {
      const addressVal = String(row.address || row.Address || '').trim();
      const fallbackSlug = addressVal.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
      let baseSlug = String(row.slug || row.Slug || fallbackSlug).trim();
      if (!baseSlug) baseSlug = 'property';

      let finalSlug = baseSlug;
      if (devSeenSlugs.has(baseSlug)) {
        const count = devSeenSlugs.get(baseSlug)! + 1;
        devSeenSlugs.set(baseSlug, count);
        finalSlug = `${baseSlug}-${count}`;
      } else {
        devSeenSlugs.set(baseSlug, 1);
      }
      return { row, slugVal: finalSlug };
    });

    const matchedItem = processedDevRows.find(item => item.slugVal === currentSlug);

    if (matchedItem) {
      const matchedRow = matchedItem.row;
      const address = String(matchedRow.address || matchedRow.Address || '').trim();
      const city = String(matchedRow.city || matchedRow.City || '').trim();
      const state = String(matchedRow.state || matchedRow.State || 'California').trim();
      const zip = String(matchedRow.zip || matchedRow.Zip || '').trim();
      const fallbackHero = 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=2560&q=85';

      const imageEntries: { index: number; url: string }[] = [];
      Object.keys(matchedRow).forEach((key) => {
        const cleanKey = key.trim().toLowerCase();
        const match = cleanKey.match(/^image[-_\s]?(\d+)$/);
        if (match) {
          const index = parseInt(match[1], 10);
          const rawVal = matchedRow[key];
          if (rawVal !== undefined && rawVal !== null) {
            const val = String(rawVal).trim();
            if (val.length > 10 && (val.startsWith('http://') || val.startsWith('https://') || val.startsWith('/'))) {
              imageEntries.push({ index, url: val });
            }
          }
        }
      });
      imageEntries.sort((a, b) => a.index - b.index);
      const gallery = imageEntries.map((e) => e.url);
      if (gallery.length === 0) {
        const singleImage = String(matchedRow.image || matchedRow.Image || '').trim();
        gallery.push(singleImage.length > 0 ? singleImage : fallbackHero);
      }

      const status = String(matchedRow.status || matchedRow.Status || 'Active').trim();
      const isSold = status.toLowerCase() === 'sold';
      const bedVal = matchedRow.bedroom !== undefined ? matchedRow.bedroom : (matchedRow.Bedrooms || matchedRow.beds);
      const bathVal = matchedRow.bathroom !== undefined ? matchedRow.bathroom : (matchedRow.Bathrooms || matchedRow.baths);
      const sqftVal = matchedRow.square !== undefined ? matchedRow.square : (matchedRow.sqft || matchedRow.Square);
      const lotSizeVal = matchedRow['lot-size'] || matchedRow.lotSize || matchedRow['Lot Size'];
      const priceVal = matchedRow.price !== undefined ? matchedRow.price : matchedRow.Price;

      function formatPriceLive(val: any): string {
        if (val === undefined || val === null || val === '') return '';
        const cleaned = String(val).replace(/[^0-9.]/g, '');
        const num = Number(cleaned);
        if (!isNaN(num) && cleaned.length > 0) {
          return '$' + num.toLocaleString('en-US');
        }
        return String(val).trim();
      }

      function formatNumericLive(val: any): string {
        if (val === undefined || val === null || val === '') return '—';
        const cleaned = String(val).replace(/[^0-9.]/g, '');
        const num = Number(cleaned);
        if (!isNaN(num) && cleaned.length > 0) {
          return num.toLocaleString('en-US');
        }
        return String(val).trim();
      }

      props.property.address = address;
      props.property.city = city;
      props.property.state = state;
      props.property.zip = zip;
      props.property.beds = Number(bedVal) || 0;
      props.property.baths = Number(bathVal) || 0;
      props.property.sqft = formatNumericLive(sqftVal);
      props.property.lotSqft = formatNumericLive(lotSizeVal);
      props.property.yearBuilt = String(matchedRow['year-built'] || matchedRow.yearBuilt || matchedRow['Year Built'] || '—').trim();
      props.property.propertyType = String(matchedRow['property-type'] || matchedRow.propertyType || matchedRow['Property Type'] || 'Single Family').trim();
      props.property.status = status;
      props.property.price = formatPriceLive(priceVal);
      props.property.representedSide = isSold ? 'Closed Transaction' : 'Listing Representation';
      props.property.description = String(matchedRow.description || matchedRow.Description || '').trim();
      props.property.heroImage = gallery[0];
      props.property.gallery = gallery;
    }
  } catch (e) {
    // Fall back to props passed from getStaticPaths if file read fails in dev
  }
}

const { property, prevProperty, nextProperty } = props;

const fullAddress = `${property.address}, ${property.city}, ${property.state} ${property.zip}`.trim();
const encodedAddress = encodeURIComponent(fullAddress);
const mapEmbedUrl = `https://maps.google.com/maps?q=${encodedAddress}&t=&z=16&ie=UTF8&iwloc=&output=embed`;
const googleMapsDirectionsUrl = `https://www.google.com/maps/search/?api=1&query=${encodedAddress}`;
const isSold = property.status.toLowerCase() === 'sold';

// ============================================================================
// 🎯 EXCEL TEXT TRANSLATOR (formatDescriptionContent)
// ============================================================================
const formatDescriptionContent = (str: string) => {
  if (!str) return '';

  let text = str
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/&amp;/g, '&');

  if (/<\/?[a-z][\s\S]*>/i.test(text)) {
    return text;
  }

  text = text.replace(
    /^###[ \t]+(.*$)/gim, 
    '<h3 class="text-xl font-heading font-normal uppercase tracking-[1px] text-[#1a1a1a] mt-10 mb-4 leading-snug">$1</h3>'
  );

  text = text.replace(
    /^##[ \t]+(.*$)/gim, 
    '<h2 class="text-2xl sm:text-3xl font-heading font-normal uppercase tracking-[1.5px] text-[#1a1a1a] mt-12 mb-6 leading-tight border-b border-black/10 pb-3">$1</h2>'
  );

  text = text.replace(
    /\*\*(.*?)\*\*/gim, 
    '<strong class="font-medium text-[#1a1a1a]">$1</strong>'
  );

  text = text.replace(
    /\*(.*?)\*/gim, 
    '<em class="italic text-neutral-800">$1</em>'
  );

  text = text.replace(
    /\[([^\]]+)\]\((https?:\/\/[^\s\)]+)\)/gim,
    '<a href="$2" target="_blank" rel="noopener noreferrer" class="font-medium underline underline-offset-4 decoration-[#8C7149] text-[#8C7149] hover:text-[#1a1a1a] transition-colors inline-flex items-center gap-1">$1</a>'
  );

  text = text.replace(
    /^>[ \t]+(.*$)/gim,
    '<blockquote class="border-l-[3px] border-[#8C7149] bg-[#FAF8F5] pl-6 sm:pl-8 py-5 my-8 italic text-neutral-800 font-body text-base sm:text-lg leading-relaxed shadow-sm">$1</blockquote>'
  );

  text = text.replace(
    /^---$/gim,
    '<hr class="my-10 border-t border-black/10" />'
  );

  const blocks = text.split(/\r?\n\s*\r?\n/);

  const formattedBlocks = blocks
    .map((b) => b.trim())
    .filter((b) => b.length > 0)
    .map((b) => {
      if (
        b.startsWith('<h2') || 
        b.startsWith('<h3') || 
        b.startsWith('<blockquote') || 
        b.startsWith('<hr')
      ) {
        return b;
      }

      if (b.split('\n').every((line) => line.trim().startsWith('- '))) {
        const items = b
          .split('\n')
          .map((line) => `<li class="ml-4 pl-1">${line.trim().replace(/^-\s*/, '')}</li>`)
          .join('');
        return `<ul class="list-disc list-outside mb-6 space-y-2 text-neutral-700 leading-relaxed font-light font-body">${items}</ul>`;
      }

      return `<p class="mb-6 leading-[1.85] text-neutral-700 font-body font-light text-base sm:text-lg">${b.replace(/\r?\n/g, '<br />')}</p>`;
    });

  return formattedBlocks.join('');
};

const renderedDescription = formatDescriptionContent(property.description);
const totalPhotos = property.gallery.length;
---

<BaseLayout title={`${property.address} | Alex Yap Real Estate`}>
  <main class="w-full bg-[var(--color-luxury-stone,#ECE8E1)] overflow-x-hidden pt-28 md:pt-36">
    
    <!-- =================================================================== -->
    <!-- PROPERTY GALLERY STAGE & THUMBNAIL FILMSTRIP                      -->
    <!-- =================================================================== -->
    <section class="w-full pb-12 md:pb-20">
      <div class="max-w-[96rem] mx-auto px-6 lg:px-12">
        
        <!-- Back Navigation & Top Header Bar -->
        <div class="flex items-center justify-between mb-8">
          <a 
            href="/properties" 
            class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[2px] text-neutral-500 hover:text-[#8C7149] transition-colors group"
          >
            <span class="font-bold text-sm leading-none transition-transform group-hover:-translate-x-1">&lt;</span>
            <span>All Properties</span>
          </a>

          <div class="flex items-center gap-6">
            {prevProperty ? (
              <a 
                href={`/properties/${prevProperty.slug}`} 
                class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[2px] text-neutral-500 hover:text-[#8C7149] transition-colors group"
                title={prevProperty.address}
              >
                <span class="font-bold text-sm leading-none transition-transform group-hover:-translate-x-1">&lt;</span>
                <span>Prev</span>
              </a>
            ) : null}
            {nextProperty ? (
              <a 
                href={`/properties/${nextProperty.slug}`} 
                class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[2px] text-neutral-500 hover:text-[#8C7149] transition-colors group"
                title={nextProperty.address}
              >
                <span>Next</span>
                <span class="font-bold text-sm leading-none transition-transform group-hover:translate-x-1">&gt;</span>
              </a>
            ) : null}
          </div>
        </div>

        <!-- Property Address & Status Header -->
        <header class="mb-8">
          <div class="inline-flex items-center gap-2.5 mb-3 bg-white border border-black/10 px-3.5 py-1.5 shadow-sm">
            <span class="w-1.5 h-1.5 rounded-full bg-[#8C7149]"></span>
            <span class="font-body text-[10px] sm:text-[11px] uppercase tracking-[3px] text-[#8C7149] font-medium leading-none">
              {property.status}
            </span>
          </div>

          <h1 class="font-heading text-xl sm:text-2xl md:text-3xl font-normal uppercase tracking-[1px] text-[#1a1a1a] mb-2">
            {property.address}
          </h1>

          <p class="font-body text-neutral-600 text-xs sm:text-sm font-light tracking-[1px]">
            {property.city}, {property.state} {property.zip} &bull; <strong class="font-medium text-[#1a1a1a]">{property.price || (isSold ? 'Price Upon Request' : 'Inquire for Pricing')}</strong>
          </p>
        </header>

        <!-- ================================================================= -->
        <!-- PHOTO STAGE & THUMBNAIL FILMSTRIP CONTAINER                      -->
        <!-- ================================================================= -->
        <div class="bg-white border border-black/10 p-4 sm:p-6 md:p-8 shadow-[0_10px_30px_rgba(0,0,0,0.03)] mb-12">
          
          <!-- Main Large Stage Photo with Contain View & Luxury Stone Background Match -->
          <div class="relative w-full aspect-[4/3] max-h-[640px] overflow-hidden bg-[var(--color-luxury-stone,#ECE8E1)] mx-auto mb-4 border border-black/10 group flex items-center justify-center">
            <img 
              id="main-stage-img"
              src={property.gallery[0]} 
              alt={property.address} 
              class="max-w-full max-h-full w-auto h-auto object-contain transition-opacity duration-300"
            />

            {totalPhotos > 1 && (
              <div class="absolute top-4 right-4 z-20 bg-black/70 backdrop-blur-md text-white px-3.5 py-1 font-mono text-xs tracking-[2px] border border-white/20 shadow-md select-none pointer-events-none">
                <span id="current-photo-num">01</span> / {String(totalPhotos).padStart(2, '0')}
              </div>
            )}

            {property.gallery.length > 1 && (
              <>
                <button 
                  type="button" 
                  id="stage-prev-btn"
                  class="absolute left-4 top-1/2 -translate-y-1/2 z-10 w-11 h-11 rounded-full border border-white/20 bg-black/40 backdrop-blur-md flex items-center justify-center text-white hover:bg-[#8C7149] hover:border-[#8C7149] transition-all duration-300 shadow-lg cursor-pointer opacity-80 group-hover:opacity-100"
                  aria-label="Previous photo"
                >
                  <span class="font-mono font-bold text-lg">&lt;</span>
                </button>

                <button 
                  type="button" 
                  id="stage-next-btn"
                  class="absolute right-4 top-1/2 -translate-y-1/2 z-10 w-11 h-11 rounded-full border border-white/20 bg-black/40 backdrop-blur-md flex items-center justify-center text-white hover:bg-[#8C7149] hover:border-[#8C7149] transition-all duration-300 shadow-lg cursor-pointer opacity-80 group-hover:opacity-100"
                  aria-label="Next photo"
                >
                  <span class="font-mono font-bold text-lg">&gt;</span>
                </button>
              </>
            )}
          </div>

          <!-- Thumbnail Filmstrip Below with Visible Custom Scrollbar -->
          {property.gallery.length > 1 && (
            <div class="relative w-full">
              <div 
                id="film-roll"
                class="flex items-center gap-3 overflow-x-auto pb-4 pt-2 px-1 scrollbar-custom cursor-grab active:cursor-grabbing"
                tabindex="0"
                aria-label="Thumbnail strip"
              >
                {property.gallery.map((imgUrl, index) => (
                  <button 
                    type="button"
                    class={`thumb-btn relative w-24 sm:w-32 aspect-[4/3] overflow-hidden border-2 transition-all cursor-pointer bg-[var(--color-luxury-stone,#ECE8E1)] shrink-0 ${index === 0 ? 'border-[#8C7149] opacity-100 scale-100' : 'border-transparent opacity-60 hover:opacity-100'}`}
                    data-image-url={imgUrl}
                    data-thumb-index={index}
                    aria-label={`Show photo ${index + 1}`}
                  >
                    <img src={imgUrl} alt={`${property.address} thumbnail ${index + 1}`} class="w-full h-full object-cover pointer-events-none" />
                    <span class="absolute bottom-1 right-1 font-mono text-[9px] bg-black/75 text-white px-1.5 py-0.2 backdrop-blur-sm pointer-events-none">
                      {index + 1}
                    </span>
                  </button>
                ))}
              </div>
            </div>
          )}

        </div>

        <!-- ================================================================= -->
        <!-- PROPERTY SPECIFICATIONS BAR                                     -->
        <!-- ================================================================= -->
        <div class="bg-white border border-black/10 p-6 sm:p-10 mb-12 shadow-[0_4px_20px_rgba(0,0,0,0.02)]">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center pb-6 border-b border-black/10">
            <div class="min-w-0">
              <span class="block font-body text-[10px] uppercase tracking-[2px] text-[#8C7149] font-medium mb-1">Bedrooms</span>
              <span class="font-heading text-xl sm:text-2xl md:text-3xl text-[#1a1a1a] font-light">{property.beds}</span>
            </div>
            <div class="min-w-0">
              <span class="block font-body text-[10px] uppercase tracking-[2px] text-[#8C7149] font-medium mb-1">Bathrooms</span>
              <span class="font-heading text-xl sm:text-2xl md:text-3xl text-[#1a1a1a] font-light">{property.baths}</span>
            </div>
            <div class="min-w-0">
              <span class="block font-body text-[10px] uppercase tracking-[2px] text-[#8C7149] font-medium mb-1">Living Area</span>
              <span class="font-heading text-xl sm:text-2xl md:text-3xl text-[#1a1a1a] font-light">{property.sqft} <span class="text-xs font-normal">Sq.Ft.</span></span>
            </div>
            <div class="min-w-0">
              <span class="block font-body text-[10px] uppercase tracking-[2px] text-[#8C7149] font-medium mb-1">Lot Size</span>
              <span class="font-heading text-xl sm:text-2xl md:text-3xl text-[#1a1a1a] font-light">{property.lotSqft} <span class="text-xs font-normal">Sq.Ft.</span></span>
            </div>
          </div>

          <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center pt-6">
            <div class="min-w-0">
              <span class="block font-body text-[10px] uppercase tracking-[2px] text-[#8C7149] font-medium mb-1">Year Built</span>
              <span class="font-heading text-xl sm:text-2xl md:text-3xl text-[#1a1a1a] font-light">{property.yearBuilt}</span>
            </div>
            
