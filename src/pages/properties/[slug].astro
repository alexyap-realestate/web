---
// src/pages/properties/[slug].astro

// 1. Watch Excel for instant live reloads on Save
import '../../data/properties.xlsx?raw';

import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkWithAlexCTA from '../../components/WorkWithAlexCTA.astro';
import * as XLSX from 'xlsx';
import path from 'node:path';
import fs from 'node:fs';

export async function getStaticPaths() {
  const filePath = path.resolve(process.cwd(), 'src', 'data', 'properties.xlsx');
  const fileBuffer = fs.readFileSync(filePath);
  const workbook = XLSX.read(fileBuffer, { type: 'buffer' });
  const sheet = workbook.Sheets[workbook.SheetNames[0]];
  const rawRows: any[] = XLSX.utils.sheet_to_json(sheet);

  function formatPrice(val: any): string {
    if (val === undefined || val === null || val === '') return '';
    const cleaned = String(val).replace(/[^0-9.]/g, '');
    const num = Number(cleaned);
    if (!isNaN(num) && cleaned.length > 0) {
      return '$' + num.toLocaleString('en-US');
    }
    return String(val).trim();
  }

  function formatSqft(val: any): string {
    if (val === undefined || val === null || val === '') return '—';
    const cleaned = String(val).replace(/[^0-9.]/g, '');
    const num = Number(cleaned);
    if (!isNaN(num) && cleaned.length > 0) {
      return num.toLocaleString('en-US');
    }
    return String(val).trim();
  }

  const fallbackHero = 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=2560&q=85';

  const processedItems = rawRows.map((row) => {
    const address = String(row.address || row.Address || '').trim();
    const city = String(row.city || row.City || '').trim();
    const state = String(row.state || row.State || 'California').trim();
    const zip = String(row.zip || row.Zip || '').trim();

    const fallbackSlug = address
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/(^-|-$)/g, '');
    const slug = String(row.slug || row.Slug || fallbackSlug).trim();

    return { row, address, city, state, zip, slug };
  }).filter(item => item.address.length > 0 && item.slug.length > 0);

  const total = processedItems.length;

  return processedItems.map((item, idx) => {
    const { row, address, city, state, zip, slug } = item;

    const prevIdx = (idx - 1 + total) % total;
    const nextIdx = (idx + 1) % total;

    const prevProperty = total > 1 ? {
      slug: processedItems[prevIdx].slug,
      address: processedItems[prevIdx].address,
      city: processedItems[prevIdx].city,
      state: processedItems[prevIdx].state,
      zip: processedItems[prevIdx].zip
    } : null;

    const nextProperty = total > 1 ? {
      slug: processedItems[nextIdx].slug,
      address: processedItems[nextIdx].address,
      city: processedItems[nextIdx].city,
      state: processedItems[nextIdx].state,
      zip: processedItems[nextIdx].zip
    } : null;

    const imageEntries: { index: number; url: string }[] = [];

    Object.keys(row).forEach((key) => {
      const cleanKey = key.trim().toLowerCase();
      const match = cleanKey.match(/^image[-_\s]?(\d+)$/);
      if (match) {
        const index = parseInt(match[1], 10);
        const rawVal = row[key];
        if (rawVal !== undefined && rawVal !== null) {
          const val = String(rawVal).trim();
          if (
            val.length > 10 && 
            (val.startsWith('http://') || val.startsWith('https://') || val.startsWith('/'))
          ) {
            imageEntries.push({ index, url: val });
          }
        }
      }
    });

    imageEntries.sort((a, b) => a.index - b.index);
    const gallery = imageEntries.map((e) => e.url);

    if (gallery.length === 0) {
      const singleImage = String(row.image || row.Image || '').trim();
      gallery.push(singleImage.length > 0 ? singleImage : fallbackHero);
    }

    const heroImage = gallery[0];
    const status = String(row.status || row.Status || 'Active').trim();
    const isSold = status.toLowerCase() === 'sold';

    const bedVal = row.bedroom !== undefined ? row.bedroom : (row.Bedrooms || row.beds);
    const bathVal = row.bathroom !== undefined ? row.bathroom : (row.Bathrooms || row.baths);
    const sqftVal = row.square !== undefined ? row.square : (row.sqft || row.Square);
    const priceVal = row.price !== undefined ? row.price : row.Price;

    return {
      params: { slug },
      props: {
        property: {
          address,
          city,
          state,
          zip,
          beds: Number(bedVal) || 0,
          baths: Number(bathVal) || 0,
          sqft: formatSqft(sqftVal),
          lotSqft: String(row['lot-size'] || row.lotSize || row['Lot Size'] || '—').trim(),
          yearBuilt: String(row['year-built'] || row.yearBuilt || row['Year Built'] || '—').trim(),
          propertyType: String(row['property-type'] || row.propertyType || row['Property Type'] || 'Single Family').trim(),
          status,
          price: formatPrice(priceVal),
          representedSide: isSold ? 'Closed Transaction' : 'Listing Representation',
          description: String(row.description || row.Description || '').trim(),
          heroImage,
          gallery
        },
        prevProperty,
        nextProperty
      }
    };
  });
}

interface Props {
  property: {
    address: string;
    city: string;
    state: string;
    zip: string;
    beds: number;
    baths: number;
    sqft: string;
    lotSqft: string;
    yearBuilt: string;
    propertyType: string;
    status: string;
    price: string;
    representedSide: string;
    description: string;
    heroImage: string;
    gallery: string[];
  };
  prevProperty: { slug: string; address: string; city: string; state: string; zip: string } | null;
  nextProperty: { slug: string; address: string; city: string; state: string; zip: string } | null;
}

const { property, prevProperty, nextProperty } = Astro.props;

const fullAddress = `${property.address}, ${property.city}, ${property.state} ${property.zip}`.trim();
const encodedAddress = encodeURIComponent(fullAddress);
const mapEmbedUrl = `https://maps.google.com/maps?q=${encodedAddress}&t=&z=16&ie=UTF8&iwloc=&output=embed`;
const googleMapsDirectionsUrl = `https://www.google.com/maps/search/?api=1&query=${encodedAddress}`;
const isSold = property.status.toLowerCase() === 'sold';

const heroLayout = property.gallery.length >= 5 ? 'mosaic-5' : property.gallery.length >= 3 ? 'mosaic-3' : 'single';
---

<BaseLayout title={`${property.address} | Alex Yap Real Estate`}>
  
  <!-- ======================================================== -->
  <!-- 1. ADAPTIVE HERO: FLUSH UNDER NAVBAR WITH NO GAP         -->
  <!-- ======================================================== -->
  <section class="relative w-full h-[68vh] sm:h-[75vh] md:h-[82vh] max-h-[880px] min-h-[520px] bg-black mt-20 md:mt-20 border-b border-black/10 overflow-hidden select-none">
    
    <div class="w-full h-full flex flex-col">
      <div class="relative w-full flex-1 min-h-0 overflow-hidden">
        
        {heroLayout === 'mosaic-5' && (
          <div class="w-full h-full grid grid-cols-1 md:grid-cols-12 gap-1 md:gap-1.5 bg-black">
            
            <div class="h-full md:col-span-6 relative overflow-hidden group cursor-pointer" data-hero-target="0">
              <img 
                src={property.gallery[0]} 
                alt={property.address}
                class="absolute inset-0 w-full h-full object-cover object-center block transition-transform duration-700 ease-out group-hover:scale-105" 
                loading="eager"
              />
              <div class="absolute inset-0 bg-black/15 group-hover:bg-transparent transition-colors duration-300 pointer-events-none"></div>
            </div>

            <div class="hidden md:grid md:col-span-6 grid-cols-2 grid-rows-2 gap-1 md:gap-1.5 h-full min-h-0">
              <div class="w-full h-full min-h-0 relative overflow-hidden group cursor-pointer" data-hero-target="1">
                <img 
                  src={property.gallery[1]} 
                  alt={property.address}
                  class="absolute inset-0 w-full h-full object-cover object-center block transition-transform duration-700 ease-out group-hover:scale-105" 
                  loading="eager"
                />
                <div class="absolute inset-0 bg-black/15 group-hover:bg-transparent transition-colors duration-300 pointer-events-none"></div>
              </div>

              <div class="w-full h-full min-h-0 relative overflow-hidden group cursor-pointer" data-hero-target="2">
                <img 
                  src={property.gallery[2]} 
                  alt={property.address}
                  class="absolute inset-0 w-full h-full object-cover object-center block transition-transform duration-700 ease-out group-hover:scale-105" 
                  loading="eager"
                />
                <div class="absolute inset-0 bg-black/15 group-hover:bg-transparent transition-colors duration-300 pointer-events-none"></div>
              </div>

              <div class="w-full h-full min-h-0 relative overflow-hidden group cursor-pointer" data-hero-target="3">
                <img 
                  src={property.gallery[3]} 
                  alt={property.address}
                  class="absolute inset-0 w-full h-full object-cover object-center block transition-transform duration-700 ease-out group-hover:scale-105" 
                  loading="eager"
                />
                <div class="absolute inset-0 bg-black/15 group-hover:bg-transparent transition-colors duration-300 pointer-events-none"></div>
              </div>

              <div class="w-full h-full min-h-0 relative overflow-hidden group cursor-pointer" data-hero-target="4">
                <img 
                  src={property.gallery[4]} 
                  alt={property.address}
                  class="absolute inset-0 w-full h-full object-cover object-center block transition-transform duration-700 ease-out group-hover:scale-105" 
                  loading="eager"
                />
                <div class="absolute inset-0 bg-black/15 group-hover:bg-transparent transition-colors duration-300 pointer-events-none"></div>
              </div>
            </div>

          </div>
        )}

        {heroLayout === 'mosaic-3' && (
          <div class="w-full h-full grid grid-cols-1 md:grid-cols-12 gap-1 md:gap-1.5 bg-black">
            <div class="h-full md:col-span-7 lg:col-span-8 relative overflow-hidden group cursor-pointer" data-hero-target="0">
              <img 
                src={property.gallery[0]} 
                alt={property.address}
                class="absolute inset-0 w-full h-full object-cover object-center block transition-transform duration-700 ease-out group-hover:scale-105" 
                loading="eager"
              />
              <div class="absolute inset-0 bg-black/15 group-hover:bg-transparent transition-colors duration-300 pointer-events-none"></div>
            </div>

            <div class="hidden md:grid md:col-span-5 lg:col-span-4 grid-rows-2 gap-1 md:gap-1.5 h-full min-h-0">
              <div class="w-full h-full min-h-0 relative overflow-hidden group cursor-pointer" data-hero-target="1">
                <img 
                  src={property.gallery[1]} 
                  alt={property.address}
                  class="absolute inset-0 w-full h-full object-cover object-center block transition-transform duration-700 ease-out group-hover:scale-105" 
                  loading="eager"
                />
                <div class="absolute inset-0 bg-black/15 group-hover:bg-transparent transition-colors duration-300 pointer-events-none"></div>
              </div>
              <div class="w-full h-full min-h-0 relative overflow-hidden group cursor-pointer" data-hero-target="2">
                <img 
                  src={property.gallery[2]} 
                  alt={property.address}
                  class="absolute inset-0 w-full h-full object-cover object-center block transition-transform duration-700 ease-out group-hover:scale-105" 
                  loading="eager"
                />
                <div class="absolute inset-0 bg-black/15 group-hover:bg-transparent transition-colors duration-300 pointer-events-none"></div>
              </div>
            </div>
          </div>
        )}

        {heroLayout === 'single' && (
          <img 
            src={property.heroImage} 
            alt={property.address} 
            class="w-full h-full object-cover object-center block" 
            loading="eager"
          />
        )}

        <div class="absolute inset-0 bg-gradient-to-b from-black/85 via-black/30 to-black/10 pointer-events-none z-10"></div>
      </div>
    </div>

    <!-- OVERLAID TOP CONTENT -->
    <div class="absolute inset-0 z-20 w-full pt-4 md:pt-6 px-[5vw] pointer-events-none flex flex-col justify-between">
      <div class="max-w-6xl mx-auto w-full pointer-events-auto">
        
        <!-- Top Breadcrumb & Adjacent Navigation -->
        <div class="flex flex-wrap items-center justify-between gap-3 pb-3 mb-3">
          <div class="flex items-center gap-2">
            {prevProperty && (
              <a 
                href={`/properties/${prevProperty.slug}`}
                class="font-heading text-xs uppercase tracking-[2px] text-white/90 hover:text-white transition-colors inline-flex items-center gap-2 bg-black/55 backdrop-blur-md px-3.5 py-1.5 border border-white/20 shadow-md group"
                title={`Previous: ${prevProperty.address}`}
              >
                <span class="font-mono font-bold text-sm sm:text-base leading-none group-hover:-translate-x-0.5 transition-transform text-[#d6be96]">&lt;</span>
                <span class="hidden sm:inline">Prev</span>
              </a>
            )}

            <a 
              href="/properties" 
              class="font-heading text-xs uppercase tracking-[2px] text-white/90 hover:text-white transition-colors inline-flex items-center gap-2 bg-black/55 backdrop-blur-md px-4 py-1.5 border border-white/20 shadow-md"
            >
              <span>All Properties</span>
            </a>

            {nextProperty && (
              <a 
                href={`/properties/${nextProperty.slug}`}
                class="font-heading text-xs uppercase tracking-[2px] text-white/90 hover:text-white transition-colors inline-flex items-center gap-2 bg-black/55 backdrop-blur-md px-3.5 py-1.5 border border-white/20 shadow-md group"
                title={`Next: ${nextProperty.address}`}
              >
                <span class="hidden sm:inline">Next</span>
                <span class="font-mono font-bold text-sm sm:text-base leading-none group-hover:translate-x-0.5 transition-transform text-[#d6be96]">&gt;</span>
              </a>
            )}
          </div>

          {isSold && (
            <div class="flex items-center gap-2.5 bg-black/60 backdrop-blur-md px-3.5 py-1 border border-white/20 shadow-md">
              <span class="w-1.5 h-1.5 rounded-full bg-[#8C7149]"></span>
              <span class="text-[10px] font-heading uppercase tracking-[2px] text-neutral-300">
                Closed Sale
              </span>
            </div>
          )}
        </div>

      </div>

      <!-- Address and Price Row at Bottom of Hero -->
      <div class="max-w-6xl mx-auto w-full pointer-events-auto pb-6">
        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-5 text-white">
          <div class="max-w-3xl">
            <div class="mb-2">
              <span class="inline-flex items-center bg-black/80 backdrop-blur-md px-3.5 py-1 border border-white/20 shadow-md">
                <span class="font-body text-xs sm:text-sm uppercase tracking-[3px] text-white font-semibold leading-none drop-shadow-sm">
                  {property.status}
                </span>
              </span>
            </div>
            
            <h1 class="font-heading text-2xl sm:text-4xl md:text-5xl uppercase tracking-[1.5px] font-normal leading-[1.1] mb-1.5 drop-shadow-lg">
              {property.address}
            </h1>
            
            <p class="font-body text-white/95 text-xs sm:text-sm tracking-[1px] font-light drop-shadow-md">
              {property.city}, {property.state} {property.zip}
            </p>
          </div>

          <div class="lg:text-right shrink-0 bg-black/60 backdrop-blur-md lg:bg-black/40 lg:backdrop-blur-md p-3.5 sm:p-4 border border-white/20 self-start lg:self-auto shadow-lg">
            <span class="block font-body text-[10px] uppercase tracking-[2px] text-white/80 font-light mb-0.5">
              {isSold ? 'Closing Transaction' : 'Offered At'}
            </span>
            <span class="font-heading text-2xl sm:text-3xl md:text-4xl text-white font-normal drop-shadow-lg tracking-[1px]">
              {property.price || (isSold ? 'Price Upon Request' : 'Inquire for Pricing')}
            </span>
            {isSold && (
              <span class="block font-body text-[11px] text-[#d6be96] italic mt-0.5 font-light drop-shadow-sm">
                {property.representedSide}
              </span>
            )}
          </div>
        </div>
      </div>
  </div>
  </section>

  <!-- ======================================================== -->
  <!-- 2. ARCHITECTURAL THUMBNAIL RAIL (GLIDABLE + FLASH ARROW) -->
  <!-- ======================================================== -->
  {property.gallery.length > 1 && (
    <section 
      id="thumbnail-strip-section"
      class="w-full bg-white pt-6 pb-2 sm:pt-8 sm:pb-4 border-b border-black/10 overflow-hidden select-none"
    >
      <div class="max-w-6xl mx-auto px-[5vw] mb-6 flex items-center justify-center">
        <button 
          type="button" 
          id="toggle-stage-btn" 
          class="group relative inline-flex items-center gap-3.5 px-6 sm:px-8 py-3 bg-[#FBF9F6] hover:bg-[#1a1a1a] text-[#1a1a1a] hover:text-white border border-[#8C7149]/50 hover:border-[#1a1a1a] shadow-[0_4px_16px_rgba(140,113,73,0.12)] hover:shadow-xl transition-all duration-300 cursor-pointer rounded-full select-none active:scale-95"
          aria-expanded="false"
        >
          <span id="toggle-stage-text" class="font-heading text-xs sm:text-sm uppercase tracking-[2.5px] font-medium transition-colors">
            Expand Full Gallery
          </span>
          
          <span 
            id="toggle-stage-icon-wrap" 
            class="relative flex items-center justify-center w-7 h-7 rounded-full bg-[#8C7149]/20 text-[#8C7149] group-hover:bg-[#8C7149] group-hover:text-white transition-colors duration-300 animate-attention-flash"
          >
            <span class="absolute inset-0 rounded-full bg-[#8C7149]/40 animate-ping opacity-60 pointer-events-none"></span>
            <svg id="toggle-arrow-svg" class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </span>

        </button>
      </div>

      <div 
        id="film-roll"
        class="film-glider flex items-stretch gap-4 sm:gap-6 px-4 sm:px-8 pt-6 pb-6 overflow-x-auto touch-pan-x cursor-grab active:cursor-grabbing"
        tabindex="0"
        aria-label="Scrollable property photos strip"
      >
        {property.gallery.map((imgUrl, i) => (
          <button
            type="button"
            class={`film-thumb shrink-0 relative h-20 sm:h-28 md:h-36 w-32 sm:w-44 md:w-56 p-0 m-0 block cursor-pointer bg-neutral-100 ${i === 0 ? 'is-film-active' : ''}`}
            data-thumb-index={i}
            aria-label={`View photo ${i + 1}`}
          >
            <div class="w-full h-full overflow-hidden relative">
              <img 
                src={imgUrl} 
                alt={property.address}
                class="w-full h-full object-cover block pointer-events-none select-none" 
                loading="lazy"
              />
              
              <span class="absolute bottom-1.5 right-1.5 sm:bottom-2 sm:right-2 font-mono text-[9px] sm:text-[10px] tracking-[1px] bg-black/80 text-white px-2 py-0.5 backdrop-blur-sm pointer-events-none select-none z-10 shadow-sm">
                {i + 1}/{property.gallery.length}
              </span>

            </div>

            <div class="active-indicator-bars absolute -bottom-3 inset-x-0 flex items-center justify-center gap-1 pointer-events-none">
              <span class="w-2 h-0.5 rounded-full bg-[#2C251E]"></span>
              <span class="w-4 h-0.5 rounded-full bg-[#2C251E]"></span>
              <span class="w-2 h-0.5 rounded-full bg-[#2C251E]"></span>
            </div>
          </button>
        ))}
      </div>
    </section>
  )}

  <!-- ======================================================== -->
  <!-- 3. DIRECTION 3: LIGHT FROSTED GLASSMORPHISM STAGE        -->
  <!-- ======================================================== -->
  {property.gallery.length > 1 && (
    <section 
      id="gallery-drawer-section" 
      class="hidden relative w-full bg-[#F9F8F6]/85 backdrop-blur-2xl text-[#1a1a1a] pt-4 pb-8 sm:pb-12 overflow-hidden border-t border-t-[#8C7149]/20 border-b border-b-black/10 transition-all duration-500 shadow-xl"
    >
      <div 
        class="absolute inset-0 bg-[radial-gradient(circle_at_center,_rgba(255,255,255,0.7)_0%,_rgba(240,237,231,0.5)_55%,_transparent_100%)] pointer-events-none"
      ></div>

      <div 
        id="stage-ambient-glow"
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[80vw] max-w-[1200px] h-[65%] rounded-full blur-[100px] opacity-20 pointer-events-none transition-all duration-700 bg-cover bg-center"
        style={`background-image: url('${property.gallery[0]}');`}
      ></div>

      <div class="relative z-10 w-full px-6 md:px-12 mb-2 flex items-center justify-between">
        <div class="flex items-center gap-2.5 bg-white/70 backdrop-blur-md px-3.5 py-1.5 rounded-full border border-black/10 shadow-sm">
          <span class="w-1.5 h-1.5 rounded-full bg-[#8C7149]"></span>
          <span class="font-mono text-xs sm:text-sm tracking-[2px] text-neutral-600 select-none">
            <span id="active-counter-num" class="text-[#1a1a1a] font-semibold">01</span> / {String(property.gallery.length).padStart(2, '0')}
          </span>

        </div>

        <button 
          type="button" 
          id="close-stage-btn" 
          class="font-heading text-xs uppercase tracking-[2px] text-neutral-700 hover:text-black transition-colors inline-flex items-center gap-1.5 cursor-pointer bg-white/75 hover:bg-white px-4 py-1.5 rounded-full border border-black/10 shadow-sm backdrop-blur-md active:scale-95"
        >
          <span>Close View</span>
          <span class="text-base leading-none">&times;</span>
        </button>
      </div>

      <div class="relative z-10 w-full flex items-center justify-center py-1">
        
        <div 
          id="gallery-stage" 
          class="gallery-stage-container relative flex items-center justify-center overflow-visible"
          tabindex="0"
          aria-roledescription="carousel"
        >
          <button 
            type="button" 
            id="gallery-prev" 
            aria-label="Previous photo (<)"
            class="absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 z-30 w-10 h-10 sm:w-13 sm:h-13 md:w-14 md:h-14 bg-white/95 text-[#1a1a1a] hover:bg-[#1a1a1a] hover:text-white backdrop-blur-xl border border-black/15 shadow-[0_10px_30px_rgba(0,0,0,0.12)] transition-all duration-300 flex items-center justify-center cursor-pointer select-none active:scale-95"
          >
            <span class="font-mono font-bold text-lg sm:text-xl leading-none">&lt;</span>
          </button>

          <button 
            type="button" 
            id="gallery-next" 
            aria-label="Next photo (>)"
            class="absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 z-30 w-10 h-10 sm:w-13 sm:h-13 md:w-14 md:h-14 bg-white/95 text-[#1a1a1a] hover:bg-[#1a1a1a] hover:text-white backdrop-blur-xl border border-black/15 shadow-[0_10px_30px_rgba(0,0,0,0.12)] transition-all duration-300 flex items-center justify-center cursor-pointer select-none active:scale-95"
          >
            <span class="font-mono font-bold text-lg sm:text-xl leading-none">&gt;</span>
          </button>

          {property.gallery.map((imgUrl, idx) => {
            const isFirst = idx === 0;
            const initialClass = isFirst ? 'is-active' : 'is-hidden';

            return (
              <article 
                class={`gallery-slide absolute top-0 bg-neutral-900 border border-black/10 overflow-hidden select-none cursor-pointer ${initialClass}`}
                data-gallery-index={idx}
              >
                <img 
                  src={imgUrl} 
                  alt={property.address}
                  class="w-full h-full object-cover block pointer-events-none select-none" 
                  loading="eager"
                />
                <div class="absolute bottom-3 right-3 sm:bottom-5 sm:right-5 bg-black/75 backdrop-blur-md text-white px-3 py-1.5 sm:px-4 sm:py-2 font-heading text-[10px] sm:text-xs tracking-[2px] uppercase border border-white/15 z-10 shadow-md">
                  {idx + 1} / {property.gallery.length}
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- ======================================================== -->
  <!-- 4. PROPERTY DETAILS, OVERVIEW, AND MAP                   -->
  <!-- ======================================================== -->
  <main class="w-full bg-[var(--color-luxury-chalk,#F4F2EE)] pt-12 pb-20 px-[5vw]">
    <div class="max-w-6xl mx-auto">

      <!-- Specifications Bar -->
      <div class="bg-white border border-black/10 p-6 sm:p-10 mb-12 shadow-[0_4px_20px_rgba(0,0,0,0.02)]">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center pb-6">
          <div class="min-w-0">
            <span class="block font-body text-[10px] uppercase tracking-[2px] text-[#8C7149] font-medium mb-1 whitespace-nowrap">Bedrooms</span>
            <span class="font-heading text-xl sm:text-2xl md:text-3xl text-[#1a1a1a] font-light whitespace-nowrap">{property.beds}</span>
          </div>
          <div class="min-w-0">
            <span class="block font-body text-[10px] uppercase tracking-[2px] text-[#8C7149] font-medium mb-1 whitespace-nowrap">Bathrooms</span>
            <span class="font-heading text-xl sm:text-2xl md:text-3xl text-[#1a1a1a] font-light whitespace-nowrap">{property.baths}</span>
          </div>
          <div class="min-w-0">
            <span class="block font-body text-[10px] uppercase tracking-[2px] text-[#8C7149] font-medium mb-1 whitespace-nowrap">Living Area</span>
            <span class="font-heading text-xl sm:text-2xl md:text-3xl text-[#1a1a1a] font-light whitespace-nowrap">{property.sqft} <span class="text-xs font-normal">Sq.Ft.</span></span>
          </div>
          <div class="min-w-0">
            <span class="block font-body text-[10px] uppercase tracking-[2px] text-[#8C7149] font-medium mb-1 whitespace-nowrap">Lot Size</span>
            <span class="font-heading text-xl sm:text-2xl md:text-3xl text-[#1a1a1a] font-light whitespace-nowrap">{property.lotSqft} <span class="text-xs font-normal">Sq.Ft.</span></span>
          </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center pt-2">
          <div class="min-w-0">
            <span class="block font-body text-[10px] uppercase tracking-[2px] text-[#8C7149] font-medium mb-1 whitespace-nowrap">Year Built</span>
            <span class="font-heading text-xl sm:text-2xl md:text-3xl text-[#1a1a1a] font-light whitespace-nowrap">{property.yearBuilt}</span>
          </div>
          
          <div class="min-w-0 flex flex-col items-center">
            <span class="block font-body text-[10px] uppercase tracking-[2px] text-[#8C7149] font-medium mb-1 whitespace-nowrap">Property Type</span>
            <div class="w-full max-w-[200px] flex items-center justify-center h-7 sm:h-9">
              <svg viewBox="0 0 160 28" class="w-full h-full max-h-7 sm:max-h-9" aria-label={property.propertyType}>
                <text x="50%" y="21" text-anchor="middle" class="font-heading font-light fill-[#1a1a1a]" font-size="22" textLength="100%" lengthAdjust="spacingAndGlyphs">
                  {property.propertyType}
                </text>
              </svg>
            </div>
          </div>
          
          <div class="hidden md:block"></div>
          <div class="hidden md:block"></div>
        </div>
      </div>

      <!-- Narrative Overview -->
      {property.description && (
        <div class="py-12 md:py-16 my-8 border-y border-black/10">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
            <div class="lg:col-span-4 border-l-2 border-[#8C7149] pl-6 py-1">
              <h2 class="font-heading text-2xl sm:text-3xl uppercase tracking-[1px] text-[#1a1a1a] leading-tight">
                Property Overview
              </h2>
            </div>
            <div class="lg:col-span-8">
              <p class="font-body text-[#3d3d3d] text-base md:text-lg font-light leading-[1.9]">
                {property.description}
              </p>
            </div>
          </div>
        </div>
      )}

      <!-- Google Map Pin Section -->
      <section class="bg-white border border-black/10 p-6 sm:p-10 shadow-[0_4px_20px_rgba(0,0,0,0.02)] mt-12 mb-12">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-black/10">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="w-1.5 h-1.5 rounded-full bg-[#8C7149]"></span>
              <span class="font-body text-[10px] uppercase tracking-[2px] text-[#8C7149] font-medium">Location</span>
            </div>
            <h2 class="font-heading text-xl uppercase tracking-[1px] text-[#1a1a1a]">
              Neighborhood &amp; Map Pin
            </h2>
            <p class="font-body text-xs text-neutral-500 font-light mt-0.5">
              {fullAddress}
            </p>
          </div>

          <a 
            href={googleMapsDirectionsUrl}
            target="_blank" 
            rel="noopener noreferrer" 
            class="font-heading text-xs uppercase tracking-[2px] text-white bg-[#1a1a1a] hover:bg-[#8C7149] px-6 py-3.5 transition-all duration-300 inline-flex items-center gap-3 self-start sm:self-auto shadow-sm"
          >
            <span>Open in Google Maps</span>
            <span class="font-mono font-bold">&gt;</span>
          </a>
        </div>

        <div class="w-full border border-black/10 overflow-hidden bg-neutral-200 h-[380px] sm:h-[480px]">
          <iframe
            title={`Map pin for ${property.address}`}
            width="100%"
            height="100%"
            style="border:0; width: 100%; height: 100%; display: block;"
            loading="lazy"
            allowfullscreen
            referrerpolicy="no-referrer-when-downgrade"
            src={mapEmbedUrl}
          ></iframe>
        </div>
      </section>

      <!-- ======================================================== -->
      <!-- 5. REDESIGNED SLIM ARCHITECTURAL PROPERTY NAVIGATOR      -->
      <!-- ======================================================== -->
      {(prevProperty || nextProperty) && (
        <section class="border-t border-black/15 pt-8 pb-4">
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4">
            
            {prevProperty ? (
              <a 
                href={`/properties/${prevProperty.slug}`}
                class="group flex-1 flex items-center gap-3.5 p-3.5 sm:p-2 bg-white/70 sm:bg-transparent border border-black/10 sm:border-0 transition-all duration-300"
              >
                <span class="w-8 h-8 rounded-full border border-black/15 sm:border-black/20 group-hover:border-[#8C7149] group-hover:bg-[#8C7149] text-[#1a1a1a] group-hover:text-white flex items-center justify-center shrink-0 font-mono font-bold text-sm transition-all">
                  &lt;
                </span>
                <div class="min-w-0">
                  <span class="block text-[9px] uppercase tracking-[2px] text-[#8C7149] font-medium leading-none mb-1">
                    Previous Listing
                  </span>
                  <h3 class="font-heading text-sm sm:text-base uppercase tracking-[0.5px] text-[#1a1a1a] group-hover:text-[#8C7149] transition-colors truncate font-normal">
                    {prevProperty.address}
                  </h3>
                  <p class="font-body text-[11px] text-neutral-500 font-light truncate">
                    {prevProperty.city}, {prevProperty.state} {prevProperty.zip}
                  </p>
                </div>
              </a>
            ) : <div class="hidden sm:block flex-1"></div>}

            {nextProperty ? (
              <a 
                href={`/properties/${nextProperty.slug}`}
                class="group flex-1 flex items-center justify-between sm:justify-end gap-3.5 p-3.5 sm:p-2 bg-white/70 sm:bg-transparent border border-black/10 sm:border-0 transition-all duration-300 text-left sm:text-right"
              >
                <div class="min-w-0 order-1 sm:order-1">
                  <span class="block text-[9px] uppercase tracking-[2px] text-[#8C7149] font-medium leading-none mb-1">
                    Next Listing
                  </span>
                  <h3 class="font-heading text-sm sm:text-base uppercase tracking-[0.5px] text-[#1a1a1a] group-hover:text-[#8C7149] transition-colors truncate font-normal">
                    {nextProperty.address}
                  </h3>
                  <p class="font-body text-[11px] text-neutral-500 font-light truncate">
                    {nextProperty.city}, {nextProperty.state} {nextProperty.zip}
                  </p>
                </div>
                <span class="w-8 h-8 rounded-full border border-black/15 sm:border-black/20 group-hover:border-[#8C7149] group-hover:bg-[#8C7149] text-[#1a1a1a] group-hover:text-white flex items-center justify-center shrink-0 font-mono font-bold text-sm transition-all order-2 sm:order-2">
                  &gt;
                </span>
              </a>
            ) : <div class="hidden sm:block flex-1"></div>}

          </div>
        </section>
      )}

    </div>
  </main>

  <WorkWithAlexCTA />
</BaseLayout>

<style>
  .gallery-stage-container {
    height: min(65vh, 680px) !important;
    max-height: 680px;
    aspect-ratio: 16 / 10 !important;
    width: 92vw !important;
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
  }

  @media (max-height: 750px) {
    .gallery-stage-container {
      height: 56vh !important;
      max-height: 56vh;
    }
  }

  @media (max-width: 640px) {
    .gallery-stage-container {
      width: 94vw !important;
      max-width: 94vw !important;
      height: auto !important;
      max-height: none !important;
      aspect-ratio: 16 / 10 !important;
    }
  }

  .gallery-slide {
    width: 100% !important;
    height: 100% !important;
    aspect-ratio: 16 / 10 !important;
    transition: opacity 0.4s ease, box-shadow 0.4s ease;
    will-change: opacity;
  }

  .gallery-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .gallery-slide.is-active {
    opacity: 1 !important;
    z-index: 20;
    pointer-events: auto;
    box-shadow: 0 25px 60px -12px rgba(44, 37, 30, 0.28), 0 8px 24px -6px rgba(0, 0, 0, 0.12);
  }

  .gallery-slide.is-hidden {
    opacity: 0 !important;
    z-index: 0;
    pointer-events: none;
  }

  @keyframes attentionFlash {
    0%, 100% {
      transform: translateY(0);
      filter: drop-shadow(0 0 0 rgba(140, 113, 73, 0));
    }
    50% {
      transform: translateY(3px);
      filter: drop-shadow(0 0 8px rgba(140, 113, 73, 0.7));
    }
  }

  .animate-attention-flash {
    animation: attentionFlash 1.6s ease-in-out infinite;
  }

  .film-glider {
    overflow-x: scroll !important;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scroll-behavior: smooth;
    scrollbar-width: thin;
    scrollbar-color: #8C7149 #ECE8E1;
    user-select: none;
  }

  .film-glider::-webkit-scrollbar {
    display: block !important;
    height: 8px !important;
  }

  .film-glider::-webkit-scrollbar-track {
    background: #ECE8E1;
    border-radius: 9999px;
    margin: 0 20px;
  }

  .film-glider::-webkit-scrollbar-thumb {
    background-color: #8C7149;
    border-radius: 9999px;
    border: 1px solid #ECE8E1;
    transition: background-color 0.2s ease;
  }

  .film-glider::-webkit-scrollbar-thumb:hover {
    background-color: #2C251E;
  }

  .film-thumb {
    border: 5px solid transparent;
    transform-origin: center bottom;
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
                border-color 0.2s ease,
                box-shadow 0.25s ease,
                opacity 0.2s ease,
                filter 0.2s ease;
  }
  @media (min-width: 640px) {
    .film-thumb { border-width: 6px; }
  }

  .film-thumb.is-film-active {
    opacity: 1 !important;
    filter: brightness(1) !important;
    border-color: #2C251E !important;
    transform: scale(1.06);
    box-shadow: 0 12px 24px rgba(44, 37, 30, 0.24), 0 4px 8px rgba(0, 0, 0, 0.08);
    z-index: 20;
  }

  .film-thumb:not(.is-film-active) {
    opacity: 0.85 !important;
    filter: brightness(0.94);
  }
  .film-thumb:not(.is-film-active):hover {
    opacity: 1 !important;
    filter: brightness(1);
    border-color: rgba(44, 37, 30, 0.35);
    transform: scale(1.02);
    box-shadow: 0 6px 14px rgba(44, 37, 30, 0.08);
  }

  .film-thumb .active-indicator-bars {
    opacity: 0;
    transform: translateY(-2px);
    transition: opacity 0.25s ease, transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .film-thumb.is-film-active .active-indicator-bars {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  function setupPropertyCarousel() {
    const stage = document.getElementById('gallery-stage');
    const drawerSection = document.getElementById('gallery-drawer-section');
    const thumbnailStripSection = document.getElementById('thumbnail-strip-section');
    const toggleBtn = document.getElementById('toggle-stage-btn');
    const toggleText = document.getElementById('toggle-stage-text');
    const arrowSvg = document.getElementById('toggle-arrow-svg');
    const iconWrap = document.getElementById('toggle-stage-icon-wrap');
    const closeBtn = document.getElementById('close-stage-btn');

    if (!stage) return;

    const slides = Array.from(document.querySelectorAll<HTMLElement>('.gallery-slide'));
    const prevBtn = document.getElementById('gallery-prev');
    const nextBtn = document.getElementById('gallery-next');
    const thumbs = Array.from(document.querySelectorAll<HTMLElement>('.film-thumb'));
    const filmRoll = document.getElementById('film-roll') as HTMLElement | null;
    const counterNum = document.getElementById('active-counter-num');
    const ambientGlow = document.getElementById('stage-ambient-glow');

    if (slides.length === 0) return;

    let currentIndex = 0;
    const total = slides.length;
    let isStageOpen = false;

    if (filmRoll) {
      filmRoll.addEventListener('wheel', (e) => {
        if (e.deltaY !== 0) {
          e.preventDefault();
          filmRoll.scrollLeft += e.deltaY * 1.2;
        }
      }, { passive: false });

      let isDown = false;
      let startX = 0;
      let scrollLeft = 0;
      let isDragging = false;

      filmRoll.addEventListener('mousedown', (e) => {
        isDown = true;
        isDragging = false;
        startX = e.pageX - filmRoll.offsetLeft;
        scrollLeft = filmRoll.scrollLeft;
        filmRoll.style.cursor = 'grabbing';
      });

      window.addEventListener('mouseup', () => {
        if (!isDown) return;
        isDown = false;
        if (filmRoll) filmRoll.style.cursor = 'grab';
      });

      filmRoll.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - filmRoll.offsetLeft;
        const walk = (x - startX) * 1.5;
        if (Math.abs(walk) > 5) {
          isDragging = true;
        }
        filmRoll.scrollLeft = scrollLeft - walk;
      });

      thumbs.forEach((thumb, idx) => {
        thumb.addEventListener('click', (e) => {
          if (isDragging) {
            e.preventDefault();
            e.stopPropagation();
            isDragging = false;
            return;
          }
          if (!isStageOpen) {
            openStage(idx);
          } else {
            currentIndex = idx;
            updateCarousel();
          }
        });
      });
    }

    function scrollToGallerySection() {
      if (!thumbnailStripSection) return;
      const navHeight = window.innerWidth >= 768 ? 84 : 68;
      const targetY = thumbnailStripSection.getBoundingClientRect().top + window.pageYOffset - navHeight;

      window.scrollTo({
        top: Math.max(0, targetY),
        behavior: 'smooth'
      });
    }

    function openStage(targetIndex?: number) {
      if (!drawerSection) return;
      drawerSection.classList.remove('hidden');
      isStageOpen = true;

      if (toggleText) toggleText.textContent = "Collapse View";
      if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'true');
      if (arrowSvg) arrowSvg.style.transform = 'rotate(180deg)';
      if (iconWrap) iconWrap.classList.remove('animate-attention-flash');

      if (typeof targetIndex === 'number') {
        currentIndex = targetIndex;
      }
      updateCarousel();

      requestAnimationFrame(() => {
        scrollToGallerySection();
      });
    }

    function closeStage() {
      if (!drawerSection) return;
      drawerSection.classList.add('hidden');
      isStageOpen = false;

      if (toggleText) toggleText.textContent = "Expand Full Gallery";
      if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'false');
      if (arrowSvg) arrowSvg.style.transform = 'rotate(0deg)';
      if (iconWrap) iconWrap.classList.add('animate-attention-flash');
    }

    toggleBtn?.addEventListener('click', () => {
      if (isStageOpen) closeStage();
      else openStage();
    });

    closeBtn?.addEventListener('click', closeStage);

    document.querySelectorAll('[data-hero-target]').forEach((el) => {
      el.addEventListener('click', () => {
        const targetIdx = parseInt(el.getAttribute('data-hero-target') || '0', 10);
        openStage(targetIdx);
      });
    });

    function centerActiveThumbnail(index: number) {
      if (!filmRoll || !thumbs[index]) return;
      const activeThumb = thumbs[index];

      const thumbLeft = activeThumb.offsetLeft;
      const thumbWidth = activeThumb.offsetWidth;
      const rollWidth = filmRoll.clientWidth;
      const targetScrollLeft = thumbLeft - (rollWidth / 2) + (thumbWidth / 2);

      filmRoll.scrollTo({
        left: targetScrollLeft,
        behavior: 'smooth'
      });
    }

    function updateCarousel() {
      slides.forEach((slide, i) => {
        slide.classList.remove('is-active', 'is-hidden');

        if (i === currentIndex) {
          slide.classList.add('is-active');
        } else {
          slide.classList.add('is-hidden');
        }
      });

      thumbs.forEach((thumb, idx) => {
        const isActive = idx === currentIndex;
        thumb.classList.toggle('is-film-active', isActive);
      });

      if (counterNum) {
        counterNum.textContent = String(currentIndex + 1).padStart(2, '0');
      }

      if (ambientGlow) {
        const activeImg = slides[currentIndex]?.querySelector('img');
        if (activeImg) {
          ambientGlow.style.backgroundImage = `url('${activeImg.src}')`;
        }
      }

      centerActiveThumbnail(currentIndex);
    }

    function goNext() {
      currentIndex = (currentIndex + 1) % total;
      updateCarousel();
    }

    function goPrev() {
      currentIndex = (currentIndex - 1 + total) % total;
      updateCarousel();
    }

    if (prevBtn) prevBtn.onclick = goPrev;
    if (nextBtn) nextBtn.onclick = goNext;

    let stageTouchStartX = 0;
    stage.addEventListener('touchstart', (e) => {
      stageTouchStartX = e.touches[0].clientX;
    }, { passive: true });

    stage.addEventListener('touchend', (e) => {
      const diff = stageTouchStartX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 40) {
        if (diff > 0) goNext();
        else goPrev();
      }
    });

    const handleKeydown = (e: KeyboardEvent) => {
      const target = e.target as HTMLElement;
      if (target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable)) {
        return;
      }

      if (e.key === '<' || e.key === ',' || e.key === 'ArrowLeft') {
        e.preventDefault();
        goPrev();
      } else if (e.key === '>' || e.key === '.' || e.key === 'ArrowRight') {
        e.preventDefault();
        goNext();
      }
    };

    window.addEventListener('keydown', handleKeydown);

    updateCarousel();
  }

  setupPropertyCarousel();
  document.addEventListener('astro:page-load', setupPropertyCarousel);
</script>