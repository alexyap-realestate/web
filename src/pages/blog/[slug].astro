---
// ============================================================================
// FILE: src/pages/blog/[slug].astro
// PURPOSE: Renders an individual blog post reading page. It also features 
//          duplicate-slug safety checks and translates plain text/markdown 
//          written in Excel into clean website HTML elements.
// ============================================================================

// 1. Watches Excel file for changes
import '../../data/blogs.xlsx?raw';

// 2. Imports layouts and components
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkWithAlexCTA from '../../components/WorkWithAlexCTA.astro';

// 3. Imports Node.js file reading tools and XLSX parser
import * as XLSX from 'xlsx';
import path from 'node:path';
import * as fs from 'node:fs';

// Defines the structure of a single blog post
export interface BlogPost {
  title: string;
  slug: string;
  date: string;
  category: string;
  excerpt: string;
  image: string;
  content: string;
}

// ============================================================================
// STEP A: GET STATIC PATHS (Creates a unique web URL page for every article)
// ============================================================================
export async function getStaticPaths() {
  const filePath = path.resolve(process.cwd(), 'src', 'data', 'blogs.xlsx');
  const fileBuffer = fs.readFileSync(filePath);
  const workbook = XLSX.read(fileBuffer, { type: 'buffer' });
  const sheet = workbook.Sheets[workbook.SheetNames[0]];
  const rawRows: any[] = XLSX.utils.sheet_to_json(sheet, { defval: '' });
  const fallbackImage = 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1200&q=80';

  const parseDate = (dateVal: any) => {
    if (!dateVal) return '';
    const num = Number(dateVal);
    if (!isNaN(num) && num > 30000) {
      const utcDays = Math.floor(num - 25569);
      const dateObj = new Date(utcDays * 86400 * 1000);
      return dateObj.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    }
    return String(dateVal).trim();
  };

  const rawPosts = rawRows.map((row) => {
    const normalizedRow: Record<string, any> = {};
    for (const [key, val] of Object.entries(row)) {
      normalizedRow[key.trim().toLowerCase()] = val;
    }
    const title = String(normalizedRow.title || '').trim();
    if (!title) return null;

    const fallbackSlug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
    const slug = String(normalizedRow.slug || fallbackSlug).trim();
    const date = parseDate(normalizedRow.date);
    const category = String(normalizedRow.category || normalizedRow.tag || 'Market Insights').trim();
    const excerpt = String(normalizedRow.excerpt || normalizedRow.description || '').trim();
    const image = String(normalizedRow.image || fallbackImage).trim();
    const content = String(normalizedRow.content || '').trim();

    return {
      title,
      slug,
      date,
      category,
      excerpt,
      image: image.length > 0 ? image : fallbackImage,
      content
    };
  }).filter((post): post is NonNullable<typeof post> => post !== null && post.title.length > 0);

  // Duplicate slug prevention map (appends -2, -3 if two posts share a slug)
  const seenSlugs = new Map<string, number>();
  const allPosts = rawPosts.map((post) => {
    const baseSlug = post.slug || 'post';
    let finalSlug = baseSlug;
    if (seenSlugs.has(baseSlug)) {
      const count = seenSlugs.get(baseSlug)! + 1;
      seenSlugs.set(baseSlug, count);
      finalSlug = `${baseSlug}-${count}`;
    } else {
      seenSlugs.set(baseSlug, 1);
    }
    return { ...post, slug: finalSlug };
  });

  // Maps out previous and next article navigation links for the bottom of the page
  return allPosts.map((post, index) => {
    const prevPost = index > 0 ? allPosts[index - 1] : null;
    const nextPost = index < allPosts.length - 1 ? allPosts[index + 1] : null;

    return {
      params: { slug: post.slug },
      props: {
        post,
        prevPost: prevPost ? { title: prevPost.title, slug: prevPost.slug } : null,
        nextPost: nextPost ? { title: nextPost.title, slug: nextPost.slug } : null,
      }
    };
  });
}

// Defines page props
interface Props {
  post: BlogPost;
  prevPost: { title: string; slug: string } | null;
  nextPost: { title: string; slug: string } | null;
}

let { post, prevPost, nextPost } = Astro.props;

// ============================================================================
// STEP B: DEV MODE LIVE RELOAD
// ============================================================================
if (import.meta.env.DEV) {
  const currentSlug = Astro.params.slug;
  const filePath = path.resolve(process.cwd(), 'src', 'data', 'blogs.xlsx');
  try {
    const fileBuffer = fs.readFileSync(filePath);
    const workbook = XLSX.read(fileBuffer, { type: 'buffer' });
    const sheet = workbook.Sheets[workbook.SheetNames[0]];
    const rawRows: any[] = XLSX.utils.sheet_to_json(sheet, { defval: '' });
    const fallbackImage = 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1200&q=80';

    const parseDate = (dateVal: any) => {
      if (!dateVal) return '';
      const num = Number(dateVal);
      if (!isNaN(num) && num > 30000) {
        const utcDays = Math.floor(num - 25569);
        const dateObj = new Date(utcDays * 86400 * 1000);
        return dateObj.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
      }
      return String(dateVal).trim();
    };

    const rawLivePosts = rawRows.map((row) => {
      const normalizedRow: Record<string, any> = {};
      for (const [key, val] of Object.entries(row)) {
        normalizedRow[key.trim().toLowerCase()] = val;
      }
      const title = String(normalizedRow.title || '').trim();
      if (!title) return null;
      const fallbackSlug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
      const slug = String(normalizedRow.slug || fallbackSlug).trim();
      const date = parseDate(normalizedRow.date);
      const category = String(normalizedRow.category || normalizedRow.tag || 'Market Insights').trim();
      const excerpt = String(normalizedRow.excerpt || normalizedRow.description || '').trim();
      const image = String(normalizedRow.image || fallbackImage).trim();
      const content = String(normalizedRow.content || '').trim();

      return { title, slug, date, category, excerpt, image: image.length > 0 ? image : fallbackImage, content };
    }).filter((post): post is NonNullable<typeof post> => post !== null && post.title.length > 0);

    const seenSlugsDev = new Map<string, number>();
    const livePosts = rawLivePosts.map((p) => {
      const baseSlug = p.slug || 'post';
      let finalSlug = baseSlug;
      if (seenSlugsDev.has(baseSlug)) {
        const count = seenSlugsDev.get(baseSlug)! + 1;
        seenSlugsDev.set(baseSlug, count);
        finalSlug = `${baseSlug}-${count}`;
      } else {
        seenSlugsDev.set(baseSlug, 1);
      }
      return { ...p, slug: finalSlug };
    });

    const currentIndex = livePosts.findIndex((p) => p.slug === currentSlug);
    if (currentIndex !== -1) {
      post = livePosts[currentIndex];
      const prev = currentIndex > 0 ? livePosts[currentIndex - 1] : null;
      const next = currentIndex < livePosts.length - 1 ? livePosts[currentIndex + 1] : null;
      prevPost = prev ? { title: prev.title, slug: prev.slug } : null;
      nextPost = next ? { title: next.title, slug: next.slug } : null;
    }
  } catch (e) {
    // Fallback on error
  }
}

// ============================================================================
// STEP C: EXCEL TEXT TRANSLATOR (Converts text symbols to styled HTML elements)
// ============================================================================
const formatPostContent = (str: string) => {
  if (!str) return '';
  let text = str
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/&amp;/g, '&');

  if (/<\/?[a-z][\s\S]*>/i.test(text)) {
    return text;
  }

  // Turns ### into Subheadings
  text = text.replace(
    /^###[ \t]+(.*$)/gim, 
    '<h3 class="text-xl font-heading font-normal uppercase tracking-[1px] text-[#1a1a1a] mt-10 mb-4 leading-snug">$1</h3>'
  );
  // Turns ## into Main Headings
  text = text.replace(
    /^##[ \t]+(.*$)/gim, 
    '<h2 class="text-2xl sm:text-3xl font-heading font-normal uppercase tracking-[1.5px] text-[#1a1a1a] mt-12 mb-6 leading-tight border-b border-black/10 pb-3">$1</h2>'
  );
  // Turns **bold** text
  text = text.replace(/\*\*(.*?)\*\*/gim, '<strong class="font-medium text-[#1a1a1a]">$1</strong>');
  // Turns *italic* text
  text = text.replace(/\*(.*?)\*/gim, '<em class="italic text-neutral-800">$1</em>');
  // Turns links into clickable gold underlines
  text = text.replace(
    /\[([^\]]+)\]\((https?:\/\/[^\s\)]+)\)/gim,
    '<a href="$2" target="_blank" rel="noopener noreferrer" class="font-medium underline underline-offset-4 decoration-[#8C7149] text-[#8C7149] hover:text-[#1a1a1a] transition-colors inline-flex items-center gap-1">$1</a>'
  );
  // Turns > into quote boxes
  text = text.replace(
    /^>[ \t]+(.*$)/gim,
    '<blockquote class="border-l-[3px] border-[#8C7149] bg-[#FAF8F5] pl-6 sm:pl-8 py-5 my-8 italic text-neutral-800 font-body text-base sm:text-lg leading-relaxed shadow-sm">$1</blockquote>'
  );
  // Turns --- into divider lines
  text = text.replace(/^---$/gim, '<hr class="my-10 border-t border-black/10" />');

  // Formats paragraphs and bullet lists
  const blocks = text.split(/\r?\n\s*\r?\n/);
  const formattedBlocks = blocks
    .map((b) => b.trim())
    .filter((b) => b.length > 0)
    .map((b) => {
      if (b.startsWith('<h2') || b.startsWith('<h3') || b.startsWith('<blockquote') || b.startsWith('<hr')) {
        return b;
      }
      if (b.split('\n').every((line) => line.trim().startsWith('- '))) {
        const items = b
          .split('\n')
          .map((line) => `<li class="ml-4 pl-1">${line.trim().replace(/^-\s*/, '')}</li>`)
          .join('');
        return `<ul class="list-disc list-outside mb-6 space-y-2 text-neutral-700 leading-relaxed font-light font-body">${items}</ul>`;
      }
      return `<p class="mb-6 leading-[1.85] text-neutral-700 font-body font-light text-base sm:text-lg">${b.replace(/\r?\n/g, '<br />')}</p>`;
    });

  return formattedBlocks.join('');
};

const renderedContent = formatPostContent(post.content);
---

<!-- ============================================================================ -->
<!-- HTML VISUAL TEMPLATE FOR INDIVIDUAL ARTICLE PAGES                             -->
<!-- ============================================================================ -->
<BaseLayout title={`${post.title} | Alex Yap Real Estate Advisor`}>
  <main class="w-full bg-[var(--color-luxury-stone,#ECE8E1)] min-h-screen overflow-x-hidden pt-28 md:pt-36">
    <section class="w-full py-12 md:py-20">
      <div class="max-w-[96rem] mx-auto px-6 lg:px-12">
        <div class="max-w-4xl mx-auto">
          
          <!-- Navigation Bar: Back to Blog Posts & Prev/Next Article -->
          <div class="flex items-center justify-between mb-10">
            <a 
              href="/blog" 
              class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[2px] text-neutral-500 hover:text-[#8C7149] transition-colors group"
            >
              <span class="font-bold text-sm leading-none transition-transform group-hover:-translate-x-1">&lt;</span>
              <span>Back to Blog Posts</span>
            </a>

            <div class="flex items-center gap-6">
              {prevPost ? (
                <a 
                  href={`/blog/${prevPost.slug}`} 
                  class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[2px] text-neutral-500 hover:text-[#8C7149] transition-colors group"
                  title={prevPost.title}
                >
                  <span class="font-bold text-sm leading-none transition-transform group-hover:-translate-x-1">&lt;</span>
                  <span>Prev</span>
                </a>
              ) : null}
              {nextPost ? (
                <a 
                  href={`/blog/${nextPost.slug}`} 
                  class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[2px] text-neutral-500 hover:text-[#8C7149] transition-colors group"
                  title={nextPost.title}
                >
                  <span>Next</span>
                  <span class="font-bold text-sm leading-none transition-transform group-hover:translate-x-1">&gt;</span>
                </a>
              ) : null}
            </div>
          </div>

          <!-- Article Header Info: Category, Date, Title, Excerpt -->
          <header class="mb-12">
            {(post.category || post.date) && (
              <div class="flex items-center gap-3 mb-4">
                {post.category && (
                  <span class="font-body text-[11px] uppercase tracking-[2px] text-[#8C7149] bg-white border border-black/10 px-3 py-1 font-medium shadow-sm">
                    {post.category}
                  </span>
                )}
                {post.date && (
                  <span class="text-neutral-500 text-xs font-mono tracking-wider">
                    {post.date}
                  </span>
                )}
              </div>
            )}

            <h1 class="font-heading text-2xl sm:text-3xl md:text-4xl uppercase tracking-[1px] text-[#1a1a1a] font-normal leading-[1.2] mb-6">
              {post.title}
            </h1>

            {post.excerpt && (
              <p class="font-body text-neutral-600 text-base sm:text-lg md:text-xl font-light leading-relaxed border-l-2 border-[#8C7149] pl-5 italic">
                {post.excerpt}
              </p>
            )}
          </header>

          <!-- Featured Cover Image Banner -->
          {post.image && (
            <div class="relative w-full aspect-[16/9] max-h-[500px] overflow-hidden mb-12 shadow-sm border border-black/10 bg-neutral-900">
              <img 
                src={post.image} 
                alt={post.title} 
                class="w-full h-full object-cover"
              />
            </div>
          )}

          <!-- Main Article Body Content Box -->
          {renderedContent && (
            <div class="bg-white border border-black/10 p-8 sm:p-12 md:p-16 shadow-[0_10px_30px_rgba(0,0,0,0.03)] mb-12">
              <article class="blog-content prose prose-neutral max-w-none text-[#2b2b2b]">
                <div set:html={renderedContent} />
              </article>
            </div>
          )}

          <!-- Bottom Pagination Controls for Previous & Next Articles -->
          <nav aria-label="Post navigation" class="flex items-center justify-between border-t border-black/10 pt-10 mt-16">
            {prevPost ? (
              <a 
                href={`/blog/${prevPost.slug}`} 
                aria-label={`Previous article: ${prevPost.title}`}
                class="inline-flex items-center gap-2.5 px-6 py-3.5 bg-white text-[#1a1a1a] border border-black/15 hover:bg-[#1a1a1a] hover:text-white transition-all font-mono text-xs uppercase tracking-[2px] shadow-sm group"
              >
                <span class="font-bold text-sm leading-none transition-transform group-hover:-translate-x-1">&lt;</span>
                <span>Prev Article</span>
              </a>
            ) : <div />}

            {nextPost ? (
              <a 
                href={`/blog/${nextPost.slug}`} 
                aria-label={`Next article: ${nextPost.title}`}
                class="inline-flex items-center gap-2.5 px-6 py-3.5 bg-white text-[#1a1a1a] border border-black/15 hover:bg-[#1a1a1a] hover:text-white transition-all font-mono text-xs uppercase tracking-[2px] shadow-sm group ml-auto"
              >
                <span>Next Article</span>
                <span class="font-bold text-sm leading-none transition-transform group-hover:translate-x-1">&gt;</span>
              </a>
            ) : <div />}
          </nav>

        </div>
      </div>
    </section>
  </main>

  <WorkWithAlexCTA />
</BaseLayout>

<style is:global>
  .blog-content a {
    color: #8C7149 !important;
    text-decoration: underline dotted #8C7149 !important;
    text-underline-offset: 6px !important;
    font-weight: 500 !important;
    transition: all 0.2s ease-in-out;
  }

  .blog-content a:hover {
    color: #1a1a1a !important;
    text-decoration-color: #1a1a1a !important;
  }
</style>