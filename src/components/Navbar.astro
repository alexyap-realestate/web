---
// src/components/Navbar.astro
---
<!-- Adaptive Header -->
<header id="site-header" class="fixed top-0 left-0 right-0 h-20 bg-transparent flex items-center justify-between px-[5vw] z-50 border-b border-transparent transition-transform duration-300 lg:translate-y-0">
  <a href="/" class="inline-flex flex-col items-center select-none group w-fit shrink-0 whitespace-nowrap pr-4" aria-label="Alex Yap Homepage">
    <span id="brand-name" class="font-heading text-[1.15rem] md:text-[1.25rem] tracking-[0.2em] -mr-[0.2em] uppercase font-normal text-white leading-tight text-center transition-colors duration-200 whitespace-nowrap">
      Alex Yap
    </span>
    <span id="brand-line" class="w-full h-[1px] bg-white mt-0.5 mb-1.5 opacity-80 transition-colors duration-200"></span>
    <span id="brand-sub" class="font-body text-[0.55rem] md:text-[0.625rem] tracking-[0.32em] -mr-[0.32em] uppercase text-neutral-300 font-light leading-none text-center transition-colors duration-200 whitespace-nowrap">
      Real Estate Advisor
    </span>
  </a>

  <!-- Desktop Navigation (lg: 1024px and above) -->
  <nav class="hidden lg:flex items-center gap-6 xl:gap-9 shrink-0" aria-label="Main Navigation">
    <a href="/properties" class="nav-link font-heading text-[13px] uppercase tracking-[1px] font-normal text-white hover:opacity-60 transition whitespace-nowrap">
      Properties
    </a>

    <a href="/communities" class="nav-link font-heading text-[13px] uppercase tracking-[1px] font-normal text-white hover:opacity-60 transition whitespace-nowrap">
      Communities
    </a>

    <!-- Advisory Dropdown -->
    <div class="relative group py-6">
      <button 
        type="button" 
        class="nav-link font-heading text-[13px] uppercase tracking-[1px] font-normal text-white hover:opacity-60 transition flex items-center gap-1.5 cursor-pointer whitespace-nowrap bg-transparent border-none p-0"
        aria-haspopup="true"
        aria-expanded="false"
      >
        Advisory
        <svg class="w-3 h-3 transition-transform duration-300 group-hover:rotate-180 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7"></path>
        </svg>
      </button>
      <div class="dropdown-menu absolute top-[80%] left-0 w-64 py-3 bg-[#161514] shadow-2xl border border-white/10 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-300 translate-y-2 group-hover:translate-y-0">
        <a href="/seller" class="dropdown-item block px-5 py-2.5 font-body text-[12px] uppercase tracking-[2px] font-light text-neutral-300 hover:text-white hover:bg-white/5 transition">Seller Advisory</a>
        <a href="/buyer" class="dropdown-item block px-5 py-2.5 font-body text-[12px] uppercase tracking-[2px] font-light text-neutral-300 hover:text-white hover:bg-white/5 transition">Buyer Advisory</a>
        <a href="/valuation" class="dropdown-item block px-5 py-2.5 font-body text-[12px] uppercase tracking-[2px] font-light text-neutral-300 hover:text-white hover:bg-white/5 transition">Home Valuation</a>
      </div>
    </div>

    <!-- About Dropdown -->
    <div class="relative group py-6">
      <button 
        type="button" 
        class="nav-link font-heading text-[13px] uppercase tracking-[1px] font-normal text-white hover:opacity-60 transition flex items-center gap-1.5 cursor-pointer whitespace-nowrap bg-transparent border-none p-0"
        aria-haspopup="true"
        aria-expanded="false"
      >
        About
        <svg class="w-3 h-3 transition-transform duration-300 group-hover:rotate-180 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7"></path>
        </svg>
      </button>
      <div class="dropdown-menu absolute top-[80%] left-0 w-64 py-3 bg-[#161514] shadow-2xl border border-white/10 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-300 translate-y-2 group-hover:translate-y-0">
        <a href="/about" class="dropdown-item block px-5 py-2.5 font-body text-[12px] uppercase tracking-[2px] font-light text-neutral-300 hover:text-white hover:bg-white/5 transition">About Alex</a>
        <a href="/testimonials" class="dropdown-item block px-5 py-2.5 font-body text-[12px] uppercase tracking-[2px] font-light text-neutral-300 hover:text-white hover:bg-white/5 transition">Testimonials</a>
      </div>
    </div>
    
    <!-- Contact Trigger -->
    <button 
      type="button" 
      id="nav-contact-btn" 
      data-open-contact-modal
      class="lp-btn font-heading text-[13px] tracking-[2px] uppercase font-normal border border-white text-white px-5 py-2.5 hover:bg-white hover:text-black transition cursor-pointer whitespace-nowrap"
    >
      Contact
    </button>
  </nav>

  <!-- Mobile & Tablet Hamburger Button -->
  <button 
    type="button" 
    id="mobile-menu-btn" 
    class="lg:hidden relative z-50 flex flex-col items-center justify-center w-12 h-12 p-3 -mr-2 space-y-1.5 focus:outline-none cursor-pointer shrink-0 touch-manipulation select-none" 
    aria-label="Toggle navigation menu" 
    aria-expanded="false" 
    aria-controls="mobile-menu"
  >
    <span class="bar pointer-events-none w-6 h-[2px] bg-white transition-all duration-300 block"></span>
    <span class="bar pointer-events-none w-6 h-[2px] bg-white transition-all duration-300 block"></span>
    <span class="bar pointer-events-none w-6 h-[2px] bg-white transition-all duration-300 block"></span>
  </button>
</header>

<!-- Mobile & Tablet Menu Overlay (Left-Aligned) -->
<div id="mobile-menu" class="fixed inset-0 bg-[#FBF8F4] z-40 hidden flex-col items-start justify-start overflow-y-auto text-left px-8 pt-28 pb-12 transition-all duration-300 lg:hidden" aria-hidden="true">
  <nav class="flex flex-col items-start gap-5 w-full max-w-md mx-auto" aria-label="Mobile Navigation">
    <a href="/properties" class="mobile-nav-link font-heading text-[20px] uppercase tracking-[1px] font-normal text-[#1a1a1a] hover:text-[#8C7149] transition py-2 border-b border-black/10 w-full text-left touch-manipulation">
      Properties
    </a>

    <a href="/communities" class="mobile-nav-link font-heading text-[20px] uppercase tracking-[1px] font-normal text-[#1a1a1a] hover:text-[#8C7149] transition py-2 border-b border-black/10 w-full text-left touch-manipulation">
      Communities
    </a>

    <!-- Advisory Accordion -->
    <div class="w-full flex flex-col items-start border-b border-black/10 pb-4">
      <button type="button" id="mobile-adv-toggle" class="w-full flex items-center justify-between font-heading text-[20px] uppercase tracking-[1px] font-normal text-[#1a1a1a] cursor-pointer text-left py-2 touch-manipulation">
        <span>Advisory</span>
        <svg id="adv-arrow" class="w-4 h-4 transition-transform duration-300 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7"></path>
        </svg>
      </button>
      <div id="mobile-advisory-sub" class="hidden flex-col items-start gap-3 pt-3 pl-4 w-full font-body text-xs uppercase tracking-wider text-[#555555] font-light">
        <a href="/seller" class="mobile-nav-link hover:text-black py-1 w-full text-left touch-manipulation">Seller Advisory</a>
        <a href="/buyer" class="mobile-nav-link hover:text-black py-1 w-full text-left touch-manipulation">Buyer Advisory</a>
        <a href="/valuation" class="mobile-nav-link hover:text-black py-1 w-full text-left touch-manipulation">Home Valuation</a>
      </div>
    </div>

    <!-- About Accordion -->
    <div class="w-full flex flex-col items-start border-b border-black/10 pb-4">
      <button type="button" id="mobile-about-toggle" class="w-full flex items-center justify-between font-heading text-[20px] uppercase tracking-[1px] font-normal text-[#1a1a1a] cursor-pointer text-left py-2 touch-manipulation">
        <span>About</span>
        <svg id="about-arrow" class="w-4 h-4 transition-transform duration-300 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7"></path>
        </svg>
      </button>
      <div id="mobile-about-sub" class="hidden flex-col items-start gap-3 pt-3 pl-4 w-full font-body text-xs uppercase tracking-wider text-[#555555] font-light">
        <a href="/about" class="mobile-nav-link hover:text-black py-1 w-full text-left touch-manipulation">About Alex</a>
        <a href="/testimonials" class="mobile-nav-link hover:text-black py-1 w-full text-left touch-manipulation">Testimonials</a>
      </div>
    </div>
    
    <!-- Mobile Contact Button -->
    <button 
      type="button" 
      id="mobile-contact-btn" 
      data-open-contact-modal
      class="mt-4 font-heading text-[14px] tracking-[2px] uppercase font-normal border border-black text-[#1a1a1a] px-8 py-3.5 hover:bg-black hover:text-white transition cursor-pointer w-full text-center touch-manipulation"
    >
      Contact
    </button>
  </nav>
</div>

<script>
  function setupNavbar() {
    const siteHeader = document.getElementById('site-header');
    const brandName = document.getElementById('brand-name');
    const brandLine = document.getElementById('brand-line');
    const brandSub = document.getElementById('brand-sub');
    const navLinks = document.querySelectorAll('.nav-link');
    const navContactBtn = document.getElementById('nav-contact-btn');
    const dropdownMenus = document.querySelectorAll('.dropdown-menu');
    const dropdownItems = document.querySelectorAll('.dropdown-item');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileBars = document.querySelectorAll('#mobile-menu-btn .bar');
    const mobileContactBtn = document.getElementById('mobile-contact-btn');
    
    if (!siteHeader || !mobileMenuBtn) return;

    // Prevent duplicate event listeners when navigating with ClientRouter
    if (siteHeader.dataset.initialized === 'true') {
      updateNavAppearance();
      return;
    }
    siteHeader.dataset.initialized = 'true';

    const path = window.location.pathname.replace(/\/$/, '');
    const isHomePage = path === '' || path === '/';

    function isCurtainActive() {
      const curtain = document.getElementById('curtain-container');
      return isHomePage && !!curtain;
    }

    function applyHeroTheme() {
      siteHeader?.classList.remove('bg-[#FBF8F4]', 'border-black/10', 'shadow-sm');
      siteHeader?.classList.add('bg-transparent', 'border-transparent');
      if (brandName) brandName.className = "font-heading text-[1.15rem] md:text-[1.25rem] tracking-[0.2em] -mr-[0.2em] uppercase font-normal text-white leading-tight text-center transition-colors duration-200 whitespace-nowrap";
      if (brandLine) brandLine.className = "w-full h-[1px] bg-white mt-0.5 mb-1.5 opacity-80 transition-colors duration-200";
      if (brandSub) brandSub.className = "font-body text-[0.55rem] md:text-[0.625rem] tracking-[0.32em] -mr-[0.32em] uppercase text-neutral-300 font-light leading-none text-center transition-colors duration-200 whitespace-nowrap";
      
      navLinks.forEach(link => {
        link.className = "nav-link font-heading text-[13px] uppercase tracking-[1px] font-normal text-white hover:opacity-60 transition flex items-center gap-1.5 cursor-pointer whitespace-nowrap bg-transparent border-none p-0";
      });

      if (navContactBtn) {
        navContactBtn.className = "lp-btn font-heading text-[13px] tracking-[2px] uppercase font-normal border border-white text-white px-5 py-2.5 hover:bg-white hover:text-black transition cursor-pointer whitespace-nowrap";
      }

      // If mobile menu is open, bars must be dark; otherwise pure white for hero visibility
      const menuIsOpen = !mobileMenu?.classList.contains('hidden');
      mobileBars.forEach(bar => {
        bar.classList.toggle('bg-white', !menuIsOpen);
        bar.classList.toggle('bg-[#1a1a1a]', menuIsOpen);
      });

      dropdownMenus.forEach(menu => {
        menu.className = "dropdown-menu absolute top-[80%] left-0 w-64 py-3 bg-[#161514] shadow-2xl border border-white/10 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-300 translate-y-2 group-hover:translate-y-0";
      });
      dropdownItems.forEach(item => {
        item.className = "dropdown-item block px-5 py-2.5 font-body text-[12px] uppercase tracking-[2px] font-light text-neutral-300 hover:text-white hover:bg-white/5 transition";
      });
    }

    function applyScrolledTheme() {
      siteHeader?.classList.remove('bg-transparent', 'border-transparent');
      siteHeader?.classList.add('bg-[#FBF8F4]', 'border-black/10', 'shadow-sm');
      if (brandName) brandName.className = "font-heading text-[1.15rem] md:text-[1.25rem] tracking-[0.2em] -mr-[0.2em] uppercase font-normal text-[#1a1a1a] leading-tight text-center transition-colors duration-200 whitespace-nowrap";
      if (brandLine) brandLine.className = "w-full h-[1px] bg-[#1a1a1a] mt-0.5 mb-1.5 opacity-80 transition-colors duration-200";
      if (brandSub) brandSub.className = "font-body text-[0.55rem] md:text-[0.625rem] tracking-[0.32em] -mr-[0.32em] uppercase text-[#555555] font-light leading-none text-center transition-colors duration-200 whitespace-nowrap";
      
      navLinks.forEach(link => {
        link.className = "nav-link font-heading text-[13px] uppercase tracking-[1px] font-normal text-[#1a1a1a] hover:text-[#555555] transition flex items-center gap-1.5 cursor-pointer whitespace-nowrap bg-transparent border-none p-0";
      });

      if (navContactBtn) {
        navContactBtn.className = "lp-btn font-heading text-[13px] tracking-[2px] uppercase font-normal border border-black text-[#1a1a1a] px-5 py-2.5 hover:bg-[#1a1a1a] hover:text-white transition cursor-pointer whitespace-nowrap";
      }

      mobileBars.forEach(bar => {
        bar.classList.remove('bg-white');
        bar.classList.add('bg-[#1a1a1a]');
      });

      dropdownMenus.forEach(menu => {
        menu.className = "dropdown-menu absolute top-[80%] left-0 w-64 py-3 bg-[#FBF8F4] shadow-2xl border border-black/10 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-300 translate-y-2 group-hover:translate-y-0";
      });
      dropdownItems.forEach(item => {
        item.className = "dropdown-item block px-5 py-2.5 font-body text-[12px] uppercase tracking-[2px] font-light text-[#4d4d4d] hover:text-black hover:bg-black/5 transition";
      });
    }

    let isScrolled = false;
    let ticking = false;
    let lastScrollY = window.pageYOffset || document.documentElement.scrollTop;

    function updateNavAppearance() {
      const currentScrollY = Math.max(0, window.pageYOffset || document.documentElement.scrollTop);
      const isMobileOrTablet = window.innerWidth < 1024;
      const curtain = document.getElementById('curtain-container');
      const hasHero = isHomePage;

      if (!hasHero) {
        applyScrolledTheme();
        isScrolled = true;
        return;
      }

      let shouldBeScrolled = false;
      if (curtain) {
        const curtainTop = curtain.getBoundingClientRect().top;
        shouldBeScrolled = (curtainTop <= 84);
      } else {
        shouldBeScrolled = currentScrollY > 40;
      }

      if (shouldBeScrolled) {
        if (!isScrolled) {
          applyScrolledTheme();
          isScrolled = true;
        }
      } else {
        if (isScrolled || currentScrollY <= 10) {
          applyHeroTheme();
          isScrolled = false;
        }
      }
    }

    function handleHeaderScroll() {
      const currentScrollY = Math.max(0, window.pageYOffset || document.documentElement.scrollTop);
      const isMobileOrTablet = window.innerWidth < 1024;

      // Mobile slide away on down-scroll, reveal on pull up
      if (isMobileOrTablet && mobileMenu?.classList.contains('hidden')) {
        const delta = currentScrollY - lastScrollY;
        if (delta < -3) {
          siteHeader?.classList.remove('-translate-y-full');
        } else if (delta > 3 && currentScrollY > 15) {
          siteHeader?.classList.add('-translate-y-full');
        }
      } else {
        siteHeader?.classList.remove('-translate-y-full');
      }

      lastScrollY = currentScrollY;
      if (mobileMenu && !mobileMenu.classList.contains('hidden')) return;

      updateNavAppearance();
    }

    function onScrollRequest() {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          handleHeaderScroll();
          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScrollRequest, { passive: true });
    window.addEventListener('resize', onScrollRequest, { passive: true });
    
    // Initial paint: force bright white bars on home page hero
    if (isHomePage) {
      applyHeroTheme();
    } else {
      applyScrolledTheme();
    }
    handleHeaderScroll();

    // Mobile Hamburger Button Toggle
    mobileMenuBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isHidden = mobileMenu?.classList.toggle('hidden');
      const isOpen = !isHidden;

      document.body.style.overflow = isOpen ? 'hidden' : '';
      mobileMenuBtn.setAttribute('aria-expanded', isOpen.toString());
      mobileMenu?.setAttribute('aria-hidden', (!isOpen).toString());

      if (isOpen) {
        siteHeader?.classList.remove('-translate-y-full');
        mobileBars.forEach(bar => {
          bar.classList.remove('bg-white');
          bar.classList.add('bg-[#1a1a1a]');
        });
      } else {
        // Returned to page view
        updateNavAppearance();
      }
    });

    // Accordions
    document.getElementById('mobile-adv-toggle')?.addEventListener('click', (e) => {
      e.preventDefault();
      const sub = document.getElementById('mobile-advisory-sub');
      const arrow = document.getElementById('adv-arrow');
      const hidden = sub?.classList.toggle('hidden');
      if (hidden) {
        sub?.classList.remove('flex');
        arrow?.classList.remove('rotate-180');
      } else {
        sub?.classList.add('flex');
        arrow?.classList.add('rotate-180');
      }
    });

    document.getElementById('mobile-about-toggle')?.addEventListener('click', (e) => {
      e.preventDefault();
      const sub = document.getElementById('mobile-about-sub');
      const arrow = document.getElementById('about-arrow');
      const hidden = sub?.classList.toggle('hidden');
      if (hidden) {
        sub?.classList.remove('flex');
        arrow?.classList.remove('rotate-180');
      } else {
        sub?.classList.add('flex');
        arrow?.classList.add('rotate-180');
      }
    });

    // Close on link tap
    document.querySelectorAll('#mobile-menu a').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu?.classList.add('hidden');
        document.body.style.overflow = '';
        updateNavAppearance();
      });
    });

    // Modal Trigger
    const triggerContact = () => {
      if (typeof (window as any).openContactModal === 'function') {
        (window as any).openContactModal();
      }
    };

    navContactBtn?.addEventListener('click', triggerContact);
    mobileContactBtn?.addEventListener('click', () => {
      if (!mobileMenu?.classList.contains('hidden')) {
        mobileMenu?.classList.add('hidden');
        document.body.style.overflow = '';
      }
      triggerContact();
    });
  }

  // Bind to page-load lifecycle
  document.addEventListener('astro:page-load', setupNavbar);
</script>