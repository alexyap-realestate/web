---
// ============================================================================
// COMPONENT: ClientWizardForm.astro (Synchronized Buyer & Seller Options)
// USAGE: Reusable 5-step interactive questionnaire with synchronized inline custom property inputs.
// PROPS: mode ('buyer' | 'seller')
// ============================================================================

interface Props {
  mode?: 'buyer' | 'seller';
}

const { mode = 'seller' } = Astro.props;

const isSeller = mode === 'seller';
const subjectLine = isSeller ? 'New Seller Valuation Wizard Submission' : 'New Buyer Advisory Wizard Submission';
---

<div class="bg-[#11100f] text-white border border-[#8C7149]/30 shadow-2xl select-none relative w-full max-w-5xl mx-auto overflow-hidden">
  <div class="grid grid-cols-1 lg:grid-cols-12 min-h-[500px]">
    
    <!-- LEFT PANEL: Context & Step Indicators -->
    <div class="lg:col-span-4 bg-[#181716] p-8 sm:p-10 border-b lg:border-b-0 lg:border-r border-[#8C7149]/20 flex flex-col justify-between">
      <div>
        <div class="inline-flex items-center gap-2 mb-4 bg-[#8C7149]/10 px-3 py-1 border border-[#8C7149]/30">
          <span class="w-1.5 h-1.5 rounded-full bg-[#8C7149]"></span>
          <span class="font-body text-[10px] uppercase tracking-[2.5px] text-[#d6be96] font-medium">
            {isSeller ? 'Seller Advisory' : 'Buyer Advisory'}
          </span>
        </div>
        <h3 class="font-heading text-xl sm:text-2xl uppercase tracking-wider text-white font-normal leading-snug mb-2">
          {isSeller ? 'Valuation & Strategy Wizard' : 'Property Search Roadmap'}
        </h3>
        <p class="font-body text-neutral-400 text-xs sm:text-sm font-light leading-relaxed">
          {isSeller 
            ? 'Provide your property parameters to receive a customized comparative market analysis from Alex Yap.'
            : 'Outline your purchasing criteria to establish a secure, personalized property acquisition strategy.'}
        </p>
      </div>

      <!-- Step Progress List (Fixed 5 Steps) -->
      <div class="space-y-3 my-6 hidden lg:block">
        <div class="wizard-indicator-item flex items-center gap-3 text-xs font-heading tracking-widest text-neutral-400 transition-colors" data-indicator-step="1">
          <span class="w-5 h-5 rounded-full border border-current flex items-center justify-center text-[10px] font-mono">1</span>
          <span class="uppercase">Timeline</span>
        </div>
        <div class="wizard-indicator-item flex items-center gap-3 text-xs font-heading tracking-widest text-neutral-400 transition-colors" data-indicator-step="2">
          <span class="w-5 h-5 rounded-full border border-current flex items-center justify-center text-[10px] font-mono">2</span>
          <span class="uppercase">{isSeller ? 'Property Type' : 'Property Style'}</span>
        </div>
        <div class="wizard-indicator-item flex items-center gap-3 text-xs font-heading tracking-widest text-neutral-400 transition-colors" data-indicator-step="3">
          <span class="w-5 h-5 rounded-full border border-current flex items-center justify-center text-[10px] font-mono">3</span>
          <span class="uppercase">{isSeller ? 'Condition' : 'Financing'}</span>
        </div>
        <div class="wizard-indicator-item flex items-center gap-3 text-xs font-heading tracking-widest text-neutral-400 transition-colors" data-indicator-step="4">
          <span class="w-5 h-5 rounded-full border border-current flex items-center justify-center text-[10px] font-mono">4</span>
          <span class="uppercase">{isSeller ? 'Target Price' : 'Target Budget'}</span>
        </div>
        <div class="wizard-indicator-item flex items-center gap-3 text-xs font-heading tracking-widest text-neutral-400 transition-colors" data-indicator-step="5">
          <span class="w-5 h-5 rounded-full border border-current flex items-center justify-center text-[10px] font-mono">5</span>
          <span class="uppercase">Contact Details</span>
        </div>
      </div>

      <!-- Mobile Step Counter -->
      <div class="lg:hidden flex items-center justify-between text-xs font-heading tracking-widest text-[#d6be96] uppercase">
        <span id="mobile-step-indicator">Step 1 of 5</span>
        <span id="mobile-step-title">Timeline</span>
      </div>
    </div>

    <!-- RIGHT PANEL: Form Inputs & Controls -->
    <div class="lg:col-span-8 p-8 sm:p-10 flex flex-col justify-between">
      <form id="universal-wizard-form" class="flex flex-col justify-between h-full" data-mode={mode}>
        <!-- Web3Forms Routing Configuration (Hidden Fields) -->
        <input type="hidden" name="access_key" value="6b57a488-ac7a-4fe7-b840-5d18ca3cdebc" />
        <input type="hidden" name="subject" value={subjectLine} />
        <input type="hidden" name="from_name" value={`Alex Yap Website (${isSeller ? 'Seller' : 'Buyer'} Wizard)`} />
        <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

        <!-- FLUID CONTAINER FOR 5 WIZARD STEPS -->
        <div class="min-h-[300px] sm:min-h-[330px] flex flex-col justify-center">
          
          <!-- STEP 1: Timeline -->
          <div class="wizard-step space-y-4" data-step="1">
            <h4 class="font-heading text-lg sm:text-xl uppercase tracking-wider font-normal text-white">
              {isSeller ? 'When are you thinking about selling?' : 'When are you hoping to purchase a property?'}
            </h4>
            <div>
              <label class="block font-body text-[11px] uppercase tracking-widest text-[#d6be96] mb-2">Select Target Timeframe *</label>
              <select 
                name="timeline" 
                class="w-full bg-black/60 border border-white/20 p-3.5 text-white font-body text-sm focus:outline-none focus:border-[#8C7149] transition-colors cursor-pointer"
                required
              >
                <option value="" disabled selected>-- Choose your timeframe --</option>
                <option value="Immediately (0 - 30 Days)">Immediately (0 - 30 Days)</option>
                <option value="1 to 3 Months">1 to 3 Months</option>
                <option value="3 to 6 Months">3 to 6 Months</option>
                <option value="6+ Months / Planning Ahead">6+ Months / Planning Ahead</option>
                <option value={isSeller ? 'Just Exploring Market Value' : 'Just Exploring Options'}>
                  {isSeller ? 'Just Exploring Market Value' : 'Just Exploring Options'}
                </option>
              </select>
            </div>
          </div>

          <!-- STEP 2: Property Type / Style (Synchronized with "Other" Option & Inline Input) -->
          <div class="wizard-step hidden space-y-4" data-step="2">
            <h4 class="font-heading text-lg sm:text-xl uppercase tracking-wider font-normal text-white">
              {isSeller ? 'What type of property are you representing?' : 'What type of property are you looking for?'}
            </h4>
            <div class="space-y-3">
              <div>
                <label class="block font-body text-[11px] uppercase tracking-widest text-[#d6be96] mb-2">Select Property Category *</label>
                <select 
                  id="property-type-select"
                  name="property_type" 
                  class="w-full bg-black/60 border border-white/20 p-3.5 text-white font-body text-sm focus:outline-none focus:border-[#8C7149] transition-colors cursor-pointer"
                  required
                >
                  <option value="" disabled selected>-- Choose property type --</option>
                  <option value="Single Family Resident">Single Family Resident</option>
                  <option value="Condo / Townhome">Condo / Townhome</option>
                  <option value="Investment / Multi-Family">Investment / Multi-Family</option>
                  <option value={isSeller ? 'Custom Land / Development' : 'Custom Architectural Build'}>
                    {isSeller ? 'Custom Land / Development' : 'Custom Architectural Build'}
                  </option>
                  <option value="Other">Other (Specify below)</option>
                </select>
              </div>

              <!-- Inline Pop-up Input Field (Shared by both Buyer and Seller modes) -->
              <div id="other-property-container" class="hidden transition-all duration-300">
                <label class="block font-body text-[10px] uppercase tracking-widest text-[#d6be96] mb-1">Please Specify Property Type *</label>
                <input 
                  type="text" 
                  id="other-property-input"
                  name="other_property_type" 
                  placeholder="e.g., Commercial Mixed-Use, Penthouse Loft, etc." 
                  class="w-full bg-black/60 border border-white/20 p-3 text-white placeholder-neutral-500 font-body text-xs focus:outline-none focus:border-[#8C7149] transition-colors"
                />
              </div>
            </div>
          </div>

          <!-- STEP 3: Condition / Financing -->
          <div class="wizard-step hidden space-y-4" data-step="3">
            <h4 class="font-heading text-lg sm:text-xl uppercase tracking-wider font-normal text-white">
              {isSeller ? "What is the current condition of your home?" : "What is your current financing status?"}
            </h4>
            <div>
              <label class="block font-body text-[11px] uppercase tracking-widest text-[#d6be96] mb-2">
                {isSeller ? 'Select Home Condition *' : 'Select Financial Readiness *'}
              </label>
              <select 
                name="status_condition" 
                class="w-full bg-black/60 border border-white/20 p-3.5 text-white font-body text-sm focus:outline-none focus:border-[#8C7149] transition-colors cursor-pointer"
                required
              >
                <option value="" disabled selected>-- Choose an option --</option>
                {isSeller ? (
                  <>
                    <option value="Turnkey / Fully Remodeled">Turnkey / Fully Remodeled (Pristine, premium upgrades)</option>
                    <option value="Minor Cosmetic Updates Needed">Minor Cosmetic Updates Needed (Paint, carpet, staging)</option>
                    <option value="Needs Major Renovation">Needs Major Renovation (Kitchen, baths, structural)</option>
                  </>
                ) : (
                  <>
                    <option value="Pre-Approved with Lender">Pre-Approved with Lender (Ready to offer)</option>
                    <option value="Cash Buyer">Cash Buyer (Liquid funds available)</option>
                    <option value="Planning to Get Prequalified Soon">Planning to Get Prequalified Soon</option>
                    <option value="Need Mortgage Advisory Support">Need Mortgage Advisory Support</option>
                  </>
                )}
              </select>
            </div>
          </div>

          <!-- STEP 4: Target Price / Budget -->
          <div class="wizard-step hidden space-y-4" data-step="4">
            <h4 class="font-heading text-lg sm:text-xl uppercase tracking-wider font-normal text-white">
              {isSeller ? 'What is your estimated target price?' : 'What is your target investment range?'}
            </h4>
            <div>
              <label class="block font-body text-[11px] uppercase tracking-widest text-[#d6be96] mb-2">
                {isSeller ? 'Estimated Value / Price *' : 'Target Budget / Price *'}
              </label>
              <input 
                type="text" 
                name="target_price" 
                placeholder={isSeller ? "e.g., $1,250,000 or Under $1M" : "e.g., $2,000,000 or Under $1.5M"} 
                class="w-full bg-black/60 border border-white/20 p-3.5 text-white placeholder-neutral-500 font-body text-sm focus:outline-none focus:border-[#8C7149] transition-colors"
                required
              />
            </div>
          </div>

          <!-- STEP 5: Contact Information & Location -->
          <div class="wizard-step hidden space-y-2.5" data-step="5">
            <h4 class="font-heading text-base uppercase tracking-wider font-normal text-white mb-1">
              Where should we send your custom brief?
            </h4>
            <div class="space-y-2">
              <div>
                <label class="block font-body text-[10px] uppercase tracking-widest text-[#d6be96] mb-1">
                  {isSeller ? 'Property Address *' : 'Target Neighborhood / Area *'}
                </label>
                <input 
                  type="text" 
                  name="location_or_address" 
                  placeholder={isSeller ? "e.g., 450 Luxury Way" : "e.g., Palo Alto Core"} 
                  class="w-full bg-black/60 border border-white/20 p-2.5 text-white placeholder-neutral-500 font-body text-xs focus:outline-none focus:border-[#8C7149] transition-colors"
                  required
                />
              </div>
              <div>
                <label class="block font-body text-[10px] uppercase tracking-widest text-[#d6be96] mb-1">Full Name *</label>
                <input 
                  type="text" 
                  name="name" 
                  placeholder="e.g., Jane Doe" 
                  class="w-full bg-black/60 border border-white/20 p-2.5 text-white placeholder-neutral-500 font-body text-xs focus:outline-none focus:border-[#8C7149] transition-colors"
                  required
                />
              </div>
              <div>
                <label class="block font-body text-[10px] uppercase tracking-widest text-[#d6be96] mb-1">Email Address *</label>
                <input 
                  type="email" 
                  name="email" 
                  placeholder="e.g., name@example.com" 
                  class="w-full bg-black/60 border border-white/20 p-2.5 text-white placeholder-neutral-500 font-body text-xs focus:outline-none focus:border-[#8C7149] transition-colors"
                  required
                />
              </div>
              <div>
                <label class="block font-body text-[10px] uppercase tracking-widest text-[#d6be96] mb-1">Phone Number</label>
                <input 
                  type="tel" 
                  name="phone" 
                  placeholder="e.g., (408) 000-0000" 
                  class="w-full bg-black/60 border border-white/20 p-2.5 text-white placeholder-neutral-500 font-body text-xs focus:outline-none focus:border-[#8C7149] transition-colors"
                />
              </div>
            </div>
          </div>

          <!-- SUCCESS STATE SCREEN -->
          <div id="universal-form-success" class="hidden text-center py-6 space-y-3">
            <div class="w-12 h-12 bg-[#8C7149]/20 border border-[#8C7149] rounded-full flex items-center justify-center mx-auto text-[#d6be96] text-lg">
              &#10003;
            </div>
            <h4 class="font-heading text-lg uppercase tracking-wider text-white">Advisory Brief Requested</h4>
            <p class="font-body text-neutral-300 max-w-md mx-auto text-xs">
              Thank you. Your parameters have been transmitted successfully. Alex Yap will curate your market report and contact you directly.
            </p>
          </div>

        </div>

        <!-- NAVIGATION BUTTONS -->
        <div id="universal-form-controls" class="flex items-center justify-between pt-4 mt-4 border-t border-white/10">
          <button 
            type="button" 
            id="universal-wizard-prev" 
            class="hidden px-5 py-2.5 bg-transparent border border-white/30 text-white font-heading text-[11px] uppercase tracking-widest hover:bg-white/10 transition-all cursor-pointer"
          >
            &larr; Back
          </button>
          <div class="ml-auto">
            <button 
              type="button" 
              id="universal-wizard-next" 
              class="px-7 py-2.5 bg-[#8C7149] hover:bg-[#a38456] text-white font-heading text-[11px] uppercase tracking-widest transition-all cursor-pointer shadow-lg"
            >
              Next Step &rarr;
            </button>
          </div>
        </div>
      </form>
    </div>

  </div>
</div>

<script>
  function setupUniversalWizard() {
    const form = document.getElementById('universal-wizard-form') as HTMLFormElement | null;
    if (!form || form.dataset.initialized === 'true') return;
    form.dataset.initialized = 'true';

    const mode = form.dataset.mode || 'seller';
    let currentStep = 1;
    const totalSteps = 5;

    const steps = Array.from(form.querySelectorAll('.wizard-step')) as HTMLElement[];
    const prevBtn = document.getElementById('universal-wizard-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('universal-wizard-next') as HTMLButtonElement | null;
    const mobileStepIndicator = document.getElementById('mobile-step-indicator');
    const formControls = document.getElementById('universal-form-controls');
    const formSuccess = document.getElementById('universal-form-success');
    const indicatorItems = document.querySelectorAll('.wizard-indicator-item');

    const propertyTypeSelect = document.getElementById('property-type-select') as HTMLSelectElement | null;
    const otherPropertyContainer = document.getElementById('other-property-container') as HTMLElement | null;
    const otherPropertyInput = document.getElementById('other-property-input') as HTMLInputElement | null;

    function updateView() {
      steps.forEach((step, index) => {
        if (index + 1 === currentStep) {
          step.classList.remove('hidden');
        } else {
          step.classList.add('hidden');
        }
      });

      // Update side panel indicators (Always 5 steps)
      indicatorItems.forEach((item, index) => {
        const stepNum = index + 1;
        const span = item.querySelector('span');
        if (stepNum === currentStep) {
          item.classList.remove('text-neutral-600', 'text-neutral-400');
          item.classList.add('text-white', 'font-medium');
          if (span) {
            span.classList.remove('border-current');
            span.classList.add('border-[#8C7149]', 'bg-[#8C7149]', 'text-white');
          }
        } else if (stepNum < currentStep) {
          item.classList.remove('text-white', 'font-medium', 'text-neutral-400');
          item.classList.add('text-[#d6be96]');
          if (span) {
            span.classList.remove('border-current', 'bg-[#8C7149]', 'text-white');
            span.classList.add('border-[#d6be96]', 'text-[#d6be96]');
            span.textContent = '\u2713';
          }
        } else {
          item.classList.remove('text-white', 'font-medium', 'text-[#d6be96]');
          item.classList.add('text-neutral-600');
          if (span) {
            span.classList.remove('border-[#8C7149]', 'bg-[#8C7149]', 'text-white', 'border-[#d6be96]');
            span.classList.add('border-current');
            span.textContent = String(stepNum);
          }
        }
      });

      if (mobileStepIndicator) mobileStepIndicator.textContent = `Step ${currentStep} of ${totalSteps}`;

      if (prevBtn) {
        if (currentStep === 1) {
          prevBtn.classList.add('hidden');
        } else {
          prevBtn.classList.remove('hidden');
        }
      }

      if (nextBtn) {
        if (currentStep === totalSteps) {
          nextBtn.textContent = mode === 'seller' ? 'Submit Valuation Request' : 'Submit Buyer Request';
        } else {
          nextBtn.textContent = 'Next Step \u2192';
        }
      }
    }

    function validateCurrentStep(): boolean {
      const activeStepEl = steps[currentStep - 1];
      
      const selectEl = activeStepEl.querySelector('select') as HTMLSelectElement | null;
      if (selectEl && !selectEl.value) {
        selectEl.reportValidity();
        return false;
      }

      // If on step 2 and "Other" is selected, validate that the custom input is filled
      if (currentStep === 2 && propertyTypeSelect?.value === 'Other' && otherPropertyInput) {
        if (!otherPropertyInput.value.trim()) {
          otherPropertyInput.reportValidity();
          return false;
        }
      }

      const inputs = Array.from(activeStepEl.querySelectorAll('input')) as HTMLInputElement[];
      for (const input of inputs) {
        if (input.required && !input.value) {
          input.reportValidity();
          return false;
        }
      }
      return true;
    }

    // Toggle inline "Other" input visibility based on dropdown selection
    propertyTypeSelect?.addEventListener('change', () => {
      if (propertyTypeSelect.value === 'Other') {
        otherPropertyContainer?.classList.remove('hidden');
        if (otherPropertyInput) otherPropertyInput.required = true;
      } else {
        otherPropertyContainer?.classList.add('hidden');
        if (otherPropertyInput) {
          otherPropertyInput.required = false;
          otherPropertyInput.value = '';
        }
      }
    });

    nextBtn?.addEventListener('click', async () => {
      if (!validateCurrentStep()) return;

      if (currentStep < totalSteps) {
        currentStep++;
        updateView();
      } else {
        if (!nextBtn) return;
        nextBtn.textContent = 'Submitting...';
        nextBtn.disabled = true;

        const formData = new FormData(form);
        const json = JSON.stringify(Object.fromEntries(formData));

        try {
          const response = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: json,
          });

          if (response.ok) {
            steps.forEach(s => s.classList.add('hidden'));
            if (formControls) formControls.classList.add('hidden');
            if (formSuccess) formSuccess.classList.remove('hidden');
          } else {
            alert('Submission error. Please try again.');
            nextBtn.textContent = mode === 'seller' ? 'Submit Valuation Request' : 'Submit Buyer Request';
            nextBtn.disabled = false;
          }
        } catch {
          alert('Network error. Please try again later.');
          nextBtn.textContent = mode === 'seller' ? 'Submit Valuation Request' : 'Submit Buyer Request';
          nextBtn.disabled = false;
        }
      }
    });

    prevBtn?.addEventListener('click', () => {
      if (currentStep > 1) {
        currentStep--;
        updateView();
      }
    });

    updateView();
  }

  document.addEventListener('astro:page-load', setupUniversalWizard);
</script>