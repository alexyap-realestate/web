---
// ============================================================================
// COMPONENT: ListingOfferWithCountdown.astro
// PURPOSE: Ultra-modern luxury countdown timer with a solid, flashing/glowing CTA button.
// ============================================================================
---

<div class="w-full max-w-2xl mx-auto flex flex-col gap-6">

  <!-- COUNTDOWN TIMER BANNER -->
  <div class="deadline-banner" role="region" aria-label="Offer Expiration Countdown">
    <div class="banner-header">
      <span class="badge-dot"></span>
      <span class="banner-eyebrow">Exclusive 1% Offer Expires In</span>
    </div>

    <div class="clock" id="clk" role="timer" aria-label="Time remaining until offer expires">
      <div class="cunit">
        <span class="digits" id="dD">00</span>
        <em>Days</em>
      </div>
      <span class="csep">:</span>
      <div class="cunit">
        <span class="digits" id="dH">00</span>
        <em>Hours</em>
      </div>
      <span class="csep">:</span>
      <div class="cunit">
        <span class="digits" id="dM">00</span>
        <em>Mins</em>
      </div>
      <span class="csep">:</span>
      <div class="cunit">
        <span class="digits" id="dS">00</span>
        <em>Secs</em>
      </div>
    </div>

    <div class="banner-footer">
      <span>December 31, 2026 &bull; Midnight PST</span>
    </div>
  </div>

  <!-- MAIN ULTRA-MODERN LUXURY FORM CARD -->
  <div class="relative bg-[#141312]/90 backdrop-blur-xl border border-[#d3bc97]/20 p-8 sm:p-14 rounded-3xl shadow-[0_30px_70px_rgba(0,0,0,0.6)] overflow-hidden text-left w-full">
    
    <!-- Subtle Top Warm Gold Accent Line -->
    <div class="absolute top-0 inset-x-0 h-[2px] bg-gradient-to-r from-transparent via-[#8C7149] to-transparent"></div>

    <!-- Promotional Header Badge -->
    <div class="flex justify-center mb-5">
      <span class="inline-flex items-center gap-2 bg-black/60 text-[#d3bc97] px-4 py-1.5 rounded-full font-mono text-[10px] uppercase tracking-[2px] shadow-inner border border-[#d3bc97]/30">
        <span class="w-1.5 h-1.5 rounded-full bg-[#F6C91D] animate-pulse"></span>
        Limited Time &bull; Expiring Dec 31, 2026
      </span>
    </div>

    <div class="text-center mb-8">
      <h3 class="font-heading text-2xl sm:text-4xl uppercase tracking-[1.5px] text-white font-normal mb-3 leading-tight">
        Claim Your 1% Listing Fee
      </h3>
      <p class="font-body text-neutral-400 text-xs sm:text-sm font-light leading-relaxed max-w-xl mx-auto">
        Secure full representation, professional staging advisory, and maximum market exposure at an exclusive <strong class="font-semibold text-white">1% listing commission</strong>.
      </p>
    </div>

    <!-- Lead Capture Form Connected to Web3Forms via AJAX -->
    <form 
      method="POST" 
      class="space-y-4"
      id="listing-offer-form"
    >
      <!-- Verified Web3Forms Configuration & Custom Sender Routing -->
      <input type="hidden" name="access_key" value="6b57a488-ac7a-4fe7-b840-5d18ca3cdebc" />
      <input type="hidden" name="subject" value="New 1% Listing Fee Campaign Submission" />
      <input type="hidden" name="from_name" value="Alex Yap 1% Listing Fee Campaign" />
      <input type="hidden" name="replyto" value="%email%" />
      <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

      <!-- Name Field -->
      <div class="space-y-1.5">
        <label for="fullName" class="block font-body text-[11px] uppercase tracking-[2px] text-neutral-300 font-medium">
          Full Name <span class="text-[#8C7149]">*</span>
        </label>
        <input 
          type="text" 
          id="fullName" 
          name="name" 
          required 
          placeholder="e.g., Robert Vance" 
          class="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-3.5 text-sm font-body text-white placeholder:text-neutral-500 focus:outline-none focus:ring-2 focus:ring-[#8C7149]/50 focus:border-[#8C7149] transition-all shadow-inner"
        />
      </div>

      <!-- Property Address Field -->
      <div class="space-y-1.5">
        <label for="propertyAddress" class="block font-body text-[11px] uppercase tracking-[2px] text-neutral-300 font-medium">
          Property Address <span class="text-[#8C7149]">*</span>
        </label>
        <input 
          type="text" 
          id="propertyAddress" 
          name="property_address" 
          required 
          placeholder="e.g., 1234 Hamilton Ave, San Jose, CA" 
          class="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-3.5 text-sm font-body text-white placeholder:text-neutral-500 focus:outline-none focus:ring-2 focus:ring-[#8C7149]/50 focus:border-[#8C7149] transition-all shadow-inner"
        />
      </div>

      <!-- Email & Phone Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="space-y-1.5">
          <label for="email" class="block font-body text-[11px] uppercase tracking-[2px] text-neutral-300 font-medium">
            Email Address <span class="text-[#8C7149]">*</span>
          </label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            required 
            placeholder="robert@example.com" 
            class="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-3.5 text-sm font-body text-white placeholder:text-neutral-500 focus:outline-none focus:ring-2 focus:ring-[#8C7149]/50 focus:border-[#8C7149] transition-all shadow-inner"
          />
        </div>

        <div class="space-y-1.5">
          <label for="phone" class="block font-body text-[11px] uppercase tracking-[2px] text-neutral-300 font-medium">
            Phone Number <span class="text-[#8C7149]">*</span>
          </label>
          <input 
            type="tel" 
            id="phone" 
            name="phone" 
            required 
            placeholder="408-555-0199" 
            class="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-3.5 text-sm font-body text-white placeholder:text-neutral-500 focus:outline-none focus:ring-2 focus:ring-[#8C7149]/50 focus:border-[#8C7149] transition-all shadow-inner"
          />
        </div>
      </div>

      <!-- Timeline Selector -->
      <div class="space-y-1.5">
        <label for="timeline" class="block font-body text-[11px] uppercase tracking-[2px] text-neutral-300 font-medium">
          When Are You Thinking of Selling? <span class="text-[#8C7149]">*</span>
        </label>
        <select 
          id="timeline" 
          name="selling_timeline" 
          required 
          class="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-3.5 text-sm font-body text-white focus:outline-none focus:ring-2 focus:ring-[#8C7149]/50 focus:border-[#8C7149] transition-all shadow-inner cursor-pointer"
        >
          <option value="" disabled selected class="bg-neutral-900 text-neutral-400">Select your timeframe</option>
          <option value="Immediately (Within 30 Days)" class="bg-neutral-900 text-white">Immediately (Within 30 Days)</option>
          <option value="1 to 3 Months" class="bg-neutral-900 text-white">1 to 3 Months</option>
          <option value="3 to 6 Months" class="bg-neutral-900 text-white">3 to 6 Months</option>
          <option value="Exploring Options / Just Curious" class="bg-neutral-900 text-white">Exploring Options / Just Curious</option>
        </select>
      </div>

      <!-- Submit CTA Button (Flashing/Pulsing Animation Style) -->
      <div class="pt-3">
        <button 
          type="submit" 
          id="submit-btn"
          class="w-full font-heading text-xs uppercase tracking-[2.5px] bg-[#C5A880] text-neutral-950 font-bold py-4 px-6 rounded-xl hover:bg-[#D4B993] transition-all duration-300 border border-[#E2C79E] cursor-pointer flex items-center justify-center gap-2.5 group active:scale-[0.99] pulse-glow-btn"
        >
          <span id="btn-text">Lock In 1% Listing Fee</span>
          <span id="btn-arrow" class="font-mono font-black text-sm text-neutral-950 group-hover:translate-x-1 transition-transform duration-300">&gt;</span>
        </button>
      </div>

      <!-- Success / Error Message Banner -->
      <div id="form-result" class="hidden text-center font-body text-xs mt-3 p-3 rounded-xl"></div>

      <p class="text-center font-body text-[10px] uppercase tracking-wider text-neutral-500 pt-2">
        Zero obligation. Your information remains strictly confidential.
      </p>
    </form>
  </div>

</div>

<!-- STYLING WITH PULSING/FLASHING BUTTON ANIMATION -->
<style>
  .deadline-banner {
    position: relative;
    z-index: 3;
    background: linear-gradient(145deg, #161B22 0%, #0D1117 100%);
    color: #FFFFFF;
    border: 1px solid rgba(88, 166, 255, 0.3);
    border-radius: 1.25rem;
    padding: 1.75rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    text-align: center;
    font-family: 'Cabin', 'Segoe UI', system-ui, sans-serif;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6), 0 0 25px rgba(13, 17, 23, 0.4);
    backdrop-filter: blur(12px);
    width: 100%;
  }

  .banner-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    background-color: #58A6FF;
    border-radius: 50%;
    box-shadow: 0 0 8px #58A6FF;
  }

  .banner-eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #58A6FF;
  }

  .clock {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .cunit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  .digits {
    display: grid;
    place-items: center;
    min-width: 52px;
    padding: 0.5rem 0.25rem;
    border-radius: 0.6rem;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(88, 166, 255, 0.2);
    color: #FFFFFF;
    font-size: 1.95rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.4);
  }

  .cunit em {
    font-style: normal;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }

  .csep {
    font-size: 1.25rem;
    font-weight: 700;
    color: #58A6FF;
    padding-bottom: 1rem;
  }

  .banner-footer {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    width: 100%;
    padding-top: 0.75rem;
  }

  /* FLASHING / PULSING GLOW ANIMATION FOR THE BUTTON */
  @keyframes pulseGlow {
    0% {
      box-shadow: 0 0 0 0 rgba(197, 168, 128, 0.7);
    }
    70% {
      box-shadow: 0 0 0 15px rgba(197, 168, 128, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(197, 168, 128, 0);
    }
  }

  .pulse-glow-btn {
    animation: pulseGlow 2.5s infinite;
  }

  @media (min-width: 640px) {
    .digits { min-width: 60px; font-size: 2.35rem; }
  }
</style>

<!-- SCRIPTS FOR COUNTDOWN AND FORM SUBMISSION -->
<script>
  // 1. Countdown Timer Script
  (function(){
    const target = Date.parse("2027-01-01T07:59:59Z"); // Dec 31, 2026 Midnight PST
    const units = {
      D: document.getElementById("dD"), 
      H: document.getElementById("dH"),
      M: document.getElementById("dM"), 
      S: document.getElementById("dS")
    };

    function tiles(host: HTMLElement | null, str: string) {
      if (!host) return;
      host.textContent = str;
    }

    function tickClock() {
      const ms = Math.max(0, target - Date.now());
      const d = Math.floor(ms / 86400000);
      const h = Math.floor(ms / 3600000) % 24;
      const m = Math.floor(ms / 60000) % 60;
      const s = Math.floor(ms / 1000) % 60;

      tiles(units.D, String(d));
      tiles(units.H, ("0" + h).slice(-2));
      tiles(units.M, ("0" + m).slice(-2));
      tiles(units.S, ("0" + s).slice(-2));
    }

    tickClock();
    setInterval(tickClock, 1000);
  })();

  // 2. Form Submission Script
  const form = document.getElementById('listing-offer-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const btnText = document.getElementById('btn-text');
  const btnArrow = document.getElementById('btn-arrow');
  const resultDiv = document.getElementById('form-result');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    if (submitBtn) submitBtn.disabled = true;
    if (btnText) btnText.textContent = 'Sending Request...';
    if (btnArrow) btnArrow.style.display = 'none';
    if (resultDiv) {
      resultDiv.className = 'hidden';
      resultDiv.textContent = '';
    }

    const formData = new FormData(form);
    const object = Object.fromEntries(formData);
    const json = JSON.stringify(object);

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: json
      });

      const jsonResponse = await response.json();

      if (response.status === 200) {
        if (resultDiv) {
          resultDiv.className = 'block bg-emerald-950/80 text-emerald-300 border border-emerald-500/30 p-3 rounded-xl font-medium';
          resultDiv.textContent = 'Thank you! Your request has been successfully submitted. Alex will contact you shortly.';
        }
        form.reset();
      } else {
        if (resultDiv) {
          resultDiv.className = 'block bg-rose-950/80 text-rose-300 border border-rose-500/30 p-3 rounded-xl font-medium';
          resultDiv.textContent = jsonResponse.message || 'Something went wrong. Please try again.';
        }
      }
    } catch (error) {
      if (resultDiv) {
        resultDiv.className = 'block bg-rose-950/80 text-rose-300 border border-rose-500/30 p-3 rounded-xl font-medium';
        resultDiv.textContent = 'Network error. Please check your connection and try again.';
      }
    } finally {
      if (submitBtn) submitBtn.disabled = false;
      if (btnText) btnText.textContent = 'Lock In 1% Listing Fee';
      if (btnArrow) btnArrow.style.display = 'inline';
    }
  });
</script>