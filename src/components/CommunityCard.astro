---
// src/components/CommunityCard.astro

interface Props {
  name: string;
  city: string;
  tagline?: string;
  description?: string;
  image?: string;
  heroImage?: string;
  slug: string;
  featured?: string;
}

const { name, city, tagline, image, heroImage, slug } = Astro.props;
const displayImage = heroImage || image || 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=800&q=80';
---

<a 
  href={`/communities/${slug}`}
  class="group relative block w-full h-[450px] sm:h-[520px] overflow-hidden bg-black border border-black/10 shadow-[0_4px_20px_rgba(0,0,0,0.02)] hover:shadow-[0_10px_30px_rgba(0,0,0,0.08)] transition-all duration-500"
>
  <!-- Background Image -->
  <img 
    src={displayImage} 
    alt={name} 
    class="absolute inset-0 w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
    loading="lazy"
  />

  <!-- Gradient Overlay (Darker at bottom for text legibility) -->
  <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-black/20 opacity-90 group-hover:opacity-95 transition-opacity"></div>

  <!-- City Badge (Top Left - background changed to #8C7149) -->
  <div class="absolute top-4 left-4 z-10 flex items-center bg-[#8C7149] backdrop-blur-md px-3 py-1 border border-white/20 shadow-sm">
    <span class="text-[9px] font-heading uppercase tracking-[2px] text-white">
      {city}
    </span>
  </div>

  <!-- Content Overlay Positioned at the Bottom over the Photo -->
  <div class="absolute inset-x-0 bottom-0 z-10 p-6 sm:p-8 flex flex-col justify-end text-white">
    <div>
      <h3 class="font-heading text-xl sm:text-2xl uppercase tracking-[1px] text-white group-hover:text-[#8C7149] transition-colors mb-2 font-normal leading-tight">
        {name}
      </h3>
      {tagline && (
        <p class="font-body text-xs sm:text-sm text-neutral-300 uppercase tracking-[1.5px] font-light line-clamp-2">
          {tagline}
        </p>
      )}
    </div>

    <div class="mt-4 pt-4 border-t border-white/20 flex items-center justify-between text-[#8C7149]">
      <span class="font-heading text-xs uppercase tracking-[2px] font-medium text-neutral-200 group-hover:text-white transition-colors">Explore Profile</span>
      <span class="font-mono font-bold text-base text-[#8C7149] group-hover:translate-x-1 transition-transform">&rarr;</span>
    </div>
  </div>
</a>