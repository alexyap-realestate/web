---
// ============================================================================
// COMPONENT: ListingOfferForm.astro
// USAGE: Clean, modern inline lead capture form connected to Web3Forms with AJAX.
// ============================================================================
---

<div class="relative bg-white/95 backdrop-blur-md border border-white/20 p-8 sm:p-12 rounded-2xl shadow-[0_25px_60px_-15px_rgba(0,0,0,0.3)] max-w-xl mx-auto overflow-hidden text-left">
  
  {/* Decorative Top Gold Accent Line */}
  <div class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-transparent via-[#8C7149] to-transparent"></div>

  {/* Promotional Header Badge */}
  <div class="flex justify-center mb-4">
    <span class="inline-flex items-center gap-2 bg-[#1a1a1a] text-[#d3bc97] px-4 py-1.5 rounded-full font-mono text-[10px] uppercase tracking-[2px] shadow-sm border border-[#d3bc97]/30">
      <span class="w-1.5 h-1.5 rounded-full bg-[#d3bc97] animate-pulse"></span>
      Limited Time &bull; Expiring Dec 31, 2026
    </span>
  </div>

  <div class="text-center mb-8">
    <h3 class="font-heading text-2xl sm:text-4xl uppercase tracking-[1.5px] text-[#1a1a1a] font-normal mb-3 leading-tight">
      Claim Your 1% Listing Fee
    </h3>
    <p class="font-body text-neutral-600 text-xs sm:text-sm font-light leading-relaxed max-w-md mx-auto">
      Secure full representation, professional staging advisory, and maximum market exposure at an exclusive <strong class="font-semibold text-[#1a1a1a]">1% listing commission</strong>.
    </p>
  </div>

  {/* Lead Capture Form Connected to Web3Forms via AJAX */}
  <form 
    method="POST" 
    class="space-y-4"
    id="listing-offer-form"
  >
    {/* Verified Web3Forms Configuration & Custom Sender Routing */}
    <input type="hidden" name="access_key" value="6b57a488-ac7a-4fe7-b840-5d18ca3cdebc" />
    <input type="hidden" name="subject" value="New 1% Listing Fee Campaign Submission" />
    <input type="hidden" name="from_name" value="Alex Yap 1% Listing Fee Campaign" />
    <input type="hidden" name="replyto" value="%email%" />
    <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

    {/* Name Field */}
    <div class="space-y-1.5">
      <label for="fullName" class="block font-body text-[11px] uppercase tracking-[2px] text-neutral-700 font-medium">
        Full Name <span class="text-[#8C7149]">*</span>
      </label>
      <input 
        type="text" 
        id="fullName" 
        name="name" 
        required 
        placeholder="e.g., Robert Vance" 
        class="w-full bg-[#F9F8F6] border border-black/10 rounded-lg px-4 py-3.5 text-sm font-body text-[#1a1a1a] placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-[#8C7149]/50 focus:border-[#8C7149] transition-all shadow-sm"
      />
    </div>

    {/* Property Address Field */}
    <div class="space-y-1.5">
      <label for="propertyAddress" class="block font-body text-[11px] uppercase tracking-[2px] text-neutral-700 font-medium">
        Property Address <span class="text-[#8C7149]">*</span>
      </label>
      <input 
        type="text" 
        id="propertyAddress" 
        name="property_address" 
        required 
        placeholder="e.g., 1234 Hamilton Ave, San Jose, CA" 
        class="w-full bg-[#F9F8F6] border border-black/10 rounded-lg px-4 py-3.5 text-sm font-body text-[#1a1a1a] placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-[#8C7149]/50 focus:border-[#8C7149] transition-all shadow-sm"
      />
    </div>

    {/* Email & Phone Grid */}
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="space-y-1.5">
        <label for="email" class="block font-body text-[11px] uppercase tracking-[2px] text-neutral-700 font-medium">
          Email Address <span class="text-[#8C7149]">*</span>
        </label>
        <input 
          type="email" 
          id="email" 
          name="email" 
          required 
          placeholder="robert@example.com" 
          class="w-full bg-[#F9F8F6] border border-black/10 rounded-lg px-4 py-3.5 text-sm font-body text-[#1a1a1a] placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-[#8C7149]/50 focus:border-[#8C7149] transition-all shadow-sm"
        />
      </div>

      <div class="space-y-1.5">
        <label for="phone" class="block font-body text-[11px] uppercase tracking-[2px] text-neutral-700 font-medium">
          Phone Number <span class="text-[#8C7149]">*</span>
        </label>
        <input 
          type="tel" 
          id="phone" 
          name="phone" 
          required 
          placeholder="408-555-0199" 
          class="w-full bg-[#F9F8F6] border border-black/10 rounded-lg px-4 py-3.5 text-sm font-body text-[#1a1a1a] placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-[#8C7149]/50 focus:border-[#8C7149] transition-all shadow-sm"
        />
      </div>
    </div>

    {/* Timeline Selector */}
    <div class="space-y-1.5">
      <label for="timeline" class="block font-body text-[11px] uppercase tracking-[2px] text-neutral-700 font-medium">
        When Are You Thinking of Selling? <span class="text-[#8C7149]">*</span>
      </label>
      <select 
        id="timeline" 
        name="selling_timeline" 
        required 
        class="w-full bg-[#F9F8F6] border border-black/10 rounded-lg px-4 py-3.5 text-sm font-body text-[#1a1a1a] focus:outline-none focus:ring-2 focus:ring-[#8C7149]/50 focus:border-[#8C7149] transition-all shadow-sm cursor-pointer"
      >
        <option value="" disabled selected>Select your timeframe</option>
        <option value="Immediately (Within 30 Days)">Immediately (Within 30 Days)</option>
        <option value="1 to 3 Months">1 to 3 Months</option>
        <option value="3 to 6 Months">3 to 6 Months</option>
        <option value="Exploring Options / Just Curious">Exploring Options / Just Curious</option>
      </select>
    </div>

    {/* Submit CTA Button */}
    <div class="pt-3">
      <button 
        type="submit" 
        id="submit-btn"
        class="w-full font-heading text-xs uppercase tracking-[2.5px] bg-[#1a1a1a] text-white py-4 px-6 rounded-lg hover:bg-[#8C7149] transition-all duration-300 shadow-xl hover:shadow-[0_10px_25px_rgba(140,113,73,0.4)] cursor-pointer flex items-center justify-center gap-2.5 group active:scale-[0.99]"
      >
        <span id="btn-text">Lock In 1% Listing Fee</span>
        <span id="btn-arrow" class="font-mono font-bold text-sm text-[#d3bc97] group-hover:text-white group-hover:translate-x-1 transition-transform duration-300">&gt;</span>
      </button>
    </div>

    {/* Success / Error Message Banner */}
    <div id="form-result" class="hidden text-center font-body text-xs mt-3 p-3 rounded-lg"></div>

    <p class="text-center font-body text-[10px] uppercase tracking-wider text-neutral-400 pt-2">
      Zero obligation. Your information remains strictly confidential.
    </p>
  </form>
</div>

<script>
  const form = document.getElementById('listing-offer-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const btnText = document.getElementById('btn-text');
  const btnArrow = document.getElementById('btn-arrow');
  const resultDiv = document.getElementById('form-result');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    if (submitBtn) submitBtn.disabled = true;
    if (btnText) btnText.textContent = 'Sending Request...';
    if (btnArrow) btnArrow.style.display = 'none';
    if (resultDiv) {
      resultDiv.className = 'hidden';
      resultDiv.textContent = '';
    }

    const formData = new FormData(form);
    const object = Object.fromEntries(formData);
    const json = JSON.stringify(object);

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: json
      });

      const jsonResponse = await response.json();

      if (response.status === 200) {
        if (resultDiv) {
          resultDiv.className = 'block bg-emerald-50 text-emerald-800 border border-emerald-200 p-3 rounded-lg font-medium';
          resultDiv.textContent = 'Thank you! Your request has been successfully submitted. Alex will contact you shortly.';
        }
        form.reset();
      } else {
        if (resultDiv) {
          resultDiv.className = 'block bg-rose-50 text-rose-800 border border-rose-200 p-3 rounded-lg font-medium';
          resultDiv.textContent = jsonResponse.message || 'Something went wrong. Please try again.';
        }
      }
    } catch (error) {
      if (resultDiv) {
        resultDiv.className = 'block bg-rose-50 text-rose-800 border border-rose-200 p-3 rounded-lg font-medium';
        resultDiv.textContent = 'Network error. Please check your connection and try again.';
      }
    } finally {
      if (submitBtn) submitBtn.disabled = false;
      if (btnText) btnText.textContent = 'Lock In 1% Listing Fee';
      if (btnArrow) btnArrow.style.display = 'inline';
    }
  });
</script>