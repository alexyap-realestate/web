---
// src/components/WorkWithAlexCTA.astro
interface Props {
  eyebrow?: string;
  headline?: string;
  body?: string;
  buttonText?: string;
  backgroundImage?: string;
}

const {
  eyebrow = "Confidential Consultation",
  headline = "Let’s Discuss Your Next Move",
  body = "Whether you are looking for a confidential valuation on your current home, preparing for an upcoming sale, or searching for your next property in the South Bay, Alex provides direct, one-on-one guidance with zero obligation.",
  buttonText = "Get in Touch",
  backgroundImage = "https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1920&q=80"
} = Astro.props;
---

<section class="relative min-h-[560px] md:min-h-[660px] flex items-center justify-center px-6 py-20 md:py-32 overflow-hidden [clip-path:inset(0)]">
  <div 
    class="fixed inset-0 w-full h-full bg-cover bg-center bg-no-repeat pointer-events-none -z-10"
    style={`background-image: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url('${backgroundImage}');`}
  ></div>
  
  <div class="relative z-10 max-w-2xl w-full p-8 sm:p-12 md:p-16 text-center shadow-[0_30px_70px_rgba(0,0,0,0.22)] bg-[#eeede9]/60 backdrop-blur-md border border-white/50">
    <p class="font-body text-[12px] sm:text-[13px] uppercase tracking-[2.5px] italic mb-3 font-semibold text-[#8C7149]">
      {eyebrow}
    </p>
    <h2 class="font-heading text-[26px] sm:text-[32px] md:text-[40px] uppercase tracking-[1px] font-normal text-[#1a1a1a] mb-6 leading-tight">
      {headline}
    </h2>
    <p class="font-body text-[14px] sm:text-[15px] md:text-[16px] leading-[1.85] md:leading-[2] mb-10 max-w-lg mx-auto font-light text-[#404040]">
      {body}
    </p>
    <div class="flex justify-center">
      <button 
        type="button" 
        onclick="window.openContactModal && window.openContactModal()" 
        class="w-full sm:w-auto font-heading text-[13px] sm:text-[14px] uppercase tracking-[2px] inline-flex items-center justify-center bg-[#1a1a1a] text-white px-8 sm:px-10 py-4 hover:bg-[#333333] transition-all duration-300 cursor-pointer shadow-sm whitespace-nowrap shrink-0"
      >
        <span>{buttonText}</span>
      </button>
    </div>
  </div>
</section>