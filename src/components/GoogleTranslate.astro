---
// ============================================================================
// COMPONENT: src/components/GoogleTranslate.astro
// PURPOSE: Bulletproof Google Translate wrapper with Cookie Shield to prevent 
//          F5 refreshes and double-click link resets from reverting to English.
// ============================================================================
---

<!-- Desktop Language Trigger & Target Container -->
<div class="relative group inline-block z-50">
  <button 
    type="button"
    class="nav-link font-heading text-[13px] uppercase tracking-[1px] font-normal hover:opacity-60 transition flex items-center gap-1.5 cursor-pointer whitespace-nowrap bg-transparent border-none p-0 py-2"
    aria-label="Select Language"
  >
    <svg class="w-4 h-4 text-[#8C7149]" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.25m-0.001-4.5h-.001" />
    </svg>
    <span>Language</span>
    <svg class="w-3 h-3 transition-transform duration-300 group-hover:rotate-180 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7"></path>
    </svg>
  </button>

  <!-- Dropdown Menu -->
  <div class="dropdown-menu absolute right-0 lg:left-0 top-[80%] w-56 py-3 bg-[#161514] shadow-2xl border border-white/10 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-300 translate-y-2 group-hover:translate-y-0 rounded-sm">
    <button type="button" onclick="setLanguage('en')" class="dropdown-item w-full text-left block px-5 py-2.5 font-body text-[12px] uppercase tracking-[2px] font-light text-neutral-300 hover:text-white hover:bg-white/5 transition cursor-pointer bg-transparent border-none">English</button>
    <button type="button" onclick="setLanguage('zh-TW')" class="dropdown-item w-full text-left block px-5 py-2.5 font-body text-[12px] uppercase tracking-[2px] font-light text-neutral-300 hover:text-white hover:bg-white/5 transition cursor-pointer bg-transparent border-none">繁體中文</button>
    <button type="button" onclick="setLanguage('zh-CN')" class="dropdown-item w-full text-left block px-5 py-2.5 font-body text-[12px] uppercase tracking-[2px] font-light text-neutral-300 hover:text-white hover:bg-white/5 transition cursor-pointer bg-transparent border-none">简体中文</button>
    <button type="button" onclick="setLanguage('es')" class="dropdown-item w-full text-left block px-5 py-2.5 font-body text-[12px] uppercase tracking-[2px] font-light text-neutral-300 hover:text-white hover:bg-white/5 transition cursor-pointer bg-transparent border-none">Español</button>
    <button type="button" onclick="setLanguage('ja')" class="dropdown-item w-full text-left block px-5 py-2.5 font-body text-[12px] uppercase tracking-[2px] font-light text-neutral-300 hover:text-white hover:bg-white/5 transition cursor-pointer bg-transparent border-none">日本語</button>
  </div>
</div>

<!-- Hidden Google Translate Mount Point -->
<div id="google_translate_element" style="display: none;"></div>

<style is:global>
  body, html { top: 0px !important; position: static !important; }
  .goog-te-banner-frame, .goog-tooltip, #goog-gt-tt, .goog-te-balloon-frame, .skiptranslate, body > .skiptranslate { display: none !important; }
  .goog-text-highlight { background-color: transparent !important; box-shadow: none !important; }
</style>

<script is:inline>
  const DEFAULT_LANGUAGES = 'en,es,zh-CN,zh-TW,ja';

  // 1. COOKIE SHIELD: Runs immediately on script parse to protect state from F5 races
  (function protectTranslationCookie() {
    const savedLang = localStorage.getItem('preferred_lang');
    if (savedLang && savedLang !== 'en') {
      const cookieVal = `/en/${savedLang}`;
      if (!document.cookie.includes(`googtrans=${cookieVal}`)) {
        document.cookie = `googtrans=${cookieVal}; path=/; domain=` + document.domain;
        document.cookie = `googtrans=${cookieVal}; path=/`;
      }
    }
  })();

  function googleTranslateElementInit() {
    const el = document.getElementById('google_translate_element');
    if (el && !el.hasChildNodes()) {
      new google.translate.TranslateElement({
        pageLanguage: 'en',
        layout: google.translate.TranslateElement.InlineLayout.SIMPLE,
        includedLanguages: DEFAULT_LANGUAGES,
        autoDisplay: false
      }, 'google_translate_element');
    }
  }

  function setLanguage(langCode) {
    if (langCode === 'en') {
      localStorage.removeItem('preferred_lang');
      document.cookie = 'googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
      document.cookie = 'googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=' + document.domain;
      window.location.reload();
      return;
    }
    
    // Save preference to localStorage as a permanent backup shield
    localStorage.setItem('preferred_lang', langCode);
    
    document.cookie = `googtrans=/en/${langCode}; path=/; domain=` + document.domain;
    document.cookie = `googtrans=/en/${langCode}; path=/`;
    window.location.reload();
  }

  // 2. Sync Watchdog: Forces Google combo box to match state on F5 or route changes
  function syncTranslationState() {
    const savedLang = localStorage.getItem('preferred_lang');
    if (savedLang) {
      const checkDropdown = setInterval(() => {
        const selectField = document.querySelector('.goog-te-combo');
        if (selectField) {
          if (selectField.value !== savedLang) {
            selectField.value = savedLang;
            selectField.dispatchEvent(new Event('change'));
          }
          clearInterval(checkDropdown);
        }
      }, 100);
    }
  }

  document.addEventListener('DOMContentLoaded', syncTranslationState);
  document.addEventListener('astro:page-load', syncTranslationState);
</script>

<script defer src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>