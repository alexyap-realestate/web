---
// ============================================================================
// COMPONENT: src/components/TestimonialsCarousel.astro
// PURPOSE: Reusable Testimonials Carousel Component supporting two styles:
//          1. 'dots' (used on Index & About pages with bottom arrows & dots)
//          2. 'numbers' (used on Testimonials page with number pagination bar)
// ============================================================================

interface Props {
  reviews: any[];
  variant?: 'dots' | 'numbers';
  showEndCap?: boolean;
}

const { reviews, variant = 'dots', showEndCap = false } = Astro.props;
---

<div class="relative w-full max-w-5xl mx-auto py-4 testimonials-carousel-wrapper" data-variant={variant}>
  
  <!-- CAROUSEL STAGE (Side arrows removed entirely so text is never blocked) -->
  <div 
    id="testimonial-stage" 
    class={`relative w-full flex items-center justify-center px-2 sm:px-4 ${
      variant === 'dots' 
        ? 'h-[62vh] min-h-[480px] max-h-[640px]' 
        : 'min-h-[500px] sm:min-h-[540px] md:h-[62vh] md:min-h-[480px] md:max-h-[640px]'
    }`} 
    tabindex="0" 
    role="region" 
    aria-label="Client Testimonials Carousel"
  >
    {reviews.map((item, index) => (
      <article 
        class="testimonial-slide absolute top-0 w-[94%] sm:w-[78%] md:w-[68%] lg:w-[60%] h-full p-6 sm:p-8 md:p-10 flex flex-col justify-between select-none border transition-all duration-500 overflow-hidden shadow-sm bg-white" 
        data-index={index} 
        aria-roledescription="slide"
      >
        <div class="card-inner-frame absolute inset-3 pointer-events-none transition-opacity duration-500"></div>
        
        <div class="card-header shrink-0 flex items-center justify-between pb-3 mb-2 border-b transition-colors duration-300">
          <span class="card-tag font-body text-[10px] sm:text-[11px] uppercase tracking-[1.5px] sm:tracking-[2px] font-medium leading-none">
            {item.role || 'Client'} &bull; {item.community || 'Silicon Valley'}
          </span>
          <span class="card-stars text-xs sm:text-sm tracking-wider leading-none" aria-label="5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        </div>
        
        <div class="card-body-wrapper relative flex-1 min-h-0 flex flex-col">
          <div class="card-body-scroll relative z-10 flex-1 min-h-0 py-2 pr-2">
            <h3 class="card-headline font-heading uppercase tracking-[1px] mb-3 font-normal leading-snug">"{item.headline}"</h3>
            <p class="card-quote font-body font-light italic">"{item.quote}"</p>
          </div>
          <div class="scroll-prompt shrink-0 text-center py-1 font-body text-[10px] uppercase tracking-[2px] text-[#8C7149] opacity-80 pointer-events-none select-none">
            Scroll for more &darr;
          </div>
        </div>
        
        <div class="card-footer shrink-0 relative z-10 pt-4 mt-2 border-t flex items-center justify-between transition-colors duration-300">
          <div>
            <p class="card-client font-heading text-xs sm:text-sm md:text-base uppercase tracking-[1px] font-medium leading-tight">{item.client}</p>
            <div class="flex items-center gap-2 mt-1">
              <span class="card-verified font-body text-[9px] sm:text-[10px] uppercase tracking-[1.5px] font-light leading-none">Verified Review</span>
            </div>
          </div>
          <svg class="card-quote-icon w-4 h-4 sm:w-5 sm:h-5 transition-colors duration-300 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
          </svg>
        </div>
      </article>
    ))}

    {showEndCap && (
      <article 
        class="testimonial-slide testimonial-endcap absolute top-0 w-[94%] sm:w-[78%] md:w-[68%] lg:w-[60%] h-full p-6 sm:p-8 md:p-10 flex flex-col justify-between shadow-2xl select-none border transition-all duration-500 overflow-hidden" 
        data-index={reviews.length}
        aria-roledescription="slide"
      >
        <div class="card-body-wrapper relative flex-1 min-h-0 flex flex-col">
          <div class="card-body-scroll relative z-10 flex-1 min-h-0 py-2 pr-2">
            <span class="font-body text-[10px] sm:text-[11px] uppercase tracking-[2.5px] text-[#8C7149] font-medium block mb-3">
              Guidance You Can Rely On &bull; 20+ Years
            </span>
            <h3 class="card-headline font-heading text-xl sm:text-2xl md:text-3xl uppercase tracking-[1px] font-normal leading-snug mb-4 text-[#1a1a1a]">
              See What It's Like Working With Alex
            </h3>
            <p class="card-quote font-body text-neutral-600 text-sm sm:text-base font-light leading-relaxed">
              Browse reviews from buyers, sellers, and industry colleagues across all markets.
            </p>
          </div>
          <div class="scroll-prompt shrink-0 text-center py-1 font-body text-[10px] uppercase tracking-[2px] text-[#8C7149] opacity-80 pointer-events-none select-none">
            Scroll for more &darr;
          </div>
        </div>

        <div class="shrink-0 space-y-3 pt-4 border-t border-black/10">
          <a 
            href="/testimonials" 
            class="block w-full text-center font-heading text-[11px] sm:text-xs uppercase tracking-[2px] bg-[#1a1a1a] text-white py-3 sm:py-3.5 hover:bg-[#8C7149] hover:text-white transition duration-300 font-medium shadow-sm cursor-pointer"
          >
            View All Reviews &rarr;
          </a>
        </div>
      </article>
    )}
  </div>

  <!-- BOTTOM CONTROLS BASED ON VARIANT -->
  {variant === 'dots' ? (
    <div class="flex items-center justify-center gap-4 mt-8 select-none">
      <button 
        type="button" 
        id="testimonial-prev" 
        aria-label="Previous testimonial"
        class="w-10 h-10 bg-white text-[#1a1a1a] border border-black/15 shadow-sm hover:bg-[#1a1a1a] hover:text-white hover:border-[#1a1a1a] transition-all duration-300 flex items-center justify-center cursor-pointer select-none active:scale-95 font-mono font-bold"
      >
        &lt;
      </button>

      <div id="testimonial-dots" class="flex justify-center items-center gap-2">
        {Array.from({ length: reviews.length + (showEndCap ? 1 : 0) }).map((_, i) => (
          <button 
            type="button" 
            class="carousel-dot h-1.5 transition-all duration-300 bg-black/25 rounded-full cursor-pointer"
            aria-label={`Go to slide ${i + 1}`}
            data-dot-index={i}
          />
        ))}
      </div>

      <button 
        type="button" 
        id="testimonial-next" 
        aria-label="Next testimonial"
        class="w-10 h-10 bg-white text-[#1a1a1a] border border-black/15 shadow-sm hover:bg-[#1a1a1a] hover:text-white hover:border-[#1a1a1a] transition-all duration-300 flex items-center justify-center cursor-pointer select-none active:scale-95 font-mono font-bold"
      >
        &gt;
      </button>
    </div>
  ) : (
    <div class="flex items-center justify-center gap-2 sm:gap-3 mt-8 select-none flex-wrap">
      <button 
        type="button" 
        id="pagination-prev" 
        class="px-4 py-2.5 bg-white text-[#1a1a1a] border border-black/15 font-heading text-xs uppercase tracking-wider hover:bg-[#1a1a1a] hover:text-white hover:border-[#1a1a1a] transition-all duration-300 cursor-pointer shadow-sm disabled:opacity-40 disabled:cursor-not-allowed inline-flex items-center gap-1.5"
      >
        <span>&lt; Prev</span>
      </button>
      
      <div id="testimonial-pagination" class="flex justify-center items-center gap-1.5" aria-label="Carousel pagination"></div>

      <button 
        type="button" 
        id="pagination-next" 
        class="px-4 py-2.5 bg-white text-[#1a1a1a] border border-black/15 font-heading text-xs uppercase tracking-wider hover:bg-[#1a1a1a] hover:text-white hover:border-[#1a1a1a] transition-all duration-300 cursor-pointer shadow-sm disabled:opacity-40 disabled:cursor-not-allowed inline-flex items-center gap-1.5"
      >
        <span>Next &gt;</span>
      </button>
    </div>
  )}

</div>

<style>
  .testimonial-slide {
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1),
                opacity 0.4s cubic-bezier(0.25, 1, 0.5, 1),
                background-color 0.4s cubic-bezier(0.25, 1, 0.5, 1),
                box-shadow 0.4s cubic-bezier(0.25, 1, 0.5, 1),
                border-color 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    will-change: transform, opacity;
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  .card-headline { 
    font-size: clamp(15px, 2.2vh, 23px); 
    line-height: 1.35; 
  }
  
  .card-quote { 
    font-size: clamp(12.5px, 1.8vh, 18px); 
    line-height: clamp(1.4, 2.4vh, 1.85); 
  }

  .testimonial-slide:not(.testimonial-endcap) {
    background-color: #FFFFFF;
    border-color: rgba(0, 0, 0, 0.12);
  }
  .testimonial-slide:not(.testimonial-endcap) .card-inner-frame {
    opacity: 0;
    border: 1px solid transparent;
  }
  .testimonial-slide:not(.testimonial-endcap) .card-header,
  .testimonial-slide:not(.testimonial-endcap) .card-footer {
    border-color: rgba(0, 0, 0, 0.08);
  }
  .testimonial-slide:not(.testimonial-endcap) .card-tag { color: #8C7149; }
  .testimonial-slide:not(.testimonial-endcap) .card-stars { color: #8C7149; }
  .testimonial-slide:not(.testimonial-endcap) .card-headline { color: #1a1a1a; }
  .testimonial-slide:not(.testimonial-endcap) .card-quote { color: #4a4a4a; }
  .testimonial-slide:not(.testimonial-endcap) .card-client { color: #1a1a1a; }
  .testimonial-slide:not(.testimonial-endcap) .card-verified { color: #8C7149; }
  .testimonial-slide:not(.testimonial-endcap) .card-quote-icon { color: #d3bc97; opacity: 0.6; }

  .testimonial-slide.testimonial-endcap {
    background: linear-gradient(145deg, #181716 0%, #100f0e 100%);
    border-color: rgba(211, 188, 151, 0.35);
    color: white;
  }
  .testimonial-slide.testimonial-endcap h3 { color: #FFFFFF; }
  .testimonial-slide.testimonial-endcap p { color: #E2DFD9; }
  .testimonial-slide.testimonial-endcap span { color: #d3bc97; }
  .testimonial-slide.testimonial-endcap .border-t { border-color: rgba(255, 255, 255, 0.15); }

  .card-body-scroll { overflow-y: hidden; }
  .scroll-prompt { display: none; }

  .card-body-scroll.has-overflow {
    overflow-y: scroll !important;
    scrollbar-width: thin;
    scrollbar-color: #8C7149 rgba(0, 0, 0, 0.08);
  }
  .card-body-scroll.has-overflow::-webkit-scrollbar { width: 6px; display: block !important; }
  .card-body-scroll.has-overflow::-webkit-scrollbar-track { background: rgba(0, 0, 0, 0.08); border-radius: 3px; }
  .card-body-scroll.has-overflow::-webkit-scrollbar-thumb { background: #8C7149; border-radius: 3px; }
  .card-body-wrapper.has-overflow .scroll-prompt { display: block; color: #8C7149; }

  .testimonial-slide:not(.testimonial-endcap).is-active {
    opacity: 1;
    transform: translateX(0) scale(1) translateZ(0);
    z-index: 20;
    pointer-events: auto;
    background: linear-gradient(145deg, #181716 0%, #100f0e 100%);
    border-color: rgba(211, 188, 151, 0.35);
    box-shadow: 0 25px 60px -12px rgba(0, 0, 0, 0.45), 0 0 35px -5px rgba(211, 188, 151, 0.12);
  }
  .testimonial-slide:not(.testimonial-endcap).is-active .card-body-scroll.has-overflow { scrollbar-color: #d3bc97 rgba(255, 255, 255, 0.15); }
  .testimonial-slide:not(.testimonial-endcap).is-active .card-body-scroll.has-overflow::-webkit-scrollbar-track { background: rgba(255, 255, 255, 0.1); }
  .testimonial-slide:not(.testimonial-endcap).is-active .card-body-scroll.has-overflow::-webkit-scrollbar-thumb { background: #d3bc97; }
  .testimonial-slide:not(.testimonial-endcap).is-active .card-body-wrapper.has-overflow .scroll-prompt { color: #d3bc97; }
  .testimonial-slide:not(.testimonial-endcap).is-active .card-inner-frame { opacity: 1; border: 1px solid rgba(211, 188, 151, 0.18); }
  .testimonial-slide:not(.testimonial-endcap).is-active .card-header,
  .testimonial-slide:not(.testimonial-endcap).is-active .card-footer { border-color: rgba(255, 255, 255, 0.12); }
  .testimonial-slide:not(.testimonial-endcap).is-active .card-tag,
  .testimonial-slide:not(.testimonial-endcap).is-active .card-stars,
  .testimonial-slide:not(.testimonial-endcap).is-active .card-verified { color: #d3bc97; }
  .testimonial-slide:not(.testimonial-endcap).is-active .card-headline,
  .testimonial-slide:not(.testimonial-endcap).is-active .card-client { color: #FFFFFF; }
  .testimonial-slide:not(.testimonial-endcap).is-active .card-quote { color: #E2DFD9; }
  .testimonial-slide:not(.testimonial-endcap).is-active .card-quote-icon { color: #d3bc97; opacity: 0.9; }

  .testimonial-slide.testimonial-endcap.is-active {
    opacity: 1;
    transform: translateX(0) scale(1) translateZ(0);
    z-index: 20;
    pointer-events: auto;
    background: #FFFFFF;
    border-color: rgba(0, 0, 0, 0.15);
    box-shadow: 0 25px 60px -12px rgba(0, 0, 0, 0.15), 0 0 35px -5px rgba(140, 113, 73, 0.1);
  }
  .testimonial-slide.testimonial-endcap.is-active h3 { color: #1a1a1a; }
  .testimonial-slide.testimonial-endcap.is-active p { color: #4a4a4a; }
  .testimonial-slide.testimonial-endcap.is-active span { color: #8C7149; }
  .testimonial-slide.testimonial-endcap.is-active .border-t { border-color: rgba(0, 0, 0, 0.08); }

  .testimonial-slide.is-prev {
    opacity: 0.45;
    transform: translateX(-40%) scale(0.92) translateZ(0);
    z-index: 10;
    pointer-events: auto;
    cursor: pointer;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
  }
  .testimonial-slide.is-next {
    opacity: 0.45;
    transform: translateX(40%) scale(0.92) translateZ(0);
    z-index: 10;
    pointer-events: auto;
    cursor: pointer;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
  }
  .testimonial-slide.is-hidden {
    opacity: 0;
    transform: translateX(0) scale(0.75) translateZ(0);
    z-index: 0;
    pointer-events: none;
  }

  @media (max-width: 767px) {
    .testimonial-slide.is-prev,
    .testimonial-slide.is-next {
      opacity: 0;
      transform: translateX(0) scale(0.95) translateZ(0);
      pointer-events: none;
    }
  }

  .carousel-dot.active {
    width: 2rem;
    background-color: #8C7149;
  }
  .carousel-dot:not(.active) {
    width: 0.5rem;
  }
</style>

<script>
  function setupTestimonialsCarousel() {
    const wrappers = document.querySelectorAll('.testimonials-carousel-wrapper');
    
    wrappers.forEach((wrapper) => {
      if (wrapper.dataset.initialized === 'true') return;
      wrapper.dataset.initialized = 'true';

      const stage = wrapper.querySelector('#testimonial-stage');
      const slides = Array.from(wrapper.querySelectorAll<HTMLElement>('.testimonial-slide'));
      const prevBtn = wrapper.querySelector('#testimonial-prev');
      const nextBtn = wrapper.querySelector('#testimonial-next');
      const paginationPrevBtn = wrapper.querySelector('#pagination-prev') as HTMLButtonElement | null;
      const paginationNextBtn = wrapper.querySelector('#pagination-next') as HTMLButtonElement | null;
      const paginationContainer = wrapper.querySelector('#testimonial-pagination') as HTMLElement | null;
      const dots = Array.from(wrapper.querySelectorAll<HTMLElement>('.carousel-dot'));
      const variant = wrapper.getAttribute('data-variant');

      if (slides.length === 0) return;

      let currentIndex = 0;
      const total = slides.length;

      function checkOverflowStates() {
        slides.forEach((slide) => {
          const scrollContainer = slide.querySelector('.card-body-scroll');
          const wrapperEl = slide.querySelector('.card-body-wrapper');
          if (scrollContainer && wrapperEl) {
            scrollContainer.classList.add('has-overflow');
            wrapperEl.classList.add('has-overflow');
            
            const hasOverflow = scrollContainer.scrollHeight > scrollContainer.clientHeight;
            if (!hasOverflow) {
              scrollContainer.classList.remove('has-overflow');
              wrapperEl.classList.remove('has-overflow');
            }
          }
        });
      }

      function renderPagination() {
        if (variant !== 'numbers' || !paginationContainer) return;
        paginationContainer.innerHTML = '';
        const pagesToShow: (number | string)[] = [];
        if (total <= 5) {
          for (let i = 0; i < total; i++) pagesToShow.push(i);
        } else {
          pagesToShow.push(0);
          const start = Math.max(1, currentIndex - 1);
          const end = Math.min(total - 2, currentIndex + 1);
          if (start > 1) pagesToShow.push('...');
          for (let i = start; i <= end; i++) pagesToShow.push(i);
          if (end < total - 2) pagesToShow.push('...');
          pagesToShow.push(total - 1);
        }
        pagesToShow.forEach((item) => {
          if (typeof item === 'string') {
            const ellipsis = document.createElement('span');
            ellipsis.className = 'w-6 text-center text-xs text-neutral-400 font-heading select-none';
            ellipsis.textContent = '...';
            paginationContainer.appendChild(ellipsis);
          } else {
            const btn = document.createElement('button');
            btn.type = 'button';
            const isCurrent = item === currentIndex;
            btn.className = `w-9 h-9 sm:w-10 sm:h-10 border flex items-center justify-center font-heading text-xs tracking-wider transition-all duration-300 cursor-pointer shadow-sm ${
              isCurrent ? 'bg-[#1a1a1a] text-white border-[#1a1a1a]' : 'bg-white text-[#1a1a1a] border-black/15 hover:bg-[#1a1a1a] hover:text-white hover:border-[#1a1a1a]'
            }`;
            btn.textContent = String(item + 1).padStart(2, '0');
            btn.setAttribute('aria-label', `Go to testimonial ${item + 1}`);
            btn.addEventListener('click', () => { currentIndex = item; updateCarousel(); });
            paginationContainer.appendChild(btn);
          }
        });
      }

      function updateCarousel() {
        const isMobile = window.innerWidth < 768;

        slides.forEach((slide, i) => {
          slide.classList.remove('is-active', 'is-prev', 'is-next', 'is-hidden');
          
          const prevIndex = (currentIndex - 1 + total) % total;
          const nextIndex = (currentIndex + 1) % total;

          if (i === currentIndex) {
            slide.classList.add('is-active');
            slide.setAttribute('aria-hidden', 'false');
          } else if (!isMobile && i === prevIndex) {
            slide.classList.add('is-prev');
            slide.setAttribute('aria-hidden', 'true');
          } else if (!isMobile && i === nextIndex) {
            slide.classList.add('is-next');
            slide.setAttribute('aria-hidden', 'true');
          } else {
            slide.classList.add('is-hidden');
            slide.setAttribute('aria-hidden', 'true');
          }
        });

        if (variant === 'dots') {
          dots.forEach((dot, idx) => {
            dot.classList.toggle('active', idx === currentIndex);
          });
        }

        checkOverflowStates();
        renderPagination();
      }

      function goNext() { currentIndex = (currentIndex + 1) % total; updateCarousel(); }
      function goPrev() { currentIndex = (currentIndex - 1 + total) % total; updateCarousel(); }

      prevBtn?.addEventListener('click', goPrev);
      nextBtn?.addEventListener('click', goNext);
      paginationPrevBtn?.addEventListener('click', goPrev);
      paginationNextBtn?.addEventListener('click', goNext);

      slides.forEach((slide) => {
        slide.addEventListener('click', () => {
          if (slide.classList.contains('is-prev')) goPrev();
          if (slide.classList.contains('is-next')) goNext();
        });
      });

      dots.forEach((dot, index) => {
        dot.addEventListener('click', () => {
          currentIndex = index;
          updateCarousel();
        });
      });

      stage?.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'ArrowLeft') goPrev();
        if (e.key === 'ArrowRight') goNext();
      });

      let touchStartX = 0;
      stage?.addEventListener('touchstart', (e: TouchEvent) => {
        touchStartX = e.touches[0].clientX;
      }, { passive: true });

      stage?.addEventListener('touchend', (e: TouchEvent) => {
        const touchEndX = e.changedTouches[0].clientX;
        const diff = touchStartX - touchEndX;
        if (Math.abs(diff) > 40) {
          if (diff > 0) goNext();
          else goPrev();
        }
      });

      let resizeTimer: number;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
          checkOverflowStates();
          updateCarousel();
        }, 150);
      });

      checkOverflowStates();
      updateCarousel();
    });
  }

  document.addEventListener('astro:page-load', setupTestimonialsCarousel);
</script>