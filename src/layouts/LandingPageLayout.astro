---
// ============================================================================
// COMPONENT: LandingPageLayout.astro
// USAGE: Dedicated layout for standalone PPC / campaign landing pages.
// LAYOUT: ZERO navigation menu, ZERO footer. Pure conversion focus.
// ============================================================================

import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import ContactModal from '../components/ContactModal.astro';

interface Props {
  title?: string;
  description?: string;
  dreNumber?: string;
}

const {
  title = "Alex Yap Real Estate Advisor | South Bay Residential & Listing Specialist",
  description = "Alex Yap delivers discreet advisory and bespoke representation for luxury coastal and architectural estates throughout the South Bay, Silicon Valley, and Peninsula enclaves.",
  dreNumber = "DRE #01452375"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <!-- SEO Meta Tags -->
  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- Open Graph / Social Sharing Meta Tags -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1200&q=80" />
  <meta property="og:url" content="https://alexyaphomes.com" />
  <meta name="twitter:card" content="summary_large_image" />

  <!-- Favicons -->
  <link rel="icon" type="image/x-icon" href="/icons/favicon.ico">
  <link rel="icon" type="image/png" href="/icons/favicon.png">

  <!-- Performance: Preconnects & Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://res.cloudinary.com">
  <link rel="preconnect" href="https://images.unsplash.com">

  <link 
    rel="stylesheet" 
    href="https://fonts.googleapis.com/css2?family=Libre+Franklin:ital,wght@0,100..600;1,100..600&family=Tenor+Sans&display=block"
  />

  <ClientRouter />

  <style is:global>
    :root {
      --color-luxury-stone: #ECE8E1;
      --color-luxury-chalk: #F4F2EE;
      --font-body: 'Libre Franklin', system-ui, -apple-system, sans-serif;
      --font-heading: 'Tenor Sans', Didot, 'Bodoni MT', Georgia, serif;

      --bg-color-1: #efebda; /* original color #EBE8E0 */
      
      --bg-grid: url("data:image/svg+xml,%3Csvg width='64' height='64' viewBox='0 0 64 64' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M64 32H0M32 64V0' fill='none' stroke='%238C7149' stroke-width='1' stroke-opacity='0.18'/%3E%3Ccircle cx='32' cy='32' r='6' fill='%23EBE8E0' stroke='%238C7149' stroke-width='1' stroke-opacity='0.18'/%3E%3C/svg%3E");
    }

    html, body {
      background-color: var(--bg-color-1) !important;
      color: #2b2b2b !important;
    }

    body {
      font-family: var(--font-body);
      text-rendering: optimizeLegibility;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    .font-heading {
      font-family: var(--font-heading);
    }

    .bg-color-1 {
      background-color: var(--bg-color-1) !important;
    }

    .bg-architectural-grid {
      background-image: var(--bg-grid);
      background-size: 4rem 4rem;
      background-position: 0 0;
    }
  </style>
</head>

<body class="text-[#2b2b2b] antialiased text-[16px] font-light leading-relaxed selection:bg-[#cbb592] selection:text-black overflow-x-hidden">
  
  <slot />

  <ContactModal />

</body>
</html>